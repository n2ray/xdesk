+/* Chrome supplies the complete packet as VASliceDataBuffer. Select the
+ * OBU_FRAME containing this VA picture's tiles. A single packet can back
+ * several VA pictures. Copy only the matching frame and the sequence header
+ * for key frames; never copy another picture's tiles. */
+static size_t
+tva_av1_copy_frame(const struct tva_codec *c,
+                   const struct pipe_av1_picture_desc *av1, bool key,
+                   uint8_t **out)
+{
+    size_t seq = 0, seq_len = 0;
+    const unsigned tiles = av1->slice_parameter.slice_count;
+    for (size_t pos = 0; pos < c->acc_len;) {
+        size_t start = pos;
+        unsigned header = c->acc[pos++];
+        unsigned type = (header >> 3) & 15;
+        if ((header & 0x83) != 2)
+            return 0;
+        if (header & 4) {
+            if (pos == c->acc_len || c->acc[pos++] != 0)
+                return 0;
+        }
+        uint64_t size = 0;
+        for (unsigned shift = 0; ; shift += 7) {
+            if (pos == c->acc_len || shift >= 56)
+                return 0;
+            unsigned b = c->acc[pos++];
+            size |= (uint64_t)(b & 127) << shift;
+            if (!(b & 128))
+                break;
+        }
+        if (size > c->acc_len - pos)
+            return 0;
+        size_t end = pos + size;
+        if (type == 1) {
+            seq = start;
+            seq_len = end - start;
+        }
+        if (type == 6 && tiles && av1->slice_parameter.slice_data_offset[0] >= pos &&
+            av1->slice_parameter.slice_data_offset[0] < end) {
+            for (unsigned i = 0; i < tiles; ++i) {
+                size_t off = av1->slice_parameter.slice_data_offset[i];
+                if (off < pos || off >= end ||
+                    av1->slice_parameter.slice_data_size[i] > end - off)
+                    return 0;
+            }
+            if (!key)
+                seq_len = 0;
+            if (key && !seq_len && !c->av1_sequence_sent)
+                return 0;
+            size_t frame_len = end - start;
+            if (seq_len + frame_len + 2 > MAX_FRAME)
+                return 0;
+            *out = malloc(seq_len + frame_len);
+            if (!*out)
+                return 0;
+            memcpy(*out, c->acc + seq, seq_len);
+            memcpy(*out + seq_len, c->acc + start, frame_len);
+            return seq_len + frame_len;
+        }
+        pos = end;
+    }
+    return 0;
+}
