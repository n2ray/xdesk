#!/bin/sh
set -e
case "$1" in
remove|abort-install)
    dpkg-divert --package xdesk-core --rename --remove /usr/bin/google-chrome-stable >/dev/null || true
    # Ubuntu's Mesa free again (lfdevs' files stay until it is reinstalled: apt install --reinstall mesa-vulkan-drivers ...)
    rm -f /etc/apt/preferences.d/xdesk-mesa /var/lib/xdesk/gpu
    ;;
esac
