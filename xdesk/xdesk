#!/data/data/com.termux/files/usr/bin/bash
# xdesk: run desktops and programs on the XDesk display, from Termux, proot or chroot.
# XDesk only provides the display, touchpad and audio. What runs on it is one command per "session".
#
#   xdesk x                  start only the X server and audio
#   xdesk run CMD...         run any program on the display
#   xdesk list               list sessions (found by "xdesk setup" or added by you)
#   xdesk add NAME ['CMD'] [--root DIR] [--launch 'PREFIX']   add a session, or without CMD an environment (writes NAME.root / NAME.launch)
#   xdesk rm NAME            remove a session or an environment
#   xdesk use NAME           choose the default session
#   xdesk start [NAME]       start a session (default: the chosen one)
#   xdesk switch NAME        stop the running session and start another, keeping X and the window
#   xdesk stop               stop everything
#   xdesk recover [NAME]     like start, unless you ran xdesk stop (the app does not use this)
#   xdesk status             show what is running
#   xdesk setup              look for desktops and environments in Termux and proot-distro
#   xdesk doctor             check the setup, one line per item (exit 1 when something is broken)
#   xdesk version            print the xdesk command version
#   xdesk update [beta|stable|VERSION]   update this command: its own line (a beta stays on betas), switch lines, or one version
#   xdesk enable-app-start   let the app's "start" button run commands in Termux
#   xdesk apps [--refresh|--path]   list the programs XDesk can open one by one (from .desktop files); --path prints the catalog file
#   xdesk launch [--startup-id ID] SCOPE/ID   open one of them on the display, in its session (Termux, proot or chroot)
#   xdesk scale DPI          set this X server's DPI and cursor size in memory (the app runs it; no XFCE settings)
#   xdesk envs               list the environments (Termux, each proot or chroot) with their sessions, for the app
#   xdesk app state          one JSON line with everything the app reads (sessions, X, environments)
#   xdesk app catalog        the program list without icons, for the app before any X server runs
#   xdesk keyboard layout [NAME|auto]  the keyboard layout of XDesk's keyboard, set on XDesk's own X ("ime layout" too)
#   xdesk ime [status]       whether an input method runs on XDesk's display (read-only: an X input method is yours)
#   xdesk help [all]         the commands above; "all" adds the ones only the app uses
#   NAME+apps                as a session name (start, switch, use): only X and xfwm4 (Termux's own also xfsettingsd),
#                            no panel or desktop ("termux+apps" needs no session: Termux's own xfwm4)
set -u
# CI stamps the release version into this line; a copy from the repository stays dev, which the app does not prompt about
XDESK_CLI_VERSION=dev
APP=io.github.n2ray.xdesk.x11
# XDesk's own X server. :9 keeps it away from the official Termux:X11 and a startx.sh, which both use :1; one display
# number for every XDesk and its sessions. XDESK_DISPLAY overrides it (a second XDesk, a test), as :N only.
DPY=${XDESK_DISPLAY:-:9}
case "$DPY" in
:*) [[ ${DPY#:} =~ ^[0-9]+$ ]] || { echo "XDESK_DISPLAY must be a display number like :9, not '$DPY'" >&2; exit 1; } ;;
*) echo "XDESK_DISPLAY must be a display number like :9, not '$DPY'" >&2; exit 1 ;;
esac
AUDIO_PORT=47130   # only for removing what an older xdesk loaded
# Private to Termux, unlike a port on 127.0.0.1, which every app on the phone can reach
AUDIO_SOCK=$PREFIX/tmp/xdesk-audio
# The PulseAudio cookie where proot (/tmp, with --shared-tmp) and chroot clients can read it. Inside Termux's own
# directory, so readable for a chroot's user does not mean for other apps
PULSE_COOKIE_FILE=$PREFIX/tmp/xdesk-pulse-cookie
DEFAULT_RES='1280 x 1024'    # what X reports before the app has connected
CONF=$HOME/.config/xdesk
SESSIONS=$CONF/sessions
# Environments with no session of their own (a container without a desktop): NAME.root, NAME.launch
ENVS=$CONF/envs
RUN=$PREFIX/tmp/xdesk
LOG=$PREFIX/tmp/xdesk.log
LOADER=$HOME/.local/libexec/xdesk/loader.apk
INSTALL_URL=https://raw.githubusercontent.com/n2ray/xdesk/xdesk/xdesk/install.sh
LOG_MAX=2097152              # xdesk.log is rotated to xdesk.log.1 beyond this many bytes
# Scripts with #!/bin/... only run through termux-exec, and RUN_COMMAND starts us without it
TERMUX_EXEC=$PREFIX/lib/libtermux-exec-ld-preload.so
if [ -z "${LD_PRELOAD:-}" ] && [ -f "$TERMUX_EXEC" ]; then export LD_PRELOAD=$TERMUX_EXEC; fi
# No renice here: only the X server gets the CPU priority it needs (start_x, after it is started). A session or a
# program runs at the default nice, like everything else the user starts.
mkdir -p "$SESSIONS" "$ENVS" "$RUN"
# XDesk passes a nonce when it runs us; xdesk stop sends it back, so the app can tell its STOPPED
# broadcast from one any other app could send. Other apps cannot read $RUN.
if [ -n "${XDESK_NONCE:-}" ]; then printf '%s\n' "$XDESK_NONCE" >"$RUN/nonce"; unset XDESK_NONCE; fi

# The X server and the sessions keep the log open for appending, so it is copied and truncated in
# place: renaming it would leave them writing to the old file.
if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt "$LOG_MAX" ]; then
    cp -f "$LOG" "$LOG.1" 2>/dev/null && : >"$LOG"
fi

log() { echo "$(date +%T) $*" >>"$LOG"; }
say() { echo "$*"; log "$*"; }
x_up() { DISPLAY=$DPY timeout 2 xrandr >/dev/null 2>&1; }
# The X server xdesk started for this display. Every X server xdesk starts names itself after it ("xdesk-x11 :9");
# one for another display is not ours here (xdesk stop and the move from :1 find those by the name alone).
x_pid() {
    local p
    for p in $(pgrep -f '^xdesk-x11 ' 2>/dev/null); do
        tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -qE "xdesk-x11 $DPY( |\$)" && { echo "$p"; return 0; }
    done
    # A stub or a /proc that cannot be read: any server by that name is still xdesk's
    pgrep -f '^xdesk-x11 ' 2>/dev/null | head -1
}

# The X answering on DPY is the server xdesk started, not one another program runs there (the user's own startx.sh or
# official Termux:X11 on the same number). Anything that writes to an X server -- setxkbmap, xrandr --dpi, xrdb --
# checks this first. The display's lock file names the server that made it, so a foreign X never passes.
x_is_ours() {
    local p l
    p=$(x_pid) || return 1
    [ -n "$p" ] && x_up || return 1
    l=$(tr -d ' ' <"$PREFIX/tmp/.X${DPY#:}-lock" 2>/dev/null) || return 1
    [ "$l" = "$p" ]
}

# A process's start, in clock ticks since boot: field 22 of /proc/PID/stat (pid and comm, which may hold spaces, are
# skipped first). Exact, and readable for Termux's own processes
proc_ticks() {  # pid
    local t
    [ -n "${1:-}" ] || return 1
    t=$(sed 's/^[0-9]* (.*) //' "/proc/$1/stat" 2>/dev/null | awk '{ print $20 }')
    [[ $t =~ ^[0-9]+$ ]] && echo "$t"
}

# When a process started, in Unix seconds. Android keeps /proc/stat (btime) and /proc/uptime from apps, so the boot
# time comes from this shell itself where it must: now minus its own start, which is a moment ago. Ticks are 100 a
# second on Android (USER_HZ); getconf is not in Termux
x_started() {  # pid
    local p=${1:-} btime ticks hz=100 me
    [ -n "$p" ] || return 1
    ticks=$(proc_ticks "$p") || return 1
    command -v getconf >/dev/null 2>&1 && hz=$(getconf CLK_TCK 2>/dev/null) && [[ $hz =~ ^[0-9]+$ ]] || hz=100
    btime=$(awk '/^btime / { print $2; exit }' /proc/stat 2>/dev/null)
    if [ -z "$btime" ]; then
        me=$(proc_ticks "$BASHPID") || return 1
        btime=$(( $(date +%s) - me / hz ))
    fi
    echo $(( btime + ticks / hz ))
}

# A pid from one of our pid files is ours only when its start (in ticks) is the one written when we started it: after
# a restart the same number can belong to another program, which must not be killed
pid_ours() {  # pid, start-time file
    local p=${1:-} t s w
    [[ $p =~ ^[0-9]+$ ]] || return 1
    t=$(proc_ticks "$p") || return 1
    [ -f "$2" ] && { [ "$t" = "$(cat "$2" 2>/dev/null)" ]; return; }
    # A pid file from an older xdesk has no start beside it: the process it names started when that file was written,
    # a later owner of the same pid only after. Otherwise a desktop running across an update could not be stopped
    s=$(x_started "$p") || return 1
    w=$(stat -c %Y "${2%.started}.pid" 2>/dev/null) || return 1
    [ $(( s - w )) -le 10 ] && [ $(( w - s )) -le 10 ]
}

# Whatever holds the X lock file of our display is still alive (another X server, or ours under
# a name pgrep does not know).
x_lock_alive() {
    local p c f=$PREFIX/tmp/.X${DPY#:}-lock
    [ -f "$f" ] || return 1
    p=$(tr -d ' ' <"$f" 2>/dev/null)
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null || return 1
    # A lock left behind whose pid now belongs to something else: only an X server counts (unreadable: assume it is one)
    c=$(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null)
    case "$c" in ""|*termux-x11*|*xdesk-x11*|*com.termux.x11*|*Xorg*|*Xvfb*|*Xwayland*) return 0 ;; esac
    return 1
}

# The X server's pid: ours by name, else whatever holds the display's lock (another X server)
x_server_pid() {
    local p f=$PREFIX/tmp/.X${DPY#:}-lock
    p=$(x_pid)
    if [ -z "$p" ] && [ -f "$f" ] && x_lock_alive; then p=$(tr -d ' ' <"$f" 2>/dev/null); fi
    [ -n "$p" ] && echo "$p"
}

# The Termux packages of the commands that are not there, space separated (empty when all are)
missing_tools() {
    local pair missing=""
    for pair in xrandr:xorg-xrandr flock:util-linux setsid:util-linux timeout:coreutils \
                seq:coreutils pgrep:procps pkill:procps ps:procps; do
        command -v "${pair%%:*}" >/dev/null 2>&1 || missing="$missing ${pair##*:}"
    done
    [ -z "$missing" ] && return 0
    # shellcheck disable=SC2086
    printf '%s\n' $missing | sort -u | tr '\n' ' '
}

# Commands the X and session commands need, with the Termux package that has them
need_tools() {
    local missing
    missing=$(missing_tools)
    [ -z "$missing" ] && return 0
    say "Missing commands. Install them with: pkg install ${missing% }"
    exit 1
}

# New session names become file names and are read by the app: plain letters, digits, dot, dash and underscore
valid_new_name() {
    [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && return 0
    echo "Invalid session name: '$1'"
    return 1
}

# Commands that use a name that is already on disk (rm, use, start, switch) keep accepting what older xdesk wrote,
# but never a name that leaves the sessions directory or breaks the file list
valid_name() {
    case "${1:-}" in
    ''|*/*|.*|-*|*..*|*$'\t'*|*$'\n'*) echo "Invalid session name: '$1'"; return 1 ;;
    esac
}

ensure_loader() {
    [ -f "$LOADER" ] && return 0
    say "Loader not found: $LOADER. Install XDesk again: curl -fsSL $INSTALL_URL | bash"
    return 1
}

# Extra environment for the X server only, from $CONF/x11-env into the array xenv: one NAME=value
# per line; "export " and one pair of quotes around the value are allowed, # starts a comment.
read_x11_env() {
    local line name value
    xenv=()
    [ -f "$CONF/x11-env" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}
        line=${line#"${line%%[![:space:]]*}"}
        case "$line" in ''|'#'*) continue ;; esac
        line=${line#export }
        if ! [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
            log "x11-env: ignored line: $line"
            continue
        fi
        name=${line%%=*}
        value=${line#*=}
        case "$value" in
        \"*\"|\'*\') [ ${#value} -ge 2 ] && value=${value:1:${#value}-2} ;;
        esac
        xenv+=("$name=$value")
    done <"$CONF/x11-env"
    [ ${#xenv[@]} -gt 0 ] && log "X server environment from $CONF/x11-env: ${xenv[*]}"
    return 0
}

# Keep the lock for setup only: background processes must not inherit fd 9 or it is never released
lock() {
    exec 9>"$RUN/session.lock"
    flock -w 60 9 || { say "Another xdesk command is still running. Try again, or run: xdesk stop"; exit 1; }
}

# The apps bus starts and stops on its own (a background job after a session or a launch), so it needs its own lock:
# the main one is not held there. fd 8, never 9, and nested calls in one shell reuse it
bus_lock_depth=0
bus_lock() {
    [ "$bus_lock_depth" -gt 0 ] && { bus_lock_depth=$((bus_lock_depth + 1)); return 0; }
    # Without flock (the bus may be asked for before the first start checked the tools): start it anyway
    command -v flock >/dev/null 2>&1 || { bus_lock_depth=1; return 0; }
    exec 8>"$RUN/bus.lock"
    flock -w 10 8 || return 1
    bus_lock_depth=1
}
bus_unlock() {
    [ "$bus_lock_depth" -gt 1 ] && { bus_lock_depth=$((bus_lock_depth - 1)); return 0; }
    if [ "$bus_lock_depth" -eq 1 ]; then exec 8>&-; fi
    bus_lock_depth=0
}

# The remembered keyboard layout (INPUT.md §5.2), set on XDesk's own X server so raw keys type right. The layout is a
# property of the keyboard XDesk gives the user: no X input method is started, stopped or configured here.
x_layout() {
    local s v=""
    s=$(layout_setting) || return 0
    [ -n "$s" ] || return 0
    command -v setxkbmap >/dev/null 2>&1 || return 0
    x_is_ours || return 0
    v=${s#*-}; [ "$v" = "$s" ] && v=""
    DISPLAY=$DPY timeout 3 setxkbmap -layout "${s%%-*}" ${v:+-variant "$v"} 2>/dev/null || return 0
    log "X keyboard layout: $s"
}

# CURSOR.md §2.4, §2.5: XDesk's own cursor is a black arrow with a white edge, 24 dp·b·u. X gets the size for it,
# 24·DPI/96 X pixels -- the X DPI is 96·b·u·R/N (DISPLAY.md §4.1), so 24 dp·b·u is 24·DPI/96 X pixels, which the
# screen's R/N rendering turns back into 24 dp·b·u. The theme is the user's own and stays untouched (owner,
# 2026-11-19): only the size is delivered, as Xcursor.size in xdesk's own X resource database. There is no
# XCURSOR_SIZE in the environment: an environment variable beats everything the user sets in XFCE, and the database
# is read the same way anyway. ~/.Xresources, xfconf and XCURSOR_THEME are left alone.

# The cursor size in X pixels: 24 at 96 DPI, scaled by DPI/96. With no dpi given, the one the app last asked for
cursor_size() {  # dpi, or nothing
    local d=${1:-$(cut -d' ' -f1 "$RUN/scale" 2>/dev/null)}
    [[ $d =~ ^[0-9]{2,4}$ ]] || d=96
    awk -v d="$d" 'BEGIN { printf "%d", int(24 * d / 96 + 0.5) }'
}

# The cursor size resource for xdesk's own X server only (owner, 2026-11-15): written to $RUN, never to $HOME/.Xresources,
# so a desktop started some other way (startx.sh, official Termux:X11) keeps its own cursor. Gone with X.
cursor_resources() {  # dpi, or nothing
    local f=$RUN/cursor.Xresources
    printf 'Xcursor.size: %s\n' "$(cursor_size "${1:-}")" >"$f" || return 1
    echo "$f"
}

# The resources into this X server's database (on the root window): new programs read them from there, ones
# already running keep what they loaded
cursor_apply() {  # dpi, or nothing
    local f
    f=$(cursor_resources "${1:-}") || return 0
    command -v xrdb >/dev/null 2>&1 || { log "Cursor size: xorg-xrdb is not installed, programs keep X's own cursor size"; return 0; }
    x_is_ours || return 0
    DISPLAY=$DPY timeout 3 xrdb -merge "$f" 2>/dev/null || log "Cursor size: xrdb could not merge $f"
}

# A value the user set in XFCE's settings channel (xfconf): 1 when the key is there. Read from the file xfsettingsd
# writes, never through xfconf-query: XDesk does not talk to a running desktop's xfconf, and needs no answer from it.
# The property names are the ones in ~/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml.
# The file nests a key in its group (<property name="Xft"> holds <property name="DPI">), so "Xft/DPI" is found as
# DPI inside Xft.
xfce_xsetting_set() {  # group/key
    awk -v g="name=\"${1%%/*}\"" -v k="name=\"${1#*/}\"" '
        index($0, "<property") && index($0, g) && !index($0, "/>") { inside = 1; next }
        inside && index($0, "<property") && index($0, k) { found = 1; exit }
        inside && index($0, "</property>") { inside = 0 }
        END { exit !found }' \
        "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml" 2>/dev/null
}

# The DPI in xdesk's own X server, in memory only (owner, 2026-11-19): xrandr --dpi gives X the monitor's DPI, and
# xrdb merges Xft.dpi and Xcursor.size into this X server's resource database, which dies with it. Nothing goes into
# xfconf or ~/.Xresources, so the user's desktop configuration and a crash leave nothing behind.
# "initial" (X just started, before any session) writes both as the default. Later -- a DPI the app asked for after
# the session runs -- a value is written only when the user has none of their own: xfsettingsd copies the user's
# /Xft/DPI to the same X resources, and whoever writes last wins; re-merging would replace the user's value there
# while XSETTINGS keeps theirs, and programs would disagree. Panel and icon sizes are never touched.
scale_resources() {  # dpi, 1 for the initial default
    local f=$RUN/scale.Xresources initial=${2:-0} res=""
    if ! x_is_ours; then
        log "scale $1: the X on $DPY is not xdesk's, nothing changed"
        return 0
    fi
    if command -v xrandr >/dev/null 2>&1; then
        DISPLAY=$DPY timeout 3 xrandr --dpi "$1" >/dev/null 2>&1 || log "scale $1: xrandr --dpi did not take"
    else
        log "scale $1: xrandr is not installed, X keeps its DPI (pkg install xorg-xrandr)"
    fi
    if [ "$initial" = 1 ] || ! xfce_xsetting_set Xft/DPI; then res="Xft.dpi: $1"$'\n'; fi
    if [ "$initial" = 1 ] || ! xfce_xsetting_set Gtk/CursorThemeSize; then res+="Xcursor.size: $(cursor_size "$1")"$'\n'; fi
    [ -n "$res" ] || return 0
    printf '%s' "$res" >"$f" || return 1
    command -v xrdb >/dev/null 2>&1 || { log "scale $1: xorg-xrdb is not installed, programs keep X's own resources"; return 0; }
    DISPLAY=$DPY timeout 3 xrdb -merge "$f" 2>/dev/null || log "scale $1: xrdb could not merge $f"
}

# What X gets as soon as it is up, and only then: the keyboard layout, the last DPI the app asked for, the cursor size.
# This is the initial default, before any session runs; a later DPI change respects the user's own XFCE values.
x_ready() {
    local d
    x_layout
    d=$(cut -d' ' -f1 "$RUN/scale" 2>/dev/null)
    if [[ $d =~ ^[0-9]{2,4}$ ]]; then scale_resources "$d" 1; else cursor_apply; fi
}

# Chromium's renderer runs at -8, above a default-priority X server, and video drops frames: only the X server xdesk
# started gets -10. Sessions and programs run at the default nice, like the user's other programs.
x_nice() {  # pid, or nothing for ours
    local p=${1:-$(x_pid)}
    [ -n "$p" ] || return 0
    renice -n -10 -p "$p" >/dev/null 2>&1 || :
}

# Every xdesk-x11 xdesk started, whatever display it names, stopped the way xdesk stop does it: an older xdesk's
# server runs on :1 and would keep the old display's socket and lock otherwise
stop_x_servers() {
    local p pids deadline
    pids=$(pgrep -f '^xdesk-x11 ' 2>/dev/null || :)
    [ -n "$pids" ] || return 0
    pkill -f '^xdesk-x11 ' 2>/dev/null
    deadline=$((SECONDS + 3))
    for p in $pids; do
        while [ $SECONDS -lt $deadline ] && kill -0 "$p" 2>/dev/null; do sleep 0.2; done
        if kill -0 "$p" 2>/dev/null && tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -q '^xdesk-x11 '; then
            kill -9 "$p" 2>/dev/null
        fi
    done
    clear_x_files
}

# The lock and socket of XDesk's display once its server is gone: one killed outright cannot remove them itself.
# Only DPY, and only when no X holds the lock: :1 and any other display are the user's
clear_x_files() {
    x_lock_alive && return 0
    rm -f "${PREFIX:?}/tmp/.X${DPY#:}-lock" "${PREFIX:?}/tmp/.X11-unix/X${DPY#:}"
}

# XDesk's display was :1 before 0.6.5: a server of that version is xdesk's own, and would keep a desktop on the
# display the official Termux:X11 uses. Only the name xdesk gives its own server is matched, and only :1.
stop_legacy_x() {
    local p pids=""
    [ "$DPY" != :1 ] || return 0
    for p in $(pgrep -f '^xdesk-x11 ' 2>/dev/null); do
        tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -qE 'xdesk-x11 :1( |$)' && pids="$pids $p"
    done
    [ -n "$pids" ] || return 0
    say "Stopping the X server an older xdesk started on :1..."
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null
    for p in $pids; do
        for _ in $(seq 15); do kill -0 "$p" 2>/dev/null || break; sleep 0.2; done
        kill -9 "$p" 2>/dev/null
    done
}

start_x() {
    local up=0 p deadline
    stop_legacy_x
    x_up && up=1
    p=$(x_pid)
    if [ -n "$p" ] && [ $up = 1 ] && x_is_ours; then return 0; fi
    if [ -n "$p" ] && [ $up = 1 ]; then
        say "Display $DPY is used by another X server (XDesk did not start it). Stop it first, or choose another with XDESK_DISPLAY=:N."
        return 1
    fi
    if [ -n "$p" ]; then
        # Ours but not answering (still starting, or busy): never remove its socket and start a
        # second one, wait for it instead (10 s at most, whatever each xrandr call costs).
        deadline=$((SECONDS + 10))
        while [ $SECONDS -lt $deadline ]; do
            x_up && { x_nice; x_ready; return 0; }
            sleep 0.5
        done
        say "The X server (pid $p) is running but does not answer on $DPY. Run: xdesk stop, then start again."
        return 1
    fi
    if [ $up = 1 ] || x_lock_alive; then
        say "Display $DPY is used by another X server (XDesk did not start it). Stop it first, or choose another with XDESK_DISPLAY=:N."
        return 1
    fi
    ensure_loader || return 1
    rm -f "${PREFIX:?}/tmp/.X11-unix/X${DPY#:}" "${PREFIX:?}/tmp/.X${DPY#:}-lock"
    # Same environment handling as the official termux-x11 launcher
    [ -z "${LD_LIBRARY_PATH+x}" ] || export XSTARTUP_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
    [ -z "${LD_PRELOAD+x}" ] || export XSTARTUP_LD_PRELOAD="$LD_PRELOAD"
    # Extra environment for the X server only (e.g. TERMUX_X11_* debug switches). The app starts us
    # through RUN_COMMAND, so a shell's env never gets here.
    local xenv
    read_x11_env
    # TERMUX_X11_XSTARTUP is the official launcher's startup program: a user's shell may have it set for :1, and it
    # must not start a second desktop on XDesk's X (the app's own session is what runs here)
    # XDESK_CLI: the X server runs this same script for the app (xdesk apps, xdesk launch), see XWindows.java
    env -u LD_PRELOAD -u LD_LIBRARY_PATH -u TERMUX_X11_XSTARTUP "${xenv[@]}" XDESK_AUDIO_SOCKET="$AUDIO_SOCK" XDESK_CLI="$(realpath "$0" 2>/dev/null || echo "$0")" CLASSPATH="$LOADER" setsid nohup /system/bin/app_process \
        -Xnoimage-dex2oat / --nice-name="xdesk-x11 $DPY" com.termux.x11.Loader "$DPY" -ac -nolisten tcp -nolisten local \
        </dev/null >>"$LOG" 2>&1 9>&- &
    # 20 s at most, even when each xrandr call uses its own timeout
    deadline=$((SECONDS + 20))
    while [ $SECONDS -lt $deadline ]; do
        x_up && { x_nice; x_ready; return 0; }
        sleep 0.5
    done
    say "X server did not start, see $LOG"
    return 1
}

# A chroot entered by a script of the user's own may run as root or another uid, which cannot read a file only the
# Termux user can (0600): the cookie copy is 0644 when one is configured. proot shares Termux's uid and reads it
# through --shared-tmp, and nothing else reads this copy; $PREFIX/tmp is Termux's private directory either way.
chroot_configured() {
    local f
    for f in "$SESSIONS"/*.sh "$SESSIONS"/*.launch "$ENVS"/*.launch; do
        [ -e "$f" ] || continue
        grep -qE '(^|[^[:alnum:]_-])(chroot|unshare|nsenter)([[:space:]]|$)' "$f" && return 0
    done
    return 1
}

start_audio() {
    # No client tools, no polling: ten seconds of silence would only delay the desktop
    if ! command -v pulseaudio >/dev/null 2>&1 || ! command -v pactl >/dev/null 2>&1; then
        say "No sound: pkg install pulseaudio"
        return 0
    fi
    unset PULSE_SERVER PULSE_COOKIE   # the local daemon, whatever this shell has set
    # Desktop audio goes to a null sink, the app reads it from a local port and picks the output device. A daemon
    # xdesk did not start is left running by xdesk stop, which removes only what xdesk loaded into it
    if ! timeout 3 pactl info >/dev/null 2>&1; then
        timeout 5 pulseaudio --start --exit-idle-time=-1 </dev/null 9>&- >>"$LOG" 2>&1
        : >"$RUN/pulse.ours"
    fi
    # An older xdesk remembered the user's default sink here: nothing is defaulted any more, so it is not needed
    rm -f "${RUN:?}/pulse.default"
    # Clients in proot or a chroot come in over TCP, so it needs the cookie: any app on the phone can reach 127.0.0.1.
    # The file below brings back the old way, without one, for setups that cannot pass PULSE_COOKIE
    local p="timeout 3 pactl" args="listen=127.0.0.1 auth-cookie-enabled=1 auth-anonymous=0" id deadline
    [ -e "$CONF/pulse-anonymous" ] && args="auth-ip-acl=127.0.0.1 auth-anonymous=1"
    deadline=$((SECONDS + 5))
    while [ $SECONDS -lt $deadline ]; do $p info >/dev/null 2>&1 && break; sleep 0.5; done
    # A simple-protocol-tcp on xdesk's old port was loaded by an older xdesk and is nobody else's; a native TCP
    # module below may belong to the user, so it is only ever reused, never unloaded
    $p list short modules 2>/dev/null | awk -F'\t' -v port="port=$AUDIO_PORT" \
        '$2 == "module-simple-protocol-tcp" && index($3, port) { print $1 }' |
        while read -r id; do $p unload-module "$id"; done
    # A native TCP module already on the default port (4713, where PULSE_SERVER=127.0.0.1 goes) serves containers as
    # it is, whatever its options (a startx.sh loads one with auth-ip-acl=127.0.0.1 and no listen=): reuse it, a second
    # one could not bind the port anyway. Only a module xdesk loads is recorded, and only a recorded id is ever
    # unloaded (CLI.md §5)
    if $p list short modules 2>/dev/null | awk -F'\t' \
            '$2 == "module-native-protocol-tcp" && (!index($3, "port=") || index($3, "port=4713")) { found = 1 }
             END { exit !found }'; then
        rm -f "${RUN:?}/pulse.tcp"
    else
        id=$($p load-module module-native-protocol-tcp $args 2>/dev/null)
        [[ $id =~ ^[0-9]+$ ]] && printf '%s\n' "$id" >"$RUN/pulse.tcp"
    fi
    # A copy of the user's cookie for proot (through --shared-tmp) and chroot clients, made fresh: the source may have
    # changed, and a crash must not leave a long-lived copy. Removed by xdesk stop.
    rm -f "$PULSE_COOKIE_FILE"
    ( umask 077; cp -f "$HOME/.config/pulse/cookie" "$PULSE_COOKIE_FILE" ) 2>/dev/null || :
    if [ -f "$PULSE_COOKIE_FILE" ]; then
        if chroot_configured; then chmod 644 "$PULSE_COOKIE_FILE"; else chmod 600 "$PULSE_COOKIE_FILE"; fi
    fi
    export PULSE_SERVER=127.0.0.1 PULSE_COOKIE=$PULSE_COOKIE_FILE
    deadline=$((SECONDS + 5))
    while [ $SECONDS -lt $deadline ]; do $p info >/dev/null 2>&1 && break; sleep 0.5; done
    $p info >/dev/null 2>&1 || { log "PulseAudio not reachable, no audio"; return 0; }
    $p list short sinks | grep -q '^[0-9]*[[:space:]]xdesk[[:space:]]' || \
        $p load-module module-null-sink sink_name=xdesk rate=48000 channels=2 >/dev/null
    # The app gets a connection to this from the X server (ICmdEntryInterface.getAudioConnection)
    $p list short modules | grep -q "module-simple-protocol-unix.*socket=$AUDIO_SOCK" || \
        $p load-module module-simple-protocol-unix socket="$AUDIO_SOCK" source=xdesk.monitor \
            record=true playback=false format=s16le rate=48000 channels=2 >/dev/null
    # The daemon's default sink and its other streams are the user's and are never changed: every session and program
    # xdesk starts gets PULSE_SINK=xdesk (start_session, launch, run), so only their own sound goes to the null sink.
    # A crash therefore leaves nothing changed in the daemon's configuration or on disk.
}

# pactl against this machine's daemon, not a client setting the shell happens to have
pactl_local() { env -u PULSE_SERVER -u PULSE_COOKIE timeout 3 pactl "$@"; }

# Only the daemon xdesk started is killed; one that was running before keeps running, without the modules xdesk
# loaded into it (CLI.md §5)
stop_audio() {
    local id
    # The copy of the user's cookie is xdesk's, not the user's cookie itself: never left behind
    rm -f "$PULSE_COOKIE_FILE"
    if [ -e "$RUN/pulse.ours" ]; then
        pulseaudio --kill 2>/dev/null
        rm -f "${RUN:?}/pulse.ours" "${RUN:?}/pulse.tcp" "${RUN:?}/pulse.default"
        return 0
    fi
    command -v pactl >/dev/null 2>&1 || { rm -f "${RUN:?}/pulse.tcp" "${RUN:?}/pulse.default"; return 0; }
    rm -f "${RUN:?}/pulse.default"
    # The null sink and the unix simple protocol are xdesk's own (their names and socket say so)
    pactl_local list short modules 2>/dev/null | awk -F'\t' -v sock="$AUDIO_SOCK" \
        '($2 == "module-null-sink" && index($3, "sink_name=xdesk")) ||
         ($2 == "module-simple-protocol-unix" && index($3, sock)) { print $1 }' |
        while read -r id; do pactl_local unload-module "$id"; done
    # The TCP module only when xdesk loaded it: the id was written then, and is checked to still be that module
    id=$(cat "$RUN/pulse.tcp" 2>/dev/null)
    if [[ $id =~ ^[0-9]+$ ]] &&
            pactl_local list short modules 2>/dev/null | awk -F'\t' -v id="$id" '$1 == id && $2 == "module-native-protocol-tcp" { found = 1 } END { exit !found }'; then
        pactl_local unload-module "$id"
    fi
    rm -f "${RUN:?}/pulse.tcp"
}

# The desktop keeps a wrong size for its wallpaper if it starts before the app has set the resolution
wait_for_app() {
    local deadline=$((SECONDS + 8))
    while [ $SECONDS -lt $deadline ]; do
        DISPLAY=$DPY timeout 2 xrandr 2>/dev/null | grep -q "current $DEFAULT_RES," || return 0
        sleep 0.5
    done
    say "XDesk has not connected yet. Open the app, the desktop may need a restart to fit the screen."
}

# The pid of the running session, when the process is still the one we started (not one that reused its number)
session_pid() {
    local p
    p=$(cat "$RUN/session.pid" 2>/dev/null) || return 1
    pid_ours "$p" "$RUN/session.started" || return 1
    echo "$p"
}

current() { cat "$CONF/current" 2>/dev/null; }

# Sessions written before PulseAudio needed a cookie and a sink: a proot-distro login clears the environment, so both
# go on that line. The change is made in a copy under $RUN -- the user's session file is never rewritten (CLI.md §5).
# Prints the copy; fails when the file needs no change.
session_runtime_copy() {  # file
    local f=$1 out=$RUN/session-runtime.sh vars=""
    if ! grep -q -- '--shared-tmp -- env ' "$f"; then
        # A chroot or a proot entry of the user's own: say once how to give it the cookie
        if grep -q 'chroot\|proot' "$f" && [ ! -e "$CONF/pulse-anonymous" ]; then
            log "Session $(basename "$f") may have no sound: pass PULSE_COOKIE (the file $PULSE_COOKIE_FILE) to its clients, see the README"
        fi
        return 1
    fi
    grep -q 'PULSE_COOKIE' "$f" || vars="PULSE_COOKIE=/tmp/xdesk-pulse-cookie "
    grep -q 'PULSE_SINK' "$f" || vars="${vars}PULSE_SINK=xdesk "
    # The display a file names is the one xdesk had when setup wrote it (:1 before 0.6.6): XDesk's current one
    # instead, or the desktop would open on another X
    if [ -z "$vars" ] && ! grep -- '--shared-tmp -- env ' "$f" | grep -qv "DISPLAY=$DPY "; then return 1; fi
    sed -e "0,/\(--shared-tmp -- env \)/s||\1$vars|" \
        -e "/--shared-tmp -- env /s/DISPLAY=:[0-9]\+ /DISPLAY=$DPY /" "$f" >"$out" || return 1
    echo "$out"
}

# The X server runs at -10; a session or program started from it (the X server itself runs xdesk launch, see
# XWindows.java) must not inherit that. A value the user chose stays: only one below the default is raised.
nice_normal() {
    [ "$(ps -o ni= -p $$ 2>/dev/null | tr -d ' ')" -lt 0 ] 2>/dev/null && renice -n 0 -p $$ >/dev/null 2>&1
}

start_session() {
    local name=$1 f g p
    f=$(session_file "$name") || { say "No session named $name (xdesk list shows them)"; return 1; }
    if [ -n "$(session_pid)" ]; then
        echo "Session $(cat "$RUN/session.name") is already running"
        return 0
    fi
    nice_normal
    if [ "$f" != /dev/null ] && g=$(session_runtime_copy "$f"); then f=$g; fi
    if [ "$name" != "${name%+apps}" ]; then
        # The app opens a Linux program on NAME+apps and never on the whole desktop. A session that is not XFCE has no
        # such variant of its own: Termux's window manager then, which serves the programs of every environment
        if [ "$f" != /dev/null ] && g=$(apps_only_script "$f" "${name%+apps}"); then
            f=$g
            # A Termux session's file may still hold the environment older setup froze into it (CLI.md §5)
            if [ "$(session_env "${name%+apps}")" = termux ] && g=$(termux_runtime_script "$f"); then f=$g; fi
        elif g=$(termux_apps_script "$([ "$(session_env "${name%+apps}")" = termux ] && echo 1)"); then
            [ "$f" = /dev/null ] || log "Session ${name%+apps} has no XFCE to start without its desktop: Termux's window manager instead"
            f=$g
        else
            say "No window manager for apps only: install one in Termux (pkg install xfwm4 xfce4-settings)"
            return 1
        fi
    elif [ "$(session_env "$name")" = termux ]; then
        # The environment of this start, not the one older setup wrote into the file: a runtime copy
        if g=$(termux_desktop_script "$f"); then
            f=$g
        elif g=$(termux_runtime_script "$f"); then
            f=$g
        fi
    fi
    # DISPLAY and the sound of the daemon xdesk talks to; PULSE_SINK sends the streams this session starts to XDesk's
    # null sink without touching the daemon's default sink (the user's own programs keep playing where they did)
    env DISPLAY=$DPY PULSE_SERVER=127.0.0.1 PULSE_COOKIE=$PULSE_COOKIE_FILE PULSE_SINK=xdesk \
        setsid nohup bash "$f" </dev/null >>"$LOG" 2>&1 9>&- &
    p=$!
    echo "$p" >"$RUN/session.pid"
    # Its start time: a reused pid later is not this session, and is never killed
    proc_ticks "$p" >"$RUN/session.started" 2>/dev/null
    echo "$name" >"$RUN/session.name"
    say "Started session $name"
    # The size the app asked for last, for this new session
    local dpi
    dpi=$(cut -d' ' -f1 "$RUN/scale" 2>/dev/null)
    [[ $dpi =~ ^[0-9]{2,4}$ ]] && scale_later "$dpi"
}

clear_stopped() { [ ! -e "$RUN/stopped" ] || rm -f "${RUN:?}/stopped"; }

clear_session_state() {
    rm -f "${RUN:?}/session.pid" "${RUN:?}/session.name" "${RUN:?}/session.started"
}

stop_session() {
    local p n bus="" wm pg
    p=$(session_pid) || { clear_session_state; return 0; }
    n=$(cat "$RUN/session.name" 2>/dev/null)
    # An apps only session has no xfce4-session to log out of: asking it can take 13 s (the logout's timeout, then the
    # wait for a session that never ends by itself) before 整个桌面 comes up
    if [ "$n" = "${n%+apps}" ]; then
        # xfce4-session can only log out on its own session bus, which is the window manager's environment
        if wm=$(session_wm_pid); then bus=$(proc_env "$wm" DBUS_SESSION_BUS_ADDRESS); fi
        if [ -n "$bus" ]; then
            DISPLAY=$DPY DBUS_SESSION_BUS_ADDRESS=$bus timeout 5 xfce4-session-logout --logout >/dev/null 2>&1
            for _ in $(seq 8); do kill -0 "$p" 2>/dev/null || break; sleep 1; done
        fi
    fi
    # The session was started with setsid, so its own process group is its pid. Never signal a group that belongs to
    # another program (a pid reused after a restart)
    pg=$(sed 's/^[0-9]* (.*) //' "/proc/$p/stat" 2>/dev/null | awk '{ print $3 }')
    if [ "$pg" = "$p" ]; then
        kill -- "-$p" 2>/dev/null
        sleep 1
        kill -9 -- "-$p" 2>/dev/null
    else
        kill "$p" 2>/dev/null
        sleep 1
        kill -9 "$p" 2>/dev/null
    fi
    clear_session_state
    log "Session stopped"
    # Nothing of a desktop is left: a bus kept for it would keep its D-Bus activated services (xfconfd and such) alive
    apps_bus_maybe_stop
}

write_session() {  # name, command; never overwrites an existing one
    local f=$SESSIONS/$1.sh
    [ -e "$f" ] && return 1
    ignored "$1" && return 1
    printf '%s\n' "$2" >"$f"
    echo "  found $1"
}


# A BCP 47 tag as a LANGUAGE value (CLI.md §5): the 4-letter script subtag goes ("zh-Hans-CN" -> "zh_CN").
# A zh tag without a region keeps the side its script names: zh-Hant -> zh_TW, zh-Hans -> zh_CN
locale_language() {  # tag
    local tag=${1:-} script="" part out
    local -a parts keep=()
    [ -n "$tag" ] || return 0
    IFS=- read -r -a parts <<<"$tag"
    for part in "${parts[@]}"; do
        if [[ $part =~ ^[A-Za-z]{4}$ ]]; then script=$part; continue; fi
        if [ ${#keep[@]} -eq 0 ]; then
            keep+=("$part")
        elif [[ $part =~ ^[A-Za-z]{2}$ ]]; then
            keep+=("${part^^}")
        else
            keep+=("$part")
        fi
    done
    if [ ${#keep[@]} -eq 1 ] && [ "${keep[0],,}" = zh ]; then
        case "${script,,}" in
        hant) keep+=(TW) ;;
        hans) keep+=(CN) ;;
        esac
    fi
    out=${keep[0]}
    for part in "${keep[@]:1}"; do out+="_$part"; done
    printf '%s\n' "$out"
}

# A copy of a Termux session script with the environment of this start in front (CLI.md §5). Older setup's own lines
# in the file (a frozen LANGUAGE, cursor theme or GPU line) are left as they are: the file's lines come after this
# environment, so they win. Nothing of the user's is removed.
termux_runtime_script() {  # file
    local out=$RUN/termux-session.sh
    { termux_env; cat "$1"; } >"$out" || return 1
    echo "$out"
}

# The launch environment of XDesk's own X server, written before the session's own lines: the GPU variables are
# XDesk's, and a line the user writes later (LANGUAGE, MESA_*, anything) overrides them -- bash exports in order.
# XDesk sets no language: the user's own locale and their session file decide (owner, 2026-11-19).
termux_env() {
    # With a Vulkan driver (Turnip on Adreno) Mesa runs OpenGL through zink by itself, and falls back to
    # software rendering when the driver finds no usable GPU. Forcing zink would break OpenGL there.
    # Broken graphics on some GPU: add export LIBGL_ALWAYS_SOFTWARE=1 to the session file
    ls "$PREFIX"/share/vulkan/icd.d/*.json >/dev/null 2>&1 && echo "export ZINK_DESCRIPTORS=lazy MESA_GLTHREAD=true MESA_VK_WSI_PRESENT_MODE=fifo vblank_mode=0"
    return 0
}

# The comment a new session file starts with: what the file is for, what XDesk adds, what may change and what must
# not (owner, 2026-11-19). Written once; the file is the user's from then on and never rewritten.
session_header() {  # name, termux|proot
    cat <<EOF
# XDesk's start script for "$1": XDesk runs this file when it starts this desktop on the external screen
# (xdesk start $1). Nothing else reads it: your own startx.sh or the official Termux:X11 do not.
# It is yours now: xdesk never rewrites or replaces it. Delete it and run "xdesk setup" for a fresh one.
#
EOF
    if [ "$2" = termux ]; then
        cat <<'EOF'
# Set by XDesk before this file runs (nothing to write here):
#   DISPLAY                        XDesk's screen. Do not change it: the desktop would not be on XDesk.
#   PULSE_SERVER PULSE_COOKIE PULSE_SINK=xdesk
#                                  sound into XDesk's sound output. Do not change them, or the external
#                                  screen has no sound.
#   Mesa/zink variables, with a GPU driver: XDesk's defaults; a line below with the same name wins.
#
# Free to add: environment variables (LANGUAGE, an input method's XMODIFIERS GTK_IM_MODULE QT_IM_MODULE, ...),
# commands to run before the desktop starts.
#
# The last line starts the desktop. Left exactly as written, XDesk runs it on its own D-Bus, so programs
# already open stay open when you switch from apps only to the whole desktop. Change it if you like: XDesk
# then runs what you wrote.
EOF
    else
        cat <<'EOF'
# The line below enters the container: proot-distro clears the environment, so what the desktop needs is on
# that line, after "env".
#   DISPLAY=...                    XDesk's screen. Do not remove it: XDesk puts its current display there
#                                  when it starts this file.
#   PULSE_SERVER PULSE_SINK PULSE_COOKIE
#                                  sound into XDesk's sound output. Do not remove them.
# Free to add: more NAME=value pairs after "env" (LANGUAGE, an input method's XMODIFIERS, ...), or a different
# desktop command at the end.
EOF
    fi
}

# Only the exec line: the environment is added when the session starts, not when setup writes the file (CLI.md §5)
termux_session() {  # name, command that starts the desktop
    session_header "$1" termux
    printf 'exec dbus-run-session %s\n' "$2"
}

# Names the user removed (xdesk rm): finding them again is not news to them, so discover leaves them out until an
# explicit xdesk setup or xdesk add
IGNORED=$CONF/ignored
ignored() { grep -qxF "$1" "$IGNORED" 2>/dev/null; }
unignore() {
    [ -f "$IGNORED" ] || return 0
    grep -vxF "$1" "$IGNORED" >"$IGNORED.tmp" 2>/dev/null
    mv -f "$IGNORED.tmp" "$IGNORED"
}

# Finds desktops and environments and writes what is new, one "  found NAME" line each; never overwrites. Cheap, so
# xdesk app state and envs run it too: a container or desktop installed later appears in the app with nothing to run
# (CLI.md §3.1). Read-only commands call it without "prune": writing a file that is not there is fine, deleting one
# is not -- a root that is only not mounted at the moment must keep its environment. setup (with "prune", an explicit
# request to look for everything) removes what setup wrote for a container that is gone.
discover() {  # 1 to remove what a gone container left
    local prune=${1:-} de bin name distro root found created f lf r hdr
    if [ "$prune" = 1 ]; then
        for lf in "$ENVS"/*.launch; do
            [ -e "$lf" ] || continue
            hdr=""
            IFS= read -r hdr <"$lf" || :
            [ "$hdr" = '# Runs "$@" in the container. Written by: xdesk setup' ] || continue
            name=${lf##*/}; name=${name%.launch}
            r=""
            if [ -f "$ENVS/$name.root" ]; then IFS= read -r r <"$ENVS/$name.root" || :; fi
            [ -n "$r" ] && [ ! -d "$r" ] || continue
            distro=${name#proot-}
            rm -f "${ENVS:?}/$name.root" "${ENVS:?}/$name.launch"
            # Its desktops, when they are exactly what setup wrote
            for f in "$SESSIONS"/"proot-$distro-"*.sh; do
                [ -e "$f" ] || continue
                grep -q "^exec proot-distro login $distro --shared-tmp -- env DISPLAY=" "$f" && rm -f "$f"
            done
            log "Container $distro is gone: removed its environment"
        done
    fi
    for de in xfce:startxfce4 lxqt:startlxqt mate:mate-session lxde:startlxde kde:startplasma-x11 openbox:openbox-session i3:i3; do
        name=${de%%:*}; bin=${de##*:}
        if command -v "$bin" >/dev/null; then
            write_session "termux-$name" "$(termux_session "termux-$name" "$bin")"
        fi
    done
    for root in "$PREFIX"/var/lib/proot-distro/containers/*/rootfs "$PREFIX"/var/lib/proot-distro/installed-rootfs/*; do
        [ -d "$root" ] || continue
        distro=${root%/rootfs}; distro=${distro##*/}
        found=0
        for de in xfce:startxfce4 lxqt:startlxqt mate:mate-session lxde:startlxde kde:startplasma-x11 openbox:openbox-session i3:i3; do
            name=${de%%:*}; bin=${de##*:}
            if [ -e "$root/usr/bin/$bin" ] || [ -L "$root/usr/bin/$bin" ]; then
                write_session "proot-$distro-$name" "$(session_header "proot-$distro-$name" proot)
exec proot-distro login $distro --shared-tmp -- env DISPLAY=$DPY PULSE_SERVER=127.0.0.1 PULSE_SINK=xdesk PULSE_COOKIE=/tmp/xdesk-pulse-cookie dbus-launch --exit-with-session $bin"
                found=1
            fi
        done
        # Every container is an environment, with or without a desktop: its programs open one by one.
        # Existing files belong to the user and are never overwritten
        created=0
        ignored "proot-$distro" && continue
        if [ ! -e "$ENVS/proot-$distro.root" ]; then
            printf '%s\n' "$root" >"$ENVS/proot-$distro.root"
            created=1
        fi
        if [ ! -e "$ENVS/proot-$distro.launch" ]; then
            {
                printf '# Runs "$@" in the container. Written by: xdesk setup\n'
                printf 'exec proot-distro login %s --shared-tmp -- "$@"\n' "$distro"
            } >"$ENVS/proot-$distro.launch"
            created=1
        fi
        # A container with a desktop is already found as its sessions; only a bare one is news
        [ $created = 1 ] && [ $found = 0 ] && echo "  found proot-$distro"
    done
    if [ ! -s "$CONF/current" ]; then
        for f in "$SESSIONS"/*.sh; do
            [ -e "$f" ] || continue
            name=${f##*/}
            echo "${name%.sh}" >"$CONF/current"
            break
        done
    fi
    return 0
}

setup() {
    echo "Looking for desktops..."
    # Asked for: everything removed before is looked for again, and a gone container's files may go
    rm -f "$IGNORED"
    discover 1
    list
    # chroot and proot scripts of other kinds cannot be found from here: say how to add one (CLI.md §3.4)
    echo "Other proot or chroot systems: xdesk add NAME --root DIR --launch 'entry command'"
}

list() {
    local f n c
    c=$(current)
    for f in "$SESSIONS"/*.sh; do
        [ -e "$f" ] || { echo "No sessions yet. Run: xdesk setup, or xdesk add NAME 'CMD'"; return 0; }
        n=${f##*/}; n=${n%.sh}
        if [ "$n" = "$c" ]; then echo "* $n"; else echo "  $n"; fi
    done
}

# --- Programs as apps (DISPLAY.md §1.2, §1.5) ---
# Each .desktop entry is an app the XDesk app can list and open on its own, keyed "SCOPE/ID": SCOPE is
# "termux" for Termux's own programs, or the name of a session whose system has its own root (proot-distro,
# or a NAME.root file next to NAME.sh), ID the desktop file id.

APPS_CACHE=$HOME/.cache/xdesk
APPS_FORMAT=1   # bump when the catalog's columns or the icons change
ICON_PX=64

# The file of a session, also for its "apps only" variant NAME+apps: X, xfwm4 and xfsettingsd, no panel or desktop
session_file() {
    local f=$SESSIONS/${1%+apps}.sh
    [ -f "$f" ] && { echo "$f"; return 0; }
    # Termux's programs need no session to be opened: apps only on Termux's own window manager (termux_apps_script).
    # The same for an environment without a desktop (CLI.md §3.1): the app opens its programs on NAME+apps
    [ "$1" = termux+apps ] && { echo /dev/null; return 0; }
    case "$1" in
    *+apps)
        if [ -f "$ENVS/${1%+apps}.launch" ] || [ -f "$ENVS/${1%+apps}.root" ]; then
            echo /dev/null
            return 0
        fi
        ;;
    esac
    return 1
}

# A D-Bus session bus of xdesk's own, for apps-only sessions in Termux. The programs opened there take the bus of the
# window manager (launch_app), and one from dbus-run-session ends with the session: "xdesk switch" to the whole
# desktop would close every GTK program with it (GLib exits when its session bus goes). It lives while a session or a
# program xdesk started is there to use it (apps_bus_maybe_stop), not until xdesk stop.
apps_bus() {
    local a p out
    # A session start and the app's launch may ask at the same time, from jobs that do not hold the main lock
    bus_lock || { log "D-Bus for apps only: timed out waiting for another command"; return 1; }
    a=$(cat "$RUN/bus.address" 2>/dev/null); p=$(cat "$RUN/bus.pid" 2>/dev/null)
    if [ -n "$a" ] && pid_ours "$p" "$RUN/bus.started" &&
            tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -q '^dbus-daemon '; then
        bus_unlock
        echo "$a"
        return 0
    fi
    if ! command -v dbus-daemon >/dev/null 2>&1; then bus_unlock; return 1; fi
    out=$(setsid dbus-daemon --session --fork --print-address=1 --print-pid=1 </dev/null 2>>"$LOG" 8>&- 9>&-) || { bus_unlock; return 1; }
    a=$(printf '%s\n' "$out" | sed -n 1p); p=$(printf '%s\n' "$out" | sed -n 2p)
    if [ -z "$a" ] || ! [[ $p =~ ^[0-9]+$ ]]; then bus_unlock; return 1; fi
    echo "$a" >"$RUN/bus.address"; echo "$p" >"$RUN/bus.pid"
    proc_ticks "$p" >"$RUN/bus.started" 2>/dev/null
    log "D-Bus for apps only: pid $p"
    bus_unlock
    echo "$a"
}

stop_apps_bus() {
    local p
    bus_lock || return 1
    p=$(cat "$RUN/bus.pid" 2>/dev/null)
    if pid_ours "$p" "$RUN/bus.started" &&
            tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -q '^dbus-daemon '; then kill "$p" 2>/dev/null; fi
    rm -f "${RUN:?}/bus.address" "${RUN:?}/bus.pid" "${RUN:?}/bus.started"
    bus_unlock
}

# A program xdesk started from the app or "xdesk launch" still runs: its wrapper writes launch/PID.pid and its start
# time beside it, and removes them when the program ends. A file left by a wrapper killed outright does not count.
launches_running() {
    local f
    for f in "$RUN"/launch/*.pid; do
        [ -e "$f" ] || continue
        pid_ours "$(cat "$f" 2>/dev/null)" "${f%.pid}.started" && return 0
    done
    return 1
}

# The apps bus lives while something xdesk started uses it. Once the last session and the last program are gone
# nothing would: a leftover bus keeps the services on it (xfconfd, gvfs, ...) running after the desktop ended, with
# their caches next to a desktop the user starts elsewhere (CLI.md §5).
apps_bus_maybe_stop() {
    [ -e "$RUN/bus.pid" ] || return 0
    # A bus made in the last 30 s may be for a session or program that is starting and not written down yet (the
    # app asks for its state meanwhile): it stays until the next check
    [ $(( $(date +%s) - $(stat -c %Y "$RUN/bus.pid" 2>/dev/null || echo 0) )) -ge 30 ] || return 0
    [ -z "$(session_pid)" ] && ! launches_running && stop_apps_bus
    return 0
}

# Generated Termux desktops share the bus with programs already open in apps-only mode.
termux_desktop_script() {
    local bus out=$RUN/desktop-session.sh
    grep -qE '^exec dbus-run-session (startxfce4|startlxqt|mate-session)$' "$1" || return 1
    bus=$(apps_bus) || return 1
    { echo "export DBUS_SESSION_BUS_ADDRESS=$(sq "$bus")"
      termux_env
      sed -E 's/^exec dbus-run-session (startxfce4|startlxqt|mate-session)$/exec \1/' "$1"
    } >"$out" || return 1
    echo "$out"
}

# --- The input method of the X side: read-only (INPUT.md §5.2) ---
# XDesk does not start, stop, configure or watch an X-side input method: that is the user's own, started in their
# session like any other program (fcitx5, ibus, whatever they chose), with its own environment and configuration.
# What is here only reads whether one runs on XDesk's display, for "xdesk ime" and the app's "Input method:" line.
# The phone's input method always reaches X through XDesk's text bridge, with or without one.
IME_PACKAGES="fcitx5 fcitx5-chinese-addons fcitx5-gtk3 fcitx5-gtk4 fcitx5-qt"

ime_installed() { [ -x "$PREFIX/bin/fcitx5" ]; }

proc_env() {  # pid, NAME: its value in that process's environment
    tr '\0' '\n' <"/proc/$1/environ" 2>/dev/null | sed -n "s/^$2=//p" | head -1
}

# Any fcitx5 running on our display, whoever started it: the user's session, its autostart, or a proot
ime_pid() {
    local p
    for p in $(pgrep -x fcitx5 2>/dev/null); do
        [ "$(proc_env "$p" DISPLAY)" = "$DPY" ] && { echo "$p"; return 0; }
    done
    return 1
}

# The remembered keyboard layout of XDesk's keyboard (INPUT.md §5.2), set with "xdesk keyboard layout NAME"
# ("xdesk ime layout" is the older name), removed with "auto". One XKB-ish name per line ("de-nodeadkeys")
layout_setting() { cat "$CONF/keyboard-layout" 2>/dev/null; }

# The keyboard layout X has now, as fcitx5 names it ("us", "de", "de-nodeadkeys"); "us" when it cannot be read.
# From the keymap itself: one loaded with xkbcomp leaves the root window's layout property as it was
ime_x_layout() {
    local s l
    s=$(DISPLAY=$DPY timeout 3 xkbcomp -w0 "$DPY" - 2>/dev/null | sed -n 's/^xkb_symbols[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    # "pc+de(nodeadkeys)+inet(evdev)": the part after "pc"
    l=$(printf '%s\n' "$s" | tr '+' '\n' | sed -n '2p')
    l=${l%%:*}
    if [[ $l =~ ^([a-z]{2,8})\(([A-Za-z0-9_-]+)\)$ ]]; then echo "${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"
    elif [[ $l =~ ^[a-z]{2,8}$ ]]; then echo "$l"
    else echo us; fi
}

# Checks a layout name against this system's XKB files: "de-nodeadkeys" is symbols/de with a
# xkb_symbols "nodeadkeys" section. Says why not and fails (exit 2 from the caller) for anything else.
valid_layout() {  # name
    local base=${1%%-*} variant=${1#*-} f
    [ "$variant" = "$1" ] && variant=""
    if ! [[ $base =~ ^[a-z]{2,8}$ ]]; then
        say "No such layout '$1': a layout is a fcitx5 name like 'us' or 'de-nodeadkeys'" >&2
        return 2
    fi
    if [ -n "$variant" ] && ! [[ $variant =~ ^[A-Za-z0-9_]+$ ]]; then
        say "No such layout '$1': a variant is letters, digits or _" >&2
        return 2
    fi
    f=$PREFIX/share/X11/xkb/symbols/$base
    [ -f "$f" ] || { say "No such layout '$1': $f is not installed (pkg install xkeyboard-config has it)" >&2; return 2; }
    [ -z "$variant" ] && return 0
    grep -q "xkb_symbols[[:space:]]*\"$variant\"" "$f" || { say "No such layout '$1': '$variant' is not a variant in $f" >&2; return 2; }
}

# Makes the remembered layout take effect on XDesk's own X server, with setxkbmap. The layout is a property of the
# keyboard XDesk gives the user; no input method is started, stopped or written. Another X on the same display is
# never touched (x_is_ours).
apply_layout() {  # name
    local l=$1 v=""
    if ! command -v setxkbmap >/dev/null 2>&1; then
        echo "setxkbmap is not installed: X keeps its layout (pkg install xorg-setxkbmap)"
        return 0
    fi
    if ! x_up; then
        echo "Layout: $l (set on XDesk's X server when it starts)"
        return 0
    fi
    if ! x_is_ours; then
        echo "Layout: $l (the X server on $DPY is not XDesk's: not changed)"
        return 0
    fi
    v=${l#*-}; [ "$v" = "$l" ] && v=""
    if DISPLAY=$DPY timeout 3 setxkbmap -layout "${l%%-*}" ${v:+-variant "$v"}; then
        log "X keyboard layout: $l (setxkbmap)"
    else
        say "setxkbmap could not set the layout"
    fi
}

# "xdesk keyboard layout" (the app calls the older "xdesk ime layout"): the remembered layout, or X's own. With a NAME
# it is saved (validated against this system's XKB files) and set on XDesk's X; "auto" goes back to X's own.
keyboard_layout_cmd() {  # NAME, or nothing
    local name=${1:-} s
    if [ -z "$name" ]; then
        if s=$(layout_setting) && [ -n "$s" ]; then
            echo "Layout: $s"
        elif x_is_ours; then
            echo "Layout: not set: from X ($(ime_x_layout))"
        else
            echo "Layout: not set: from X"
        fi
        return 0
    fi
    if [ "$name" = auto ]; then
        rm -f "${CONF:?}/keyboard-layout"
        echo "Layout: not set: from X (or whatever set X's keyboard)"
        return 0
    fi
    valid_layout "$name" || return $?
    mkdir -p "$CONF"
    printf '%s\n' "$name" >"$CONF/keyboard-layout"
    say "Layout: $name"
    apply_layout "$name"
}

# "xdesk ime": what runs on XDesk's display, read-only. An X input method is the user's own -- started in their
# session, configured there -- and XDesk neither starts nor stops one. The app reads the first line to choose whether
# a keyboard on the phone types as keys (raw, composed by that input method) or through the phone's own.
ime_status() {
    local p l s
    if p=$(ime_pid); then
        echo "Input method: fcitx5 (pid $p)"
    else
        echo "Input method: none"
    fi
    if ime_installed; then
        echo "fcitx5: installed in Termux (XDesk does not start or configure it: start it in your session, if you use it)"
    else
        echo "fcitx5: not installed (optional; for your own use: pkg install $IME_PACKAGES)"
    fi
    l=""
    x_is_ours && l=$(ime_x_layout)
    [ -n "$l" ] && echo "X keyboard layout: $l"
    if s=$(layout_setting) && [ -n "$s" ]; then
        echo "Layout: $s (remembered; xdesk keyboard layout auto removes it)"
    else
        echo "Layout: from X (xdesk keyboard layout NAME remembers one)"
    fi
}

# The session script with XFCE's start command replaced by the window manager alone. A session of Termux itself also
# runs xfsettingsd, so its own XFCE look applies; a proot or chroot session does not: Termux's XFCE theme, DPI and
# fonts must not be imposed on the container's programs. A Termux session runs it on xdesk's bus instead of one that
# ends with it
apps_only_script() {  # file, session name
    local out=$RUN/apps-session.sh bus rep
    grep -qE '(^|[[:space:]])(startxfce4|xfce4-session)([[:space:]]|$)' "$1" || return 1
    if [ "$(session_env "$2")" = termux ]; then
        rep="sh -c 'xfsettingsd \\& exec xfwm4'"
    else
        rep="sh -c 'exec xfwm4'"
    fi
    sed -E "s/(^|[[:space:]])(startxfce4|xfce4-session)([[:space:]]|\$)/\\1$rep\\3/" "$1" >"$out.tmp" || return 1
    if [ "$(session_env "$2")" = termux ] && grep -qE '(^|[[:space:]])dbus-run-session[[:space:]]' "$out.tmp" && bus=$(apps_bus); then
        { echo "export DBUS_SESSION_BUS_ADDRESS=$(sq "$bus")"
          sed -E 's/(^|[[:space:]])dbus-run-session[[:space:]]+(--[[:space:]]+)?/\1/' "$out.tmp"; } >"$out" || return 1
        rm -f "$out.tmp"
    else
        mv -f "$out.tmp" "$out" || return 1
    fi
    echo "$out"
}

# Apps only without any session: Termux's own window manager, for "termux+apps" and for sessions that are not XFCE.
# A session of Termux itself also runs xfsettingsd (its own XFCE look); a container's programs get the window manager
# alone, so Termux's theme, DPI and fonts are not imposed on them.
termux_apps_script() {  # 1 for Termux's own session
    local out=$RUN/apps-session.sh bus inner="xfwm4"
    command -v xfwm4 >/dev/null 2>&1 || return 1
    [ "${1:-}" = 1 ] && inner="sh -c 'xfsettingsd & exec xfwm4'"
    {
        termux_env
        if bus=$(apps_bus); then
            echo "export DBUS_SESSION_BUS_ADDRESS=$(sq "$bus")"
            echo "exec $inner"
        else
            echo "exec dbus-run-session $inner"
        fi
    } >"$out" || return 1
    echo "$out"
}

# The same files are read for every session by list_envs, app_state and app_scopes: one answer per name per run
declare -A _session_root_cache=() _session_env_cache=()

# The environment a session belongs to: "termux" for one that runs in Termux itself, else its own name (a proot or
# chroot system, the SCOPE of its programs). One environment is one device in the app
session_env() {
    local n=${1:-} f c e
    if [ -n "${_session_env_cache[$n]+x}" ]; then
        printf '%s\n' "${_session_env_cache[$n]}"
        return 0
    fi
    f=$SESSIONS/$n.sh
    case "$n" in
    termux|termux-*) e=termux ;;
    *)
        c=""
        [ -f "$f" ] && c=$(<"$f")
        session_root "$n" >/dev/null
        if [ -z "${_session_root_cache[$n]}" ] && [ ! -f "$SESSIONS/$n.launch" ] &&
                ! [[ $c =~ (^|[^[:alnum:]_-])(proot|proot-distro|chroot|unshare|nsenter)([[:space:]]|$) ]]; then
            e=termux
        else
            e=$n
        fi
        ;;
    esac
    _session_env_cache[$n]=$e
    printf '%s\n' "$e"
}

# The .launch that enters an environment and runs "$@" there, if any: a session's, else the environment's
env_launch_file() {
    if [ -f "$SESSIONS/$1.launch" ]; then echo "$SESSIONS/$1.launch"
    elif [ -f "$ENVS/$1.launch" ]; then echo "$ENVS/$1.launch"
    fi
}

# The entry command of a NAME.launch script: the "exec PREFIX \"$@\"" line xdesk writes. Empty for a script of
# the user's own
launch_prefix() {  # file
    sed -n 's/^exec \(.*\) "\$@"$/\1/p' "$1" 2>/dev/null | head -1
}

# What a session script or an environment's launch command enters it with, for the app's list. A session keeps
# the kind its .sh gave it; an environment without a session is classified by its .launch. Cached: the app state
# asks for every environment, and the file does not change during one xdesk command
declare -A _env_kind_cache=() _env_apps_cache=()
env_kind() {
    local n=${1:-} f c k
    if [ -n "${_env_kind_cache[$n]+x}" ]; then
        printf '%s\n' "${_env_kind_cache[$n]}"
        return 0
    fi
    f=$SESSIONS/$n.sh
    [ -f "$f" ] || f=$ENVS/$n.launch
    c=""
    [ -f "$f" ] && c=$(<"$f")
    if [[ $c =~ (^|[^[:alnum:]_-])(proot|proot-distro)([[:space:]]|$) ]]; then k=proot
    elif [[ $c =~ (^|[^[:alnum:]_-])(chroot|unshare|nsenter)([[:space:]]|$) ]]; then k=chroot
    else k=other; fi
    _env_kind_cache[$n]=$k
    printf '%s\n' "$k"
}

# Its programs can be listed and opened one by one: a root to read, and a way into it
env_apps() {
    local n=${1:-} c="" r=0
    if [ -n "${_env_apps_cache[$n]+x}" ]; then
        [ "${_env_apps_cache[$n]}" = 1 ]
        return
    fi
    session_root "$n" >/dev/null
    if [ -n "${_session_root_cache[$n]}" ]; then
        if [ -f "$SESSIONS/$n.launch" ] || [ -f "$ENVS/$n.launch" ]; then
            r=1
        else
            [ -f "$SESSIONS/$n.sh" ] && c=$(<"$SESSIONS/$n.sh")
            [[ $c == *"proot-distro login"* ]] && r=1
        fi
    fi
    _env_apps_cache[$n]=$r
    [ "$r" = 1 ]
}

# The sessions whose system has a root of its own: NAME<TAB>ROOT, root without a trailing slash
session_env_roots() {
    local f n r
    for f in "$SESSIONS"/*.sh; do
        [ -e "$f" ] || continue
        n=${f##*/}; n=${n%.sh}
        session_root "$n" >/dev/null
        r=${_session_root_cache[$n]}
        [ -n "$r" ] && printf '%s\t%s\n' "$n" "${r%/}"
    done
}

# Environments registered in envs/ that no session already covers: NAME<TAB>ROOT (ROOT empty for one with only a
# launch command). A container with desktops is listed through its sessions, never also as a desktop-less environment
plain_envs() {
    local f n r e skip seen=" "
    local -a roots=()
    while IFS=$'\t' read -r _ r; do roots+=("$r"); done < <(session_env_roots)
    for f in "$ENVS"/*.root "$ENVS"/*.launch; do
        [ -e "$f" ] || continue
        n=${f##*/}; n=${n%.*}
        case "$seen" in *" $n "*) continue ;; esac
        seen="$seen$n "
        [ -f "$SESSIONS/$n.sh" ] && continue
        r=""
        if [ -f "$ENVS/$n.root" ]; then IFS= read -r r <"$ENVS/$n.root" || :; fi
        r=${r%/}
        skip=""
        if [ -n "$r" ]; then
            for e in "${roots[@]}"; do
                [ "$e" = "$r" ] || [ "$e" -ef "$r" ] && { skip=1; break; }
            done
        fi
        [ -n "$skip" ] && continue
        printf '%s\t%s\n' "$n" "$r"
    done
}

# One line per environment: NAME, kind (termux, proot, chroot, other), "apps" when its programs can be listed and
# opened one by one (else "-"), its sessions joined by "/" (a name has no "/"). Tab separated; Termux first, always
list_envs() {
    local f n e apps sessions=""
    echo "#xdesk-envs 1"
    for f in "$SESSIONS"/*.sh; do
        [ -e "$f" ] || continue
        n=${f##*/}; n=${n%.sh}
        # Called without a command substitution so that the cache stays in this shell
        session_env "$n" >/dev/null
        [ "${_session_env_cache[$n]}" = termux ] && sessions="$sessions${sessions:+/}$n"
    done
    printf 'termux\ttermux\tapps\t%s\n' "$sessions"
    for f in "$SESSIONS"/*.sh; do
        [ -e "$f" ] || continue
        n=${f##*/}; n=${n%.sh}
        session_env "$n" >/dev/null
        e=${_session_env_cache[$n]}
        [ "$e" = termux ] && continue
        if env_apps "$n"; then apps=apps; else apps=-; fi
        env_kind "$n" >/dev/null
        printf '%s\t%s\t%s\t%s\n' "$n" "${_env_kind_cache[$n]}" "$apps" "$n"
    done
    # An environment without a session: no desktop of its own, so no sessions in the last field
    while IFS=$'\t' read -r n _; do
        if env_apps "$n"; then apps=apps; else apps=-; fi
        env_kind "$n" >/dev/null
        printf '%s\t%s\t%s\t%s\n' "$n" "${_env_kind_cache[$n]}" "$apps" ""
    done < <(plain_envs)
}

# A string in JSON: quotes, backslash and control characters escaped, everything else as it is (UTF-8)
json_str() {
    local s=$1 out="" c i
    for ((i = 0; i < ${#s}; i++)); do
        c=${s:i:1}
        case "$c" in
        "\\") out+="\\\\" ;;
        '"') out+='\"' ;;
        $'\n') out+='\n' ;;
        $'\r') out+='\r' ;;
        $'\t') out+='\t' ;;
        $'\b') out+='\b' ;;
        $'\f') out+='\f' ;;
        [[:cntrl:]]) printf -v c '\\u%04x' "'$c"; out+=$c ;;
        *) out+=$c ;;
        esac
    done
    printf '"%s"' "$out"
}

# Everything the app reads in one line of JSON (CLI.md §2), instead of parsing list, status and envs as text
app_state() {
    local f n sep xp xr started default running layout name kind apps sessions s2 sepr
    local -a ss=()
    # A session that ended on its own leaves the apps bus with nobody to serve: a state read (the app does one after
    # a desktop stops) is a good moment to check. Only the bus and its own runtime files are touched, never a
    # session or environment file (CLI.md §5.5).
    apps_bus_maybe_stop
    # json_str writes straight to the output: a command substitution here would fork once per field
    printf '{"format":1,"version":'
    json_str "$XDESK_CLI_VERSION"
    printf ',"sessions":['
    sep=""
    for f in "$SESSIONS"/*.sh; do
        [ -e "$f" ] || continue
        n=${f##*/}; n=${n%.sh}
        printf '%s' "$sep"
        json_str "$n"
        sep=,
    done
    printf '],'
    default=""
    [ -f "$CONF/current" ] && IFS= read -r default <"$CONF/current" || :
    if [ -n "$default" ]; then printf '"default":'; json_str "$default"; printf ','; else printf '"default":null,'; fi
    running=""
    if session_pid >/dev/null; then [ -f "$RUN/session.name" ] && IFS= read -r running <"$RUN/session.name" || :; fi
    if [ -n "$running" ]; then printf '"running":'; json_str "$running"; printf ','; else printf '"running":null,'; fi
    xp=$(x_pid)
    started=null
    if x_is_ours; then
        xr=true
        # Its start time, when the pid is known
        [ -n "$xp" ] && s2=$(x_started "$xp") && started=$s2
    else
        xr=false
    fi
    printf '"x":{"running":%s,"started":%s},' "$xr" "$started"
    if [ "$xr" = true ] && ime_pid >/dev/null; then printf '"ime":true,'; else printf '"ime":false,'; fi
    layout=""
    [ -f "$CONF/keyboard-layout" ] && IFS= read -r layout <"$CONF/keyboard-layout" || :
    if [ -n "$layout" ]; then printf '"layout":'; json_str "$layout"; printf ','; else printf '"layout":null,'; fi
    printf '"envs":['
    sep=""
    while IFS=$'\t' read -r name kind apps sessions; do
        [ "$name" = "#xdesk-envs 1" ] && continue
        [ -n "$name" ] || continue
        if [ "$apps" = apps ]; then apps=true; else apps=false; fi
        printf '%s{"name":' "$sep"
        json_str "$name"
        printf ',"kind":'
        json_str "$kind"
        printf ',"apps":%s,"sessions":[' "$apps"
        ss=()
        if [ -n "$sessions" ]; then IFS=/ read -r -a ss <<<"$sessions"; fi
        sepr=""
        for s2 in "${ss[@]}"; do printf '%s' "$sepr"; json_str "$s2"; sepr=,; done
        printf ']}'
        sep=,
    done < <(list_envs)
    printf ']}\n'
}

# The apps-only session a program of this scope is opened on when nothing runs: the environment's own, for Termux the
# default session if it is one of Termux's, else the first of them, else none at all ("termux+apps"). An environment
# without a session uses Termux's own window manager; without one there too, the program opens without a window manager
apps_session_for() {  # scope
    local c f n
    if [ "$1" != termux ]; then
        if [ -f "$SESSIONS/$1.sh" ]; then echo "$1+apps"; else echo termux+apps; fi
        return 0
    fi
    c=$(current)
    if [ -n "$c" ] && [ -f "$SESSIONS/$c.sh" ] && [ "$(session_env "$c")" = termux ]; then echo "$c+apps"; return 0; fi
    for f in "$SESSIONS"/*.sh; do
        [ -e "$f" ] || continue
        n=${f##*/}; n=${n%.sh}
        [ "$(session_env "$n")" = termux ] && { echo "$n+apps"; return 0; }
    done
    echo termux+apps
}

# The root directory of a session's or environment's system, empty for one that runs in Termux itself
session_root() {
    local n=${1:-} f d="" c r="" ln rest w
    local -a words=()
    if [ -n "${_session_root_cache[$n]+x}" ]; then
        [ -n "${_session_root_cache[$n]}" ] && printf '%s\n' "${_session_root_cache[$n]}"
        return 0
    fi
    f=$SESSIONS/$n.sh
    if [ -f "$SESSIONS/$n.root" ]; then
        IFS= read -r r <"$SESSIONS/$n.root"
    else
        # The first word after "proot-distro login" that is not an option (the distro name), from the first line
        # that has the command. Builtins only: this runs per session, and every process costs on a phone
        if [ -f "$f" ]; then
            while IFS= read -r ln || [ -n "$ln" ]; do
                case "$ln" in
                *"proot-distro login "*|*$'proot-distro login\t'*)
                    rest=${ln##*proot-distro login}
                    rest=${rest#"${rest%%[![:space:]]*}"}
                    read -r -a words <<<"$rest"
                    for w in "${words[@]}"; do
                        case "$w" in -*) continue ;; *) d=$w; break ;; esac
                    done
                    break
                    ;;
                esac
            done <"$f"
        fi
        if [ -z "$d" ]; then
            # An environment registered without a session (xdesk add NAME --root DIR); a session is never overridden by one
            if [ ! -f "$f" ] && [ -f "$ENVS/$n.root" ]; then IFS= read -r r <"$ENVS/$n.root"; fi
        else
            for c in "$PREFIX/var/lib/proot-distro/installed-rootfs/$d" "$PREFIX/var/lib/proot-distro/containers/$d/rootfs"; do
                [ -d "$c/usr" ] && { r=$c; break; }
            done
        fi
    fi
    _session_root_cache[$n]=$r
    [ -n "$r" ] && printf '%s\n' "$r"
    return 0
}

# Scopes with programs, one per line: "termux", every session with a root of its own, and every environment
# a session does not cover (CLI.md §3.1)
app_scopes() {
    local n r
    echo termux
    while IFS=$'\t' read -r n _; do echo "$n"; done < <(session_env_roots)
    while IFS=$'\t' read -r n r; do [ -n "$r" ] && echo "$n"; done < <(plain_envs)
    return 0
}

app_dirs() {  # scope: application directories, most important first
    local r
    if [ "$1" = termux ]; then
        echo "$HOME/.local/share/applications"
        echo "$PREFIX/share/applications"
    else
        r=$(session_root "$1")
        [ -n "$r" ] || return 0
        echo "$r/root/.local/share/applications"
        echo "$r/usr/local/share/applications"
        echo "$r/usr/share/applications"
    fi
}

app_locale() {
    local l=${LANGUAGE:-} raw
    l=${l%%:*}
    if [ -z "$l" ]; then
        raw=$(getprop persist.sys.locale 2>/dev/null)
        [ -n "$raw" ] && l=$(locale_language "$raw")
    fi
    [ -n "$l" ] || { l=${LANG:-}; l=${l%%.*}; }
    echo "$l"
}

# One row per desktop file: path, then the [Desktop Entry] keys the catalog uses, separated by \037 (a tab
# would merge empty fields in read). Tabs in values become spaces
desktop_rows() {  # locale, files...
    local loc=$1
    shift
    [ $# -gt 0 ] || return 0
    awk -v loc="$loc" -v S=$'\037' '
        function flush(   name, lang) {
            if (f == "") return
            lang = loc; sub(/_.*/, "", lang)
            name = v["Name[" loc "]"]
            if (name == "") name = v["Name[" lang "]"]
            if (name == "") name = v["Name"]
            print f S v["Type"] S name S v["NoDisplay"] S v["Hidden"] S v["Terminal"] S v["TryExec"] S v["Icon"] S v["StartupWMClass"] S v["OnlyShowIn"] S v["NotShowIn"] S v["Exec"] S v["Path"]
        }
        { sub(/\r$/, "") }
        FNR == 1 { flush(); f = FILENAME; grp = 0; split("", v) }
        /^\[/ { grp = ($0 == "[Desktop Entry]"); next }
        grp && /^[^#]/ {
            i = index($0, "=")
            if (!i) next
            k = substr($0, 1, i - 1); sub(/[ \t]+$/, "", k)
            val = substr($0, i + 1); sub(/^[ \t]+/, "", val); gsub(/\t/, " ", val)
            if (!(k in v)) v[k] = val
        }
        END { flush() }' "$@" 2>/dev/null
}

# Desktop files of a scope, as "ID<TAB>path"; an ID found in an earlier directory hides later ones
desktop_files() {
    local d f id seen=" "
    while IFS= read -r d; do
        [ -d "$d" ] || continue
        for f in "$d"/*.desktop "$d"/*/*.desktop; do
            [ -f "$f" ] || continue
            id=${f#"$d"/}
            id=${id%.desktop}
            id=${id//\//-}
            case "$seen" in *" $id "*) continue ;; esac
            seen="$seen$id "
            printf '%s\t%s\n' "$id" "$f"
        done
    done < <(app_dirs "$1")
}

icon_theme() {
    sed -n 's/.*name="IconThemeName"[^>]*value="\([^"]*\)".*/\1/p' \
        "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml" 2>/dev/null | head -1
}

# The file for an Icon= value: a path as it is, else a name looked up in the icon themes, then pixmaps
find_icon() {  # scope root ("" for Termux), theme, icon
    local root=$1 theme=$2 icon=$3 base t s e f
    case "$icon" in
    "") return 1 ;;
    /*) f=$root$icon; [ -f "$f" ] && echo "$f" && return 0; return 1 ;;
    esac
    icon=${icon%.png}; icon=${icon%.svg}; icon=${icon%.xpm}
    local -a bases
    if [ -z "$root" ]; then
        bases=("$HOME/.local/share/icons" "$HOME/.icons" "$PREFIX/share/icons")
    else
        bases=("$root/usr/local/share/icons" "$root/usr/share/icons")
    fi
    # Usually SIZE/apps; then any context (SIZE/actions, ...) and the other layout, CONTEXT/SIZE
    local pat
    for pat in '$s/apps' '$s/*' '*/$s'; do
        for t in ${theme:+"$theme"} hicolor Adwaita AdwaitaLegacy breeze gnome; do
            for base in "${bases[@]}"; do
                [ -d "$base/$t" ] || continue
                for s in 64x64 64 96x96 128x128 48x48 48 scalable 256x256 512x512 32x32; do
                    for e in png svg; do
                        for f in "$base/$t/"${pat//\$s/$s}"/$icon.$e"; do
                            [ -f "$f" ] && { echo "$f"; return 0; }
                        done
                    done
                done
            done
        done
    done
    for base in ${root:+"$root/usr/share/pixmaps"} "${root:-$PREFIX}/share/pixmaps"; do
        for e in png svg xpm; do
            f=$base/$icon.$e
            [ -f "$f" ] && { echo "$f"; return 0; }
        done
    done
    return 1
}

# A small PNG of an icon file, base64 on one line; nothing when it cannot be made. Converted icons are kept
icon_png64() {
    local src=$1 out
    out=$APPS_CACHE/icons/$(printf '%s' "$src" | cksum | cut -d' ' -f1).png
    if [ ! -s "$out" ] || [ "$src" -nt "$out" ]; then
        case "$src" in
        *.svg|*.svgz)
            command -v rsvg-convert >/dev/null || return 0
            rsvg-convert -w $ICON_PX -h $ICON_PX -a -f png -o "$out" "$src" 2>/dev/null || { rm -f "$out"; return 0; }
            ;;
        */64x64/*|*/64/*|*/48x48/*|*/48/*|*/96x96/*|*/32x32/*)
            out=$src ;;
        *)
            if command -v magick >/dev/null; then
                magick "$src" -resize ${ICON_PX}x${ICON_PX} "png:$out" 2>/dev/null || { rm -f "$out"; return 0; }
            else
                case "$src" in *.png) out=$src ;; *) return 0 ;; esac
            fi
            ;;
        esac
    fi
    base64 -w0 "$out" 2>/dev/null
}

# Whatever changes the catalog: the session and environment files (a proot login line changes a scope's root), the
# directories, the desktop files themselves (an edited Name= changes no directory time), the icons, language, theme
apps_signature() {
    local s d b
    echo "format $APPS_FORMAT $ICON_PX $(app_locale) $(icon_theme)"
    stat -c '%n %Y' "$SESSIONS" "$SESSIONS"/*.sh "$SESSIONS"/*.launch "$SESSIONS"/*.root \
        "$ENVS" "$ENVS"/* 2>/dev/null
    while IFS= read -r s; do
        while IFS= read -r d; do
            stat -c '%n %Y' "$d" "$d"/*/ "$d"/*.desktop "$d"/*/*.desktop 2>/dev/null
        done < <(app_dirs "$s")
        # The icon directories find_icon looks in: a theme or a size added there changes the catalog's icons
        if [ "$s" = termux ]; then
            for b in "$HOME/.local/share/icons" "$HOME/.icons" "$PREFIX/share/icons" "$PREFIX/share/pixmaps"; do
                stat -c '%n %Y' "$b" "$b"/*/ 2>/dev/null
            done
        else
            d=$(session_root "$s")
            if [ -n "$d" ]; then
                for b in "$d/usr/local/share/icons" "$d/usr/share/icons" "$d/usr/share/pixmaps"; do
                    stat -c '%n %Y' "$b" "$b"/*/ 2>/dev/null
                done
            fi
        fi
    done < <(app_scopes)
}

tryexec_ok() {  # root, program
    local root=$1 p=$2 d
    [ -n "$p" ] || return 0
    if [ -z "$root" ]; then
        command -v "$p" >/dev/null 2>&1
        return
    fi
    case "$p" in /*) [ -e "$root$p" ]; return ;; esac
    for d in /usr/local/bin /usr/bin /bin /usr/games; do [ -e "$root$d/$p" ] && return 0; done
    return 1
}

# The catalog: a header line, then KEY, name, terminal (0/1), StartupWMClass, icon (base64 PNG or empty)
build_catalog() {
    local out=$1 loc theme scope root id path rows tmp
    local file type name nodisp hidden term tryexec icon wmclass only notshow exe wd ic
    loc=$(app_locale)
    theme=$(icon_theme)
    mkdir -p "$APPS_CACHE/icons"
    # A unique name next to the target: another xdesk command may write its own catalog at the same time
    tmp=$(mktemp "${out}.XXXXXX") || return 1
    {
        echo "#xdesk-apps $APPS_FORMAT"
        while IFS= read -r scope; do
            root=""
            [ "$scope" = termux ] || root=$(session_root "$scope")
            declare -A ids=()
            local -a files=()
            while IFS=$'\t' read -r id path; do
                ids[$path]=$id
                files+=("$path")
            done < <(desktop_files "$scope")
            while IFS=$'\037' read -r file type name nodisp hidden term tryexec icon wmclass only notshow exe wd; do
                [ "$type" = Application ] && [ -n "$name" ] && [ -n "$exe" ] || continue
                [ "$nodisp" = true ] || [ "$hidden" = true ] && continue
                if [ -n "$only" ]; then case ";$only;" in *";XFCE;"*) ;; *) continue ;; esac; fi
                case ";$notshow;" in *";XFCE;"*) continue ;; esac
                tryexec_ok "$root" "$tryexec" || continue
                ic=""
                icon=$(find_icon "$root" "$theme" "$icon") && ic=$(icon_png64 "$icon")
                [ "$term" = true ] && term=1 || term=0
                # A packager's unfilled template (Termux's chromium.desktop: @@startup_wm_class) names no class
                case "$wmclass" in *@@*) wmclass="" ;; esac
                printf '%s/%s\t%s\t%s\t%s\t%s\n' "$scope" "${ids[$file]}" "$name" "$term" "$wmclass" "$ic"
            done < <(desktop_rows "$loc" "${files[@]}")
            unset ids
        done < <(app_scopes)
    } >"$tmp" || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$out"
}

# Rebuilds the catalog when anything it depends on changed; runs with the catalog lock held
catalog_refresh() {  # catalog, 1 to rebuild even when the signature matches
    local cat=$1 sig tmp
    sig=$(apps_signature)
    if [ "$2" = 1 ] || [ ! -s "$cat" ] || [ "$sig" != "$(cat "$APPS_CACHE/apps.sig" 2>/dev/null)" ]; then
        build_catalog "$cat" || return 1
        tmp=$(mktemp "${APPS_CACHE}/apps.sig.XXXXXX") || return 1
        if ! { printf '%s\n' "$sig" >"$tmp" && mv -f "$tmp" "$APPS_CACHE/apps.sig"; }; then
            rm -f "$tmp"
            return 1
        fi
        log "App catalog rebuilt: $(($(wc -l <"$cat") - 1)) apps"
    fi
}

# Makes the catalog when anything it depends on changed. Prints its path. The app and the X server can ask at the
# same time, so one builds while the other waits; a deadline keeps a stuck build from hanging everything
apps_catalog() {
    local cat=$APPS_CACHE/apps.tsv
    mkdir -p "$APPS_CACHE"
    if command -v flock >/dev/null 2>&1; then
        ( exec 7>"$APPS_CACHE/lock"
          flock -w 30 7 || { log "App catalog: timed out waiting for another build"; exit 1; }
          catalog_refresh "$cat" "${1:-0}" ) 7>&- || return 1
    else
        catalog_refresh "$cat" "${1:-0}" || return 1
    fi
    echo "$cat"
}

# For sh -c '...': one word in single quotes
sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# The Exec= value as a shell command: string escapes undone, field codes (%f %U ...) dropped, %% kept as %
exec_command() {
    local e=$1
    e=${e//\\\\/$'\001'}
    e=${e//\\s/ }; e=${e//\\t/$'\t'}; e=${e//\\n/ }; e=${e//\\r/}
    e=${e//$'\001'/\\}
    e=${e//%%/$'\002'}
    e=${e//%[fFuUdDnNvmick]/}
    e=${e//$'\002'/%}
    echo "$e"
}

# The environment of the session's window manager, if it runs in Termux itself: its D-Bus, language, GPU settings
session_wm_pid() {
    local p
    for p in $(pgrep -x xfwm4 2>/dev/null); do
        tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | grep -qx "DISPLAY=$DPY" && { echo "$p"; return 0; }
    done
    return 1
}

import_env() {  # pid
    local kv n
    while IFS= read -r -d '' kv; do
        n=${kv%%=*}
        case "$n" in PWD|OLDPWD|SHLVL|_|DESKTOP_STARTUP_ID|LD_PRELOAD|LD_LIBRARY_PATH|CLASSPATH|XDESK_*) continue ;; esac
        [[ $n =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && export "$kv"
    done <"/proc/$1/environ"
}

# A terminal for Terminal=true programs, chosen where the program runs. $0 is the command
TERM_WRAP='for t in xfce4-terminal x-terminal-emulator xterm; do command -v $t >/dev/null 2>&1 && break; done
if [ "$t" = xfce4-terminal ]; then exec $t -x sh -c "$0"; else exec $t -e sh -c "$0"; fi'

# The program word of Exec=, after leading "env" and VAR=value words (CLI.md §5.1)
exec_program() {  # command
    local x
    local -a w
    read -r -a w <<<"${1:-}"
    for x in "${w[@]}"; do
        case "$x" in
        env|*/env) continue ;;
        [A-Za-z_]*=*) continue ;;
        *)
            x=${x#\"}; x=${x%\"}; x=${x#\'}; x=${x%\'}
            printf '%s\n' "$x"
            return 0
            ;;
        esac
    done
    return 1
}

# A shell builtin needs no file: it runs inside the sh -c the launcher starts
shell_builtin() {  # word
    case "${1:-}" in
    '['|'.'|':'|alias|bg|break|cd|command|continue|echo|eval|exec|exit|export|false|fg|getopts|hash|jobs|kill|let|local|printf|pwd|read|readonly|return|set|shift|test|times|trap|true|type|ulimit|umask|unalias|unset|wait) return 0 ;;
    esac
    return 1
}

# Whether the program Exec= names is there, in the PATH the environment has (CLI.md §5.1). An absolute path is
# checked under the root; a symlink counts even when its target is not readable (a container's own /bin)
program_installed() {  # root (empty for Termux), program
    local root=$1 p=$2 d
    case "$p" in
    /*)
        if [ -z "$root" ]; then [ -e "$p" ] || [ -L "$p" ]; else [ -e "$root$p" ] || [ -L "$root$p" ]; fi
        return
        ;;
    esac
    if [ -z "$root" ]; then [ -e "$PREFIX/bin/$p" ] || [ -L "$PREFIX/bin/$p" ]; return; fi
    for d in /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin /usr/games; do
        if [ -e "$root$d/$p" ] || [ -L "$root$d/$p" ]; then return 0; fi
    done
    return 1
}

# A terminal for Terminal=true, in the environment where TERM_WRAP would start it
terminal_installed() {  # root (empty for Termux)
    local root=${1:-} t d
    if [ -z "$root" ]; then
        for t in xfce4-terminal x-terminal-emulator xterm; do
            command -v "$t" >/dev/null 2>&1 && return 0
        done
        return 1
    fi
    for t in xfce4-terminal x-terminal-emulator xterm; do
        for d in "$root/usr/bin" "$root/usr/local/bin" "$root/bin"; do
            if [ -e "$d/$t" ] || [ -L "$d/$t" ]; then return 0; fi
        done
    done
    return 1
}

# The GPU initialization failures §5.2 retries in software: EGL, GLX, zink, Vulkan, Mesa and the Adreno kernel driver
gpu_failure_signature() {  # output
    printf '%s\n' "$1" | grep -qiE 'EGL|GLX|glXCreateContext|Failed to create .*context|zink|vkCreateInstance|MESA.*error|kgsl'
}

# The retry would change nothing when software rendering is already asked for
software_rendering() {
    local kv
    [ "${LIBGL_ALWAYS_SOFTWARE:-}" = 1 ] && return 0
    [ "${GALLIUM_DRIVER:-}" = llvmpipe ] && return 0
    for kv in "${e[@]}"; do
        [ "$kv" = "LIBGL_ALWAYS_SOFTWARE=1" ] || [ "$kv" = "GALLIUM_DRIVER=llvmpipe" ] && return 0
    done
    return 1
}

# One line the app translates; the sentence after the code is for people and for older apps (CLI.md §5.1, §5.4)
launch_error() {  # code, detail, sentence, exit status
    say "xdesk-error $1 $2: $3"
    exit "${4:-1}"
}

# The launches kept are the last 20 (CLI.md §5.4); their files are named by the wrapper's pid
trim_launch() {
    local f
    ls -1t "$RUN"/launch/*.log 2>/dev/null | tail -n +20 | while IFS= read -r f; do
        rm -f "$f" "${f%.log}.status" "${f%.log}.fifo" "${f%.log}.pid" "${f%.log}.started"
    done
}

# What the wrapper says about a program that has exited (CLI.md §5.4). Sets reason and detail in the caller
launch_classify() {  # exit code, output
    local code=$1 out=$2 lib last sig
    reason=""
    detail=""
    if [ "$code" = 0 ]; then reason="ok"; return; fi
    lib=$(printf '%s\n' "$out" | sed -n 's/.*error while loading shared libraries: \([^: ]*\).*/\1/p' | head -1)
    if [ -n "$lib" ]; then reason="missing-lib"; detail="$lib"; return; fi
    if printf '%s\n' "$out" | grep -qiE "cannot open display|can't open display"; then reason="no-display"; return; fi
    if [ "$code" = 127 ] ||
            printf '%s\n' "$out" | grep -qiE 'command not found|no such file or directory'; then
        reason="not-found"
        detail="$prog"
        return
    fi
    if gpu_failure_signature "$out"; then reason="gpu"; return; fi
    if [ "$code" -gt 128 ]; then
        reason="crash"
        sig=$(kill -l "$((code - 128))" 2>/dev/null) || sig=""
        if [ -n "$sig" ]; then detail="SIG${sig#SIG}"; else detail="SIG$((code - 128))"; fi
        return
    fi
    last=$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -1)
    reason="error"
    detail=${last:0:200}
}

# A session started a moment ago (by the app, for this very program) may not have its window manager up yet. The
# program's window must not come first: the request that makes it the full screen window would go to nobody
wait_wm() {
    local age deadline
    age=$(( $(date +%s) - $(stat -c %Y "$RUN/session.pid" 2>/dev/null || echo 0) ))
    [ "$age" -lt 20 ] || return 0
    # 6 s at most: an xprop that times out must not stretch the wait for the app
    deadline=$((SECONDS + 6))
    if command -v xprop >/dev/null 2>&1; then
        while [ $SECONDS -lt $deadline ]; do
            DISPLAY=$DPY timeout 2 xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q "window id" && return 0
            sleep 0.25
        done
        return 0
    fi
    # Without xprop: the window manager's process, and a moment for it to take over the display if it is that new
    while [ $SECONDS -lt $deadline ]; do
        session_wm_pid >/dev/null && break
        sleep 0.25
    done
    [ "$age" -ge 4 ] || sleep 0.7
}

launch_app() {
    local sid="" key scope id file s row cmd root wm line kv launchf prog
    local lp st fifo reason detail retried rc duration attempt child teepid before
    local wm_started=1
    local -a e=()
    # The app runs this from the X server process (XWindows.java), which is at -10: the program must not inherit it
    nice_normal
    while [ $# -gt 0 ]; do
        case "$1" in
        --startup-id)
            [ $# -ge 2 ] || launch_error bad-key --startup-id "no value after --startup-id" 2
            sid=$2; shift 2
            ;;
        --) shift; break ;;
        -*) launch_error bad-key "$1" "unknown option: $1" 2 ;;
        *) break ;;
        esac
    done
    key=${1:-}
    [ -n "$key" ] || launch_error bad-key none "no app given" 2
    case "$key" in
    */*) scope=${key%%/*}; id=${key#*/} ;;
    *) scope=""; id=$key ;;
    esac
    case "$scope$id" in *..*|*/*|'') launch_error bad-key "$key" "Invalid app: $key" 2 ;; esac
    # An explicit scope is used as it is; otherwise every scope with programs is searched, one line at a time
    file=""
    if [ -n "$scope" ]; then
        file=$(desktop_files "$scope" | awk -F'\t' -v id="$id" '$1 == id { print $2; exit }')
    else
        while IFS= read -r s; do
            file=$(desktop_files "$s" | awk -F'\t' -v id="$id" '$1 == id { print $2; exit }')
            [ -n "$file" ] && { scope=$s; break; }
        done < <(app_scopes)
    fi
    [ -n "$file" ] || launch_error no-app "$key" "No app $key. Try: xdesk apps" 1
    row=$(desktop_rows "" "$file")
    IFS=$'\037' read -r _ _ _ _ _ term _ _ _ _ _ cmd wd <<<"$row"
    cmd=$(exec_command "$cmd")
    [ -n "$cmd" ] || launch_error no-app "$key" "App $key has no command" 1
    prog=$(exec_program "$cmd") || prog=""
    cmd="exec $cmd"
    [ -n "$wd" ] && cmd="cd $(sq "$wd") 2>/dev/null; $cmd"
    [ -n "$sid" ] || sid="xdesk-$id-$$_TIME0"

    # --- Before the pid line: can this program run in that environment at all? (CLI.md §5.1, §5.4) ---
    root=""
    line=""
    launchf=""
    if [ "$scope" != termux ]; then
        root=$(session_root "$scope")
        launchf=$(env_launch_file "$scope")
        if [ -z "$launchf" ]; then
            line=$(grep -m1 'proot-distro login' "$SESSIONS/$scope.sh" 2>/dev/null || :)
            if [ -z "$line" ]; then
                if [ -f "$SESSIONS/$scope.sh" ]; then
                    launch_error no-env "$scope" "Session $scope: write $SESSIONS/$scope.launch to run programs in it" 1
                else
                    launch_error no-env "$scope" "Environment $scope: write $ENVS/$scope.launch to run programs in it" 1
                fi
            fi
            command -v proot-distro >/dev/null 2>&1 ||
                launch_error no-env "$scope" "proot-distro is not installed (pkg install proot-distro)" 1
        elif grep -q 'proot-distro' "$launchf" 2>/dev/null && ! command -v proot-distro >/dev/null 2>&1; then
            launch_error no-env "$scope" "proot-distro is not installed (pkg install proot-distro)" 1
        fi
    fi
    if [ -n "$prog" ] && ! shell_builtin "$prog"; then
        if [ "$scope" = termux ]; then
            program_installed "" "$prog" ||
                launch_error not-installed "$prog" "$prog is not installed in Termux" 1
        elif [ -n "$root" ] && [ -r "$root" ]; then
            # A root xdesk cannot read (a chroot): nothing to check against, the program is started as before
            program_installed "$root" "$prog" ||
                launch_error not-installed "$prog" "$prog is not installed in $scope" 1
        fi
    fi
    if [ "$term" = true ]; then
        if [ "$scope" = termux ]; then
            terminal_installed "" ||
                launch_error no-terminal "$scope" "no terminal program (xfce4-terminal, x-terminal-emulator or xterm) in Termux" 1
        elif [ -n "$root" ] && [ -r "$root" ]; then
            terminal_installed "$root" ||
                launch_error no-terminal "$scope" "no terminal program (xfce4-terminal, x-terminal-emulator or xterm) in $scope" 1
        fi
    fi

    # The X server (which runs this for the app) is on half the cores, and what is started here would inherit that
    command -v taskset >/dev/null && taskset -p "$(printf '%x' $(( (1 << $(nproc --all)) - 1 )))" $$ >/dev/null 2>&1
    # A program alone needs X and a window manager (the app makes its window the full screen one through it), never a
    # desktop: with no session running, the apps-only one of its environment. The app has started it already when it
    # opens a program; this is for "xdesk launch" from a shell and for a session that ended under a running X.
    # XDESK_TEST_NO_X=1 (xdesk/test/cli-test.sh) skips only this X and window manager startup
    if [ "${XDESK_TEST_NO_X:-}" != 1 ]; then
        if ! x_is_ours || [ -z "$(session_pid)" ]; then
            need_tools
            # Also waits for an "xdesk start" that has X up and not yet its session: the app asks as soon as X connects
            lock
            if ! x_is_ours; then start_x && start_audio || exit 1; fi
            if [ -z "$(session_pid)" ]; then
                if ! ( unset CLASSPATH XDESK_AUDIO_SOCKET XDESK_CLI; start_session "$(apps_session_for "$scope")" ) >/dev/null; then
                    log "Launching $scope/$id without a window manager"
                    wm_started=0
                fi
            fi
            exec 9>&-
        fi
        # A session that did not start has no window manager to wait for
        [ $wm_started = 1 ] && wait_wm
    else
        exec 9>&-
    fi
    # Who asks (the X server for the app) learns which process to follow, before everything goes to the log
    echo "pid $$"
    log "Launching $scope/$id: $cmd"

    mkdir -p "$RUN/launch"
    lp=$RUN/launch/$$.log
    st=$RUN/launch/$$.status
    fifo=$RUN/launch/$$.fifo
    trim_launch
    rm -f "$fifo"
    mkfifo "$fifo" || { log "Launch: could not make $fifo"; exit 1; }
    # A program xdesk started still runs while this wrapper does: apps_bus_maybe_stop keeps the apps bus for it
    echo $$ >"$RUN/launch/$$.pid"
    proc_ticks $$ >"$RUN/launch/$$.started" 2>/dev/null
    # The wrapper's own stdio must not keep RUN_COMMAND's pipes open: the program's output goes to the two logs
    exec </dev/null >>"$lp" 2>&1
    unset CLASSPATH XDESK_AUDIO_SOCKET XDESK_CLI
    if [ "$scope" = termux ]; then
        if wm=$(session_wm_pid) && tr '\0' '\n' <"/proc/$wm/environ" 2>/dev/null | grep -q "^PREFIX=$PREFIX\$"; then
            import_env "$wm"
        else
            eval "$(termux_env)"
        fi
        export DISPLAY=$DPY PULSE_SERVER=127.0.0.1 PULSE_SINK=xdesk PULSE_COOKIE=$PULSE_COOKIE_FILE DESKTOP_STARTUP_ID=$sid
    else
        [ "$term" = true ] && cmd="exec sh -c $(sq "$TERM_WRAP") $(sq "$cmd")"
        e=("DISPLAY=$DPY" "PULSE_SERVER=127.0.0.1" "PULSE_SINK=xdesk" "DESKTOP_STARTUP_ID=$sid")
        # The session's D-Bus, language and runtime directory, when its window manager runs in that system (not in
        # Termux). An input method is the user's own: its environment variables are not added here. (Not read into
        # "line": that is the proot-distro login line, still needed below)
        if wm=$(session_wm_pid) && ! tr '\0' '\n' <"/proc/$wm/environ" 2>/dev/null | grep -q "^PREFIX=$PREFIX\$"; then
            while IFS= read -r kv; do e+=("$kv"); done < <(tr '\0' '\n' <"/proc/$wm/environ" 2>/dev/null |
                grep -E '^(DBUS_SESSION_BUS_ADDRESS|LANG|LANGUAGE|LC_[A-Z]+|XDG_RUNTIME_DIR)=')
        fi
        # A freedreno Vulkan driver in the container: the same zink variables Termux gets (CLI.md §5.2); without it
        # Mesa renders in software, which is what the variables would ask for anyway
        if [ -n "$root" ] && freedreno_icd "$root"; then
            e+=(ZINK_DESCRIPTORS=lazy MESA_GLTHREAD=true MESA_VK_WSI_PRESENT_MODE=fifo vblank_mode=0)
        fi
        # The user's .launch scripts get the environment exported; the proot-distro paths pass it explicitly too
        export PULSE_COOKIE=$PULSE_COOKIE_FILE "${e[@]}"
    fi

    # A TERM sent to the wrapper (the app stopping it, a terminal) goes to the program's process group
    forward_signal() {  # signal
        [ -n "${child:-}" ] || return 0
        kill -"$1" -- "-$child" 2>/dev/null || kill -"$1" "$child" 2>/dev/null
    }
    trap 'forward_signal TERM' TERM
    trap 'forward_signal INT' INT

    # One run of the program, as a child of the wrapper: its output is appended to xdesk.log and to this launch's log
    run_attempt() {  # 1 for the software-rendering retry
        local soft=${1:-0} c=$cmd t0 pfx pline deadline
        local -a args=()
        [ "$soft" = 1 ] && c="export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe; $c"
        before=$(wc -c <"$lp")
        t0=$SECONDS
        tee -a "$LOG" "$lp" <"$fifo" >/dev/null &
        teepid=$!
        if [ "$scope" = termux ]; then
            if [ "$term" = true ]; then
                ( exec setsid sh -c "$TERM_WRAP" "$c" ) >"$fifo" 2>&1 &
            else
                ( exec setsid sh -c "$c" ) >"$fifo" 2>&1 &
            fi
        elif [ -f "$SESSIONS/$scope.launch" ]; then
            # Written by the user for systems xdesk cannot enter itself (chroot): runs "$@" in that system
            ( exec setsid bash "$SESSIONS/$scope.launch" sh -c "$c" ) >"$fifo" 2>&1 &
        elif [ -f "$ENVS/$scope.launch" ]; then
            # The proot-distro shortcut only for the exact line xdesk setup writes; any other script of the user's
            # runs as a script that enters its system and runs "$@" there (CLI.md §5.4)
            pfx=$(launch_prefix "$ENVS/$scope.launch")
            if [ "$pfx" = "proot-distro login ${scope#proot-} --shared-tmp --" ] &&
                    head -1 "$ENVS/$scope.launch" 2>/dev/null | grep -qxF '# Runs "$@" in the container. Written by: xdesk setup'; then
                read -r -a args <<<"${pfx% --}"
                ( exec setsid "${args[@]}" -- env "${e[@]}" PULSE_COOKIE=/tmp/xdesk-pulse-cookie sh -c "$c" ) >"$fifo" 2>&1 &
            else
                ( exec setsid bash "$ENVS/$scope.launch" sh -c "$c" ) >"$fifo" 2>&1 &
            fi
        else
            pline=${line#"${line%%[![:space:]]*}"}
            pline=${pline#exec }
            pfx=${pline%% -- *}
            ( eval "set -- $pfx"; exec setsid "$@" -- env "${e[@]}" PULSE_COOKIE=/tmp/xdesk-pulse-cookie sh -c "$c" ) >"$fifo" 2>&1 &
        fi
        child=$!
        wait "$child"
        rc=$?
        # A program that left a child holding the pipe must not keep the wrapper (the pid the app follows) alive
        deadline=$((SECONDS + 1))
        while kill -0 "$teepid" 2>/dev/null && [ $SECONDS -lt $deadline ]; do sleep 0.02; done
        kill "$teepid" 2>/dev/null
        wait "$teepid" 2>/dev/null
        duration=$((SECONDS - t0))
        # Only what this attempt wrote: a quiet second attempt must not be judged by the first one's lines
        attempt=$(tail -c +$((before + 1)) "$lp" 2>/dev/null | tail -n 40)
    }

    run_attempt 0
    launch_classify "$rc" "$attempt"
    retried=""
    # One retry with software rendering: a quick failure with GPU features, not already software (CLI.md §5.2)
    if [ "$reason" = gpu ] && [ "$duration" -lt 10 ] && ! software_rendering; then
        retried=software
        # Said at once, not only when it ends: the app stops asking when the window appears, and the notice that the
        # program runs without the GPU belongs to that moment (running=1: not the end yet)
        printf 'running=1\nretried=software\n' >"$st.tmp" && mv -f "$st.tmp" "$st"
        run_attempt 1
        launch_classify "$rc" "$attempt"
    fi
    {
        printf 'exit=%s\n' "$rc"
        printf 'reason=%s\n' "$reason"
        printf 'detail=%s\n' "$detail"
        if [ -n "$retried" ]; then printf 'retried=%s\n' "$retried"; fi
    } >"$st.tmp" && mv -f "$st.tmp" "$st"
    rm -f "$fifo" "$RUN/launch/$$.pid" "$RUN/launch/$$.started"
    log "Launch $scope/$id: exit=$rc reason=$reason${detail:+ detail=$detail}${retried:+ retried=$retried}"
    # The last program and the last session are gone: the apps bus has nobody left to serve
    apps_bus_maybe_stop
    exit "$rc"
}

# The DPI the app worked out for the screen (DISPLAY.md §4.1). It goes to xdesk's own X server in memory only, see
# scale_resources: xrandr --dpi, plus Xft.dpi and Xcursor.size when the user has no value of their own in XFCE. The
# app asks through the X server once the desktop is connected and whenever the screen's size factors change, and a
# session start asks again for the session it starts; this runs after a session, so it never overrides the user's
# values. A job in the background waits for X (the session may still be starting); a newer request replaces an older
# one. $RUN/scale keeps the DPI asked for; other code reads it for the cursor size.
scale_later() {  # dpi
    local dpi=$1 token
    token="$dpi $$"
    echo "$token" >"$RUN/scale"
    (
        mine() { [ "$(cat "$RUN/scale" 2>/dev/null)" = "$token" ]; }
        # Missing, there is no way to tell X is up: one log line, and X keeps its DPI (start and sessions need it anyway)
        if ! command -v xrandr >/dev/null 2>&1; then
            log "scale $dpi: xrandr is not installed, X keeps its DPI (pkg install xorg-xrandr)"
            exit 0
        fi
        for _ in $(seq 20); do
            mine || exit 0
            x_is_ours && break
            sleep 0.5
        done
        mine || exit 0
        x_is_ours || { log "scale $dpi: no XDesk X server to size"; exit 0; }
        scale_resources "$dpi"
        log "X sized for $dpi dpi (in memory: Xft.dpi, Xcursor.size)"
    ) </dev/null >>"$LOG" 2>&1 9>&- &
}

list_apps() {
    local cat
    cat=$(apps_catalog "${1:-0}") || exit 1
    awk -F'\t' 'NR > 1 { printf "%-40s %s%s\n", $1, $2, ($3 == 1 ? " (terminal)" : "") }' "$cat"
}

# One scope's rows in the existing catalog. Doctor reads only: no rebuild, no icon work (CLI.md §3.3)
catalog_programs() {  # scope
    local cat=$APPS_CACHE/apps.tsv
    [ -s "$cat" ] || return 1
    awk -F'\t' -v p="$1/" 'index($1, p) == 1 { n++ } END { print n + 0 }' "$cat"
}

os_release_id() {  # root
    sed -n 's/^ID=//p' "$1/etc/os-release" 2>/dev/null | tr -d '"' | head -1
}

# Turnip is Mesa's freedreno Vulkan driver (CLI.md §5.2); without it Mesa renders in software
freedreno_icd() {  # root, empty for Termux
    if [ -z "${1:-}" ]; then
        ls "$PREFIX"/share/vulkan/icd.d/*freedreno* >/dev/null 2>&1
    else
        ls "$1"/usr/share/vulkan/icd.d/*freedreno* >/dev/null 2>&1
    fi
}

gpu_hint() {  # root, empty for Termux
    if [ -z "${1:-}" ]; then echo "pkg install mesa-vulkan-icd-freedreno"; return; fi
    case "$(os_release_id "$1")" in
    debian|ubuntu) echo "apt install mesa-vulkan-icd-freedreno" ;;
    *) echo "install Mesa's freedreno Vulkan driver (Turnip)" ;;
    esac
}

# The PulseAudio client library xdesk's proot programs need (CLI.md §5.3)
container_pulse_lib() {  # root
    local root=$1
    [ -e "$root/usr/lib/libpulse.so.0" ] || [ -L "$root/usr/lib/libpulse.so.0" ] ||
        [ -e "$root/usr/lib64/libpulse.so.0" ] || [ -L "$root/usr/lib64/libpulse.so.0" ] ||
        ls "$root"/usr/lib/*-linux-gnu/libpulse.so.0 >/dev/null 2>&1
}

pulse_package_hint() {  # root
    case "$(os_release_id "$1")" in
    debian|ubuntu) echo "apt install libpulse0" ;;
    arch) echo "pacman -S libpulse" ;;
    fedora) echo "dnf install pulseaudio-libs" ;;
    alpine) echo "apk add libpulse" ;;
    *) echo "install PulseAudio's client library" ;;
    esac
}

# The tag of the newest release of a line: stable is GitHub's latest release (never a pre-release), beta the newest of
# all, pre-release or not, so a beta user moves on to the release that follows it
release_tag() {  # stable|beta
    local url=https://api.github.com/repos/n2ray/xdesk/releases
    [ "$1" = stable ] && url=$url/latest || url="$url?per_page=1"
    curl -fsSL "$url" 2>/dev/null | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1 | grep .
}

# doctor's lines: ✓ fine, ! worth knowing, ✗ broken; any ✗ makes it exit 1
doctor_ok() { echo "✓ $*"; }
doctor_warn() { echo "! $*"; }
doctor_bad() { echo "✗ $*"; doctor_failed=1; }

# Checks the setup, one line per item, with the fix in the same line. Reads only: it never starts or stops anything,
# and it works without X (CLI.md §3.3)
doctor() {
    local xp xrun started started_h missing n sessions r launch progs desktops p
    doctor_failed=0

    doctor_ok "xdesk command: $XDESK_CLI_VERSION"
    if [ -f "$LOADER" ]; then
        doctor_ok "loader: $LOADER"
    else
        doctor_bad "loader: not found (fix: xdesk update, or install XDesk again)"
    fi
    if grep -qs '^allow-external-apps *= *true' "$HOME/.termux/termux.properties"; then
        doctor_ok "allow-external-apps: on"
    else
        doctor_bad "allow-external-apps: off, the app cannot use Termux (fix: xdesk enable-app-start)"
    fi
    missing=$(missing_tools)
    if [ -z "$missing" ]; then
        doctor_ok "commands: all present"
    else
        doctor_bad "commands: missing ${missing% } (fix: pkg install ${missing% })"
    fi
    if command -v pulseaudio >/dev/null 2>&1; then
        doctor_ok "pulseaudio: present"
    else
        doctor_warn "pulseaudio: not installed, no sound (fix: pkg install pulseaudio)"
    fi

    xp=$(x_server_pid)
    xrun=0
    x_is_ours && xrun=1
    if [ $xrun = 1 ]; then
        started=$(x_started "$xp" 2>/dev/null) || started=""
        if [ -n "$started" ]; then
            started_h=$(date -d "@$started" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$started")
            # Its base.apk deleted: an app update replaced it, and the server still runs the code from before. Not pm:
            # run as the Termux user it can hang
            if grep -q 'base\.apk (deleted)' "/proc/$xp/maps" 2>/dev/null; then
                doctor_warn "X server: running since $started_h, from before the app was updated (stop the desktop and start it again: xdesk stop; xdesk start)"
            else
                doctor_ok "X server: running on $DPY since $started_h"
            fi
        else
            doctor_warn "X server: running on $DPY, start time unknown (restart it to know when: xdesk stop; xdesk start)"
        fi
    elif x_up; then
        doctor_warn "X server: another X server answers on $DPY, not xdesk's (stop it first: xdesk start says so)"
    elif [ -n "$xp" ]; then
        doctor_bad "X server: pid $xp does not answer on $DPY (fix: xdesk stop, then xdesk start)"
    else
        doctor_warn "X server: not running (start a desktop: xdesk start)"
    fi
    if [ $xrun = 1 ] && [ -S "$PREFIX/tmp/.X11-unix/X${DPY#:}" ]; then
        doctor_ok "X socket: present"
    elif [ $xrun = 1 ]; then
        doctor_bad "X socket: missing while X runs (fix: xdesk stop, then xdesk start)"
    elif [ -e "$PREFIX/tmp/.X11-unix/X${DPY#:}" ]; then
        doctor_warn "X socket: a stale one, X is not running (xdesk start replaces it)"
    else
        doctor_warn "X socket: none, X is not running (it appears with xdesk start)"
    fi

    if command -v xfwm4 >/dev/null 2>&1; then
        doctor_ok "window manager: xfwm4 present"
    else
        doctor_bad "window manager: xfwm4 not installed, programs cannot open alone (fix: pkg install xfwm4 xfce4-settings)"
    fi
    if command -v fc-list >/dev/null 2>&1; then
        if [ -n "$(timeout 2 fc-list :lang=zh 2>/dev/null | head -1)" ]; then
            doctor_ok "Chinese fonts: present"
        else
            doctor_warn "Chinese fonts: none (fix: pkg install otf-noto-sans-cjk)"
        fi
    # fc-list is in fontconfig-utils, which few have: then the names of common CJK font files
    elif find "$PREFIX/share/fonts" "$HOME/.fonts" "$HOME/.local/share/fonts" -maxdepth 3 -type f 2>/dev/null |
            grep -qiE 'cjk|wqy|puhui|sarasa|lxgw|droidsansfallback|notosanssc|sourcehan'; then
        doctor_ok "Chinese fonts: present"
    else
        doctor_warn "Chinese fonts: none found (Chinese shows as boxes? pkg install otf-noto-sans-cjk)"
    fi
    while IFS=$'\t' read -r n _ _ sessions; do
        [ "$n" = "#xdesk-envs 1" ] && continue
        [ -n "$n" ] || continue
        desktops=0
        [ -n "$sessions" ] && desktops=$(printf '%s\n' "$sessions" | tr '/' '\n' | grep -c .)
        # The catalog this scope has now, if the app or XDesk has built one: doctor never builds it
        if progs=$(catalog_programs "$n"); then progs_txt="$progs programs"; else progs_txt="programs: not listed yet"; fi
        # Termux is native: no root and no entry command to check, only what it has
        if [ "$n" = termux ]; then
            doctor_ok "environment termux: $progs_txt, $desktops desktops"
            if freedreno_icd ""; then
                doctor_ok "environment termux: GPU: hardware (Turnip)"
            else
                doctor_warn "environment termux: GPU: software rendering (fix: $(gpu_hint ""))"
            fi
            continue
        fi
        r=$(session_root "$n")
        if [ -z "$r" ]; then
            doctor_warn "environment $n: no root directory (fix: xdesk add $n --root DIR --launch 'entry command')"
        elif [ ! -d "$r" ]; then
            doctor_bad "environment $n: root $r is missing (fix: xdesk rm $n, or add it again)"
        elif [ ! -r "$r" ]; then
            doctor_warn "environment $n: root $r is not readable for Termux ($progs_txt, $desktops desktops; fix: run xdesk from a root shell or move the root where Termux can read it)"
        else
            doctor_ok "environment $n: $r, $progs_txt, $desktops desktops"
            if freedreno_icd "$r"; then
                doctor_ok "environment $n: GPU: hardware (Turnip)"
            else
                doctor_warn "environment $n: GPU: software rendering (fix: $(gpu_hint "$r"))"
            fi
            if container_pulse_lib "$r"; then
                doctor_ok "environment $n: PulseAudio library present"
            else
                doctor_warn "environment $n: no PulseAudio library (fix: $(pulse_package_hint "$r"))"
            fi
        fi
        launch=$(env_launch_file "$n")
        if [ -n "$launch" ]; then
            if grep -q 'proot-distro' "$launch" 2>/dev/null && ! command -v proot-distro >/dev/null 2>&1; then
                doctor_bad "environment $n: proot-distro is not installed (fix: pkg install proot-distro)"
            fi
        elif grep -q 'proot-distro login' "$SESSIONS/$n.sh" 2>/dev/null; then
            command -v proot-distro >/dev/null 2>&1 ||
                doctor_bad "environment $n: proot-distro is not installed (fix: pkg install proot-distro)"
        else
            doctor_warn "environment $n: no entry command (fix: xdesk add $n --root DIR --launch 'entry command')"
        fi
    done < <(list_envs)

    # Only the state: an X input method is the user's own, and not having one is no error
    if ime_installed; then
        if p=$(ime_pid); then
            doctor_ok "fcitx5: running (pid $p, started by you or your session)"
        else
            doctor_warn "fcitx5: installed, not running (XDesk does not start it: start it in your session if you want it)"
        fi
    else
        doctor_warn "fcitx5: not installed (optional, your own choice: pkg install $IME_PACKAGES)"
    fi
    # chroot and proot scripts of other kinds cannot be found from here (CLI.md §3.4)
    doctor_warn "other proot or chroot systems: xdesk add NAME --root DIR --launch 'entry command'"
    [ $doctor_failed = 0 ] || return 1
}

usage() {
    cat <<'USAGE'
xdesk: run desktops and programs on the XDesk display, from Termux, proot or chroot.

  xdesk start [NAME]       start a session (default: the chosen one)
  xdesk stop               stop everything
  xdesk switch NAME        stop the running session and start another, keeping X and the window
  xdesk status             show what is running
  xdesk run CMD...         run any program on the display
  xdesk x                  start only the X server and audio
  xdesk apps [--refresh]   list the programs XDesk can open one by one
  xdesk launch ENV/ID      open one of them on the display, in its environment
  xdesk setup              look for desktops and environments in Termux and proot-distro
  xdesk list               list sessions
  xdesk add NAME ['CMD'] [--root DIR] [--launch 'PREFIX']
                           add a session, or without CMD an environment
  xdesk rm NAME            remove a session or an environment
  xdesk use NAME           choose the default session
  xdesk keyboard layout [NAME|auto]
                           the keyboard layout of XDesk's X server ("xdesk ime layout" works too)
  xdesk ime                whether an input method runs on the display (read-only; an X input method is yours)
  xdesk doctor             check the setup, one line per item
  xdesk version            print the xdesk command version
  xdesk update [beta|stable|VERSION]
                           update this command: the newest of its line, of a line, or one version
  xdesk help [all]         this list; "all" adds the commands only the app uses
USAGE
    [ "${1:-}" = all ] || return 0
    cat <<'USAGE_ALL'

The app's own commands (their names stay for older and newer apps):
  xdesk scale DPI          set this X server's DPI and cursor size, in memory (no XFCE settings)
  xdesk envs               list the environments with their sessions
  xdesk recover [NAME]     like start, unless xdesk stop ran
  xdesk enable-app-start   let the app's "start" button run commands in Termux
  xdesk apps --path        print the file of the app catalog
  xdesk launch --startup-id ID ENV/ID   open a program with that startup id
  xdesk app state          one JSON line with everything the app reads
  xdesk app catalog        the program list without icons, for the app before X runs
USAGE_ALL
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
x)
    need_tools
    lock; start_x && start_audio
    ;;
run)
    [ $# -gt 0 ] || { usage; exit 2; }
    need_tools
    lock; start_x && start_audio || exit 1
    wait_for_app
    exec 9>&-
    DISPLAY=$DPY PULSE_SERVER=127.0.0.1 PULSE_SINK=xdesk PULSE_COOKIE=$PULSE_COOKIE_FILE exec "$@"
    ;;
start)
    name=${1:-$(current)}
    [ -n "$name" ] || { echo "No default session. Run: xdesk setup"; exit 1; }
    valid_name "$name" || exit 2
    # Before X starts: an unknown name would leave a started X server behind for nothing
    session_file "$name" >/dev/null || { say "No session named $name (xdesk list shows them)"; exit 1; }
    need_tools
    clear_stopped
    lock; start_x && start_audio || exit 1
    wait_for_app
    start_session "$name"
    ;;
recover)
    [ -e "$RUN/stopped" ] && exit 0
    name=${1:-$(current)}
    [ -n "$name" ] || exit 1
    valid_name "$name" || exit 2
    session_file "$name" >/dev/null || { say "No session named $name (xdesk list shows them)"; exit 1; }
    need_tools
    lock; start_x && start_audio || exit 1
    wait_for_app
    start_session "$name"
    ;;
switch)
    [ $# -eq 1 ] || { usage; exit 2; }
    valid_name "$1" || exit 2
    # Checked before stopping anything: a typo must not end the running session
    session_file "$1" >/dev/null || { say "No session named $1 (xdesk list shows them)"; exit 1; }
    need_tools
    clear_stopped
    lock; start_x && start_audio || exit 1
    stop_session
    # The default stays the session itself: its "apps only" variant is how the app connects it
    start_session "$1" && echo "${1%+apps}" >"$CONF/current"
    ;;
stop)
    touch "$RUN/stopped"
    lock; stop_session
    # Every X server xdesk started, whatever display it names: one from the version before :9 still runs on :1
    stop_x_servers
    stop_apps_bus
    stop_audio
    am broadcast -a io.github.n2ray.xdesk.STOPPED -p "$APP" --es nonce "$(cat "$RUN/nonce" 2>/dev/null)" >/dev/null 2>&1
    say "Stopped"
    ;;
list) list ;;
help)
    [ $# -le 1 ] || { usage; exit 2; }
    case "${1:-}" in
    '') usage ;;
    all) usage all ;;
    *) usage; exit 2 ;;
    esac
    ;;
doctor) doctor || exit 1 ;;
version|--version|-V) echo "xdesk $XDESK_CLI_VERSION" ;;
update)
    [ $# -le 1 ] || { usage; exit 2; }
    # The release line (CLI.md §1): no argument follows the one this command is on, a beta (or dev) the newest of all,
    # a release the newest release; "beta" and "stable" switch lines; anything else is one version (the app passes its own)
    v=""
    channel=""
    case "${1:-}" in
    '') case "$XDESK_CLI_VERSION" in *-*|dev) channel=beta ;; *) channel=stable ;; esac ;;
    beta|stable) channel=$1 ;;
    v*) v=$1 ;;
    *) v=v$1 ;;
    esac
    if [ -n "$channel" ]; then
        v=$(release_tag "$channel") || { echo "Could not find a $channel release of n2ray/xdesk" >&2; exit 1; }
        echo "Newest $channel: $v"
    fi
    [[ $v =~ ^v[0-9][0-9A-Za-z.+-]*$ ]] || { echo "Invalid version: $v" >&2; exit 2; }
    tmp=$(mktemp -d) || exit 1
    trap 'rm -rf "${tmp:?}"' EXIT
    base="https://github.com/n2ray/xdesk/releases/download/$v"
    # The install script does the rest: it downloads this command and the loader, and checks them
    code=$(curl -sSL -o "$tmp/install.sh" -w '%{http_code}' "$base/install.sh") || {
        echo "Could not download $base/install.sh" >&2
        exit 1
    }
    if [ "$code" = 404 ]; then
        # No install.sh there: no such release (a test build, they are never published, or one not out yet), or a
        # release from before xdesk update existed. It said "too old" alone, also for a test build (2026-11-19)
        echo "No install.sh for $v on GitHub: a test build, not published yet, or older than xdesk update supports" >&2
        exit 1
    fi
    [ "$code" = 200 ] || { echo "Could not download $base/install.sh (HTTP $code)" >&2; exit 1; }
    code=$(curl -sSL -o "$tmp/SHA256SUMS" -w '%{http_code}' "$base/SHA256SUMS") || {
        echo "Could not download $base/SHA256SUMS" >&2
        exit 1
    }
    [ "$code" = 200 ] || { echo "Could not download $base/SHA256SUMS (HTTP $code)" >&2; exit 1; }
    # Only this release's own install script is run, and only when its line in SHA256SUMS matches
    ( cd "$tmp" && grep -E '  install\.sh$' SHA256SUMS >wanted && [ -s wanted ] ) || {
        echo "$v is older than xdesk update supports" >&2
        exit 1
    }
    if ! ( cd "$tmp" && sha256sum -c --quiet wanted ); then
        echo "install.sh does not match SHA256SUMS, nothing changed" >&2
        exit 1
    fi
    XDESK_CLI_ONLY=1 XDESK_VERSION="$v" bash "$tmp/install.sh"
    rc=$?
    rm -rf "$tmp"
    trap - EXIT
    exit $rc
    ;;
app)
    [ $# -eq 1 ] || { usage; exit 2; }
    case "$1" in
    state)
        # What was installed since the last read shows up in the app without an xdesk setup
        discover >/dev/null
        app_state
        ;;
    catalog)
        # The app's program list before any X has run (the X server gives it with icons): the catalog without its
        # icon column, a few KB that fit in what Termux passes back (CLI.md §3.1)
        discover >/dev/null
        f=$(apps_catalog 0) || exit 1
        awk -F'\t' -v OFS='\t' 'NR == 1 { print; next } { print $1, $2, $3, $4, "" }' "$f"
        ;;
    *) usage; exit 2 ;;
    esac
    ;;
add)
    [ $# -ge 1 ] || { usage; exit 2; }
    name=$1
    shift
    cmd=""
    # The command is optional: without one, only an environment is registered (CLI.md §3.1)
    if [ $# -gt 0 ]; then
        case "$1" in
        --root|--launch) ;;
        *) cmd=$1; shift ;;
        esac
    fi
    root=""; launch=""
    while [ $# -gt 0 ]; do
        case "$1" in
        --root)
            [ $# -ge 2 ] && [ -n "${2:-}" ] || { usage; exit 2; }
            root=$2; shift 2 ;;
        --launch)
            [ $# -ge 2 ] && [ -n "${2:-}" ] || { usage; exit 2; }
            launch=$2; shift 2 ;;
        *) usage; exit 2 ;;
        esac
    done
    case "$name" in *+apps) echo "Names ending in +apps are the apps only variant of a session"; exit 2 ;; esac
    # New names are plain file names: no spaces, quotes or control characters (CLI.md §4)
    valid_new_name "$name" || exit 2
    unignore "$name"
    [ -n "$cmd$root$launch" ] || { usage; exit 2; }
    if [ -n "$cmd" ]; then
        printf '%s\n' "exec $cmd" >"$SESSIONS/$name.sh"
        # The chroot files for its app catalog: NAME.root is its root directory, NAME.launch a script that runs
        # "$@" inside it (xdesk launch calls it as: bash NAME.launch sh -c 'CMD')
        if [ -n "$root" ]; then
            if [ ! -d "$root" ] || [ ! -r "$root" ]; then
                # /data/local and such need root: the Termux user cannot read them. Warn, but write anyway
                echo "  '$root' is not a readable directory for the Termux user (does it need root?). Wrote $name.root anyway."
            fi
            printf '%s\n' "$root" >"$SESSIONS/$name.root" && echo "  wrote $name.root"
        fi
        if [ -n "$launch" ]; then
            {
                printf '# Runs "$@" in the chroot. Written by: xdesk add %s --launch\n' "$name"
                printf 'exec %s "$@"\n' "$launch"
            } >"$SESSIONS/$name.launch" && echo "  wrote $name.launch"
        fi
        # Files of an earlier add are kept: the user may rely on them, so only say they are still there
        [ -z "$root" ] && [ -f "$SESSIONS/$name.root" ] && echo "  kept $name.root from before"
        [ -z "$launch" ] && [ -f "$SESSIONS/$name.launch" ] && echo "  kept $name.launch from before"
        [ -n "$(current)" ] || echo "$name" >"$CONF/current"
        list
    else
        # No session: the files of an environment, listed by xdesk envs and used to open its programs one by one
        if [ -n "$root" ]; then
            if [ ! -d "$root" ] || [ ! -r "$root" ]; then
                echo "  '$root' is not a readable directory for the Termux user (does it need root?). Wrote $name.root anyway."
            fi
            printf '%s\n' "$root" >"$ENVS/$name.root" && echo "  wrote envs/$name.root"
        fi
        if [ -n "$launch" ]; then
            {
                printf '# Runs "$@" in the chroot. Written by: xdesk add %s --launch\n' "$name"
                printf 'exec %s "$@"\n' "$launch"
            } >"$ENVS/$name.launch" && echo "  wrote envs/$name.launch"
        fi
        list_envs
    fi
    ;;
rm)
    [ $# -eq 1 ] || { usage; exit 2; }
    valid_name "$1" || exit 2
    # A name can be a session, an environment, or both: remove what is there. Nothing there is an error, and it is
    # not written to ignored (discovery then keeps finding whatever appears under that name)
    found=0
    for f in "$SESSIONS/$1.sh" "$SESSIONS/$1.root" "$SESSIONS/$1.launch" "$ENVS/$1.root" "$ENVS/$1.launch"; do
        [ -e "$f" ] && found=1
    done
    if [ $found = 0 ]; then
        say "No session or environment named $1"
        exit 1
    fi
    rm -f "${SESSIONS:?}/${1:?}.sh" "${SESSIONS:?}/${1:?}.root" "${SESSIONS:?}/${1:?}.launch"
    rm -f "${ENVS:?}/${1:?}.root" "${ENVS:?}/${1:?}.launch"
    # Not found again by the next app state: removed means gone until xdesk setup or xdesk add
    ignored "$1" || printf '%s\n' "$1" >>"$IGNORED"
    if [ "$(current)" = "$1" ]; then rm -f "${CONF:?}/current"; fi
    list
    ;;
use)
    [ $# -eq 1 ] || { usage; exit 2; }
    valid_name "$1" || exit 2
    session_file "$1" >/dev/null || { say "No session named $1 (xdesk list shows them)"; exit 1; }
    echo "$1" >"$CONF/current"
    list
    ;;
status)
    if x_is_ours; then echo "X server: running on $DPY"
    elif x_up; then echo "X server: $DPY is another X server, not XDesk's"
    else echo "X server: not running"
    fi
    # Started before XDesk was updated, it still runs the old APK's code, which the new app can't show (black)
    xp=$(x_pid)
    if [ -n "$xp" ] && grep -q 'base\.apk (deleted)' "/proc/$xp/maps" 2>/dev/null; then
        echo "X server build: older than the installed XDesk (updated since it started). Restart: xdesk stop; xdesk start"
    elif [ -n "$xp" ] && [ -r "/proc/$xp/maps" ]; then
        echo "X server build: the installed XDesk"
    fi
    x_is_ours && DISPLAY=$DPY timeout 2 xrandr 2>/dev/null | sed -n 's/.*\(current [0-9]* x [0-9]*\).*/Resolution: \1/p'
    if [ -n "$(session_pid)" ]; then echo "Session: $(cat "$RUN/session.name")"; else echo "Session: none"; fi
    echo "Default: $(current)"
    # CURSOR.md §2.4: the size XDesk gives X's cursor; the theme is the user's own and xdesk never sets it
    echo "Cursor size: $(cursor_size) px"
    # Read by the app: with an input method on the X side a keyboard on the phone types as keys (INPUT.md §5.2)
    if x_is_ours && imp=$(ime_pid); then echo "Input method: fcitx5 (pid $imp)"; else echo "Input method: none"; fi
    # Read by the app: the remembered X side keyboard layout (INPUT.md §5.2); "from X" without one
    if s=$(layout_setting) && [ -n "$s" ]; then echo "Keyboard layout: $s"; else echo "Keyboard layout: from X"; fi
    # Read by the app (CLI.md §1): the version of this command. Last line, so older parsers see what they know first
    echo "xdesk: $XDESK_CLI_VERSION"
    ;;
setup) setup ;;
envs) discover >/dev/null; list_envs ;;
apps)
    case "${1:-}" in
    --refresh) list_apps 1 ;;
    --path) apps_catalog 0 ;;
    '') list_apps 0 ;;
    *) usage; exit 2 ;;
    esac
    ;;
launch) launch_app "$@" ;;
ime)
    # Read-only: an X input method is the user's own. "layout" stays because the app calls it; the name users see
    # is "xdesk keyboard layout".
    case "${1:-status}" in
    status|'') ime_status ;;
    layout)
        [ $# -le 2 ] || { usage; exit 2; }
        keyboard_layout_cmd "${2:-}" || exit $?
        ;;
    *) usage; exit 2 ;;
    esac
    ;;
keyboard)
    [ "${1:-}" = layout ] || { usage; exit 2; }
    shift
    [ $# -le 1 ] || { usage; exit 2; }
    keyboard_layout_cmd "${1:-}" || exit $?
    ;;
discover)
    # install.sh runs this: find new desktops and environments, without clearing the user's ignored list (setup does)
    discover
    ;;
scale)
    [ $# -eq 1 ] && [[ $1 =~ ^[0-9]{2,4}$ ]] || { usage; exit 2; }
    scale_later "$1"
    ;;
enable-app-start)
    P=$HOME/.termux/termux.properties
    mkdir -p "$(dirname "$P")"; touch "$P"
    if ! grep -q '^allow-external-apps *= *true' "$P"; then
        sed -i 's/^# *allow-external-apps *=.*/allow-external-apps = true/' "$P"
        grep -q '^allow-external-apps *= *true' "$P" || echo 'allow-external-apps = true' >>"$P"
        termux-reload-settings 2>/dev/null || true
    fi
    echo "Apps with the Run commands permission can now start programs in Termux."
    ;;
*)
    usage
    [ -z "$cmd" ]
    ;;
esac
