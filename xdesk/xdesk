#!/data/data/com.termux/files/usr/bin/bash
# xdesk: run desktops and programs on the XDesk display, from Termux, proot or chroot.
# XDesk only provides the display, touchpad and audio. What runs on it is one command per "session".
#
#   xdesk x                  start only the X server and audio
#   xdesk run CMD...         run any program on the display
#   xdesk list               list sessions (found by "xdesk setup" or added by you)
#   xdesk add NAME 'CMD'     add a session, e.g. a chroot
#   xdesk rm NAME            remove a session
#   xdesk use NAME           choose the default session
#   xdesk start [NAME]       start a session (default: the chosen one)
#   xdesk switch NAME        stop the running session and start another, keeping X and the window
#   xdesk stop               stop everything
#   xdesk recover [NAME]     like start, unless you ran xdesk stop (the app does not use this)
#   xdesk status             show what is running
#   xdesk setup              look for desktops in Termux and proot-distro
#   xdesk enable-app-start   let the app's "start" button run commands in Termux
#   xdesk apps [--refresh]   list the programs XDesk can open one by one (from .desktop files)
#   xdesk launch SCOPE/ID    open one of them on the display, in its session (Termux, proot or chroot)
#   NAME+apps                as a session name (start, switch, use): only X, xfwm4 and xfsettingsd, no panel or desktop
set -u
APP=io.github.n2ray.xdesk.x11
DPY=:1
AUDIO_PORT=47130   # only for removing what an older xdesk loaded
# Private to Termux, unlike a port on 127.0.0.1, which every app on the phone can reach
AUDIO_SOCK=$PREFIX/tmp/xdesk-audio
# The PulseAudio cookie where proot (/tmp, with --shared-tmp) and chroot clients can read it. Inside Termux's own
# directory, so readable for a chroot's user does not mean for other apps
PULSE_COOKIE_FILE=$PREFIX/tmp/xdesk-pulse-cookie
DEFAULT_RES='1280 x 1024'    # what X reports before the app has connected
CONF=$HOME/.config/xdesk
SESSIONS=$CONF/sessions
RUN=$PREFIX/tmp/xdesk
LOG=$PREFIX/tmp/xdesk.log
LOADER=$HOME/.local/libexec/xdesk/loader.apk
LOG_MAX=2097152              # xdesk.log is rotated to xdesk.log.1 beyond this many bytes
# Scripts with #!/bin/... only run through termux-exec, and RUN_COMMAND starts us without it
TERMUX_EXEC=$PREFIX/lib/libtermux-exec-ld-preload.so
if [ -z "${LD_PRELOAD:-}" ] && [ -f "$TERMUX_EXEC" ]; then export LD_PRELOAD=$TERMUX_EXEC; fi
# RUN_COMMAND also starts us at nice 0. Chromium then runs its renderer at -8, above the X server,
# and video drops frames. Only change the default, not a chosen value.
if [ "$(ps -o ni= -p $$ | tr -d ' ')" = 0 ]; then renice -n -10 -p $$ >/dev/null 2>&1; fi
mkdir -p "$SESSIONS" "$RUN"
# XDesk passes a nonce when it runs us; xdesk stop sends it back, so the app can tell its STOPPED
# broadcast from one any other app could send. Other apps cannot read $RUN.
if [ -n "${XDESK_NONCE:-}" ]; then printf '%s\n' "$XDESK_NONCE" >"$RUN/nonce"; unset XDESK_NONCE; fi

# The X server and the sessions keep the log open for appending, so it is copied and truncated in
# place: renaming it would leave them writing to the old file.
if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt "$LOG_MAX" ]; then
    cp -f "$LOG" "$LOG.1" 2>/dev/null && : >"$LOG"
fi

log() { echo "$(date +%T) $*" >>"$LOG"; }
say() { echo "$*"; log "$*"; }
x_up() { DISPLAY=$DPY timeout 2 xrandr >/dev/null 2>&1; }
x_pid() { pgrep -f '^xdesk-x11 ' | head -1; }

# Whatever holds the X lock file of our display is still alive (another X server, or ours under
# a name pgrep does not know).
x_lock_alive() {
    local p c f=$PREFIX/tmp/.X${DPY#:}-lock
    [ -f "$f" ] || return 1
    p=$(tr -d ' ' <"$f" 2>/dev/null)
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null || return 1
    # A lock left behind whose pid now belongs to something else: only an X server counts (unreadable: assume it is one)
    c=$(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null)
    case "$c" in ""|*termux-x11*|*xdesk-x11*|*com.termux.x11*|*Xorg*|*Xvfb*|*Xwayland*) return 0 ;; esac
    return 1
}

# Commands the X and session commands need, with the Termux package that has them
need_tools() {
    local pair missing=""
    for pair in xrandr:xorg-xrandr flock:util-linux setsid:util-linux timeout:coreutils \
                seq:coreutils pgrep:procps pkill:procps ps:procps; do
        command -v "${pair%%:*}" >/dev/null 2>&1 || missing="$missing ${pair##*:}"
    done
    [ -z "$missing" ] && return 0
    # shellcheck disable=SC2086
    missing=$(printf '%s\n' $missing | sort -u | tr '\n' ' ')
    say "Missing commands. Install them with: pkg install ${missing% }"
    exit 1
}

# Session names become file names
valid_name() {
    case "$1" in
    ''|*/*|.*|-*) echo "Invalid session name: '$1'"; return 1 ;;
    esac
}

ensure_loader() {
    [ -f "$LOADER" ] && return 0
    say "Loader not found: $LOADER. Install XDesk again: curl -fsSL https://raw.githubusercontent.com/n2ray/xdesk/xdesk/xdesk/install.sh | bash"
    return 1
}

# Extra environment for the X server only, from $CONF/x11-env into the array xenv: one NAME=value
# per line; "export " and one pair of quotes around the value are allowed, # starts a comment.
read_x11_env() {
    local line name value
    xenv=()
    [ -f "$CONF/x11-env" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%$'\r'}
        line=${line#"${line%%[![:space:]]*}"}
        case "$line" in ''|'#'*) continue ;; esac
        line=${line#export }
        if ! [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
            log "x11-env: ignored line: $line"
            continue
        fi
        name=${line%%=*}
        value=${line#*=}
        case "$value" in
        \"*\"|\'*\') [ ${#value} -ge 2 ] && value=${value:1:${#value}-2} ;;
        esac
        xenv+=("$name=$value")
    done <"$CONF/x11-env"
    [ ${#xenv[@]} -gt 0 ] && log "X server environment from $CONF/x11-env: ${xenv[*]}"
    return 0
}

# Keep the lock for setup only: background processes must not inherit fd 9 or it is never released
lock() {
    exec 9>"$RUN/session.lock"
    flock -w 60 9 || { say "Timed out waiting for another xdesk command"; exit 1; }
}

start_x() {
    local up=0 p
    x_up && up=1
    p=$(x_pid)
    if [ -n "$p" ]; then
        [ $up = 1 ] && return 0
        # Ours but not answering (still starting, or busy): never remove its socket and start a
        # second one, wait for it instead.
        for _ in $(seq 20); do
            x_up && return 0
            sleep 0.5
        done
        say "The X server (pid $p) is running but does not answer on $DPY. Run: xdesk stop, then start again."
        return 1
    fi
    if [ $up = 1 ] || x_lock_alive; then
        say "Display $DPY is used by another X server (official Termux:X11?). Stop it first."
        return 1
    fi
    ensure_loader || return 1
    rm -f "${PREFIX:?}/tmp/.X11-unix/X${DPY#:}" "${PREFIX:?}/tmp/.X${DPY#:}-lock"
    # Same environment handling as the official termux-x11 launcher
    [ -z "${LD_LIBRARY_PATH+x}" ] || export XSTARTUP_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
    [ -z "${LD_PRELOAD+x}" ] || export XSTARTUP_LD_PRELOAD="$LD_PRELOAD"
    # Extra environment for the X server only (e.g. TERMUX_X11_* debug switches). The app starts us
    # through RUN_COMMAND, so a shell's env never gets here.
    local xenv
    read_x11_env
    # XDESK_CLI: the X server runs this same script for the app (xdesk apps, xdesk launch), see XWindows.java
    env -u LD_PRELOAD -u LD_LIBRARY_PATH "${xenv[@]}" XDESK_AUDIO_SOCKET="$AUDIO_SOCK" XDESK_CLI="$(realpath "$0" 2>/dev/null || echo "$0")" CLASSPATH="$LOADER" setsid nohup /system/bin/app_process \
        -Xnoimage-dex2oat / --nice-name="xdesk-x11 $DPY" com.termux.x11.Loader "$DPY" -ac \
        </dev/null >>"$LOG" 2>&1 9>&- &
    for _ in $(seq 40); do
        x_up && return 0
        sleep 0.5
    done
    say "X server did not start, see $LOG"
    return 1
}

start_audio() {
    # Desktop audio goes to a null sink, the app reads it from a local port and picks the output device
    timeout 5 pulseaudio --start --exit-idle-time=-1 </dev/null 9>&- 2>/dev/null
    unset PULSE_SERVER PULSE_COOKIE   # the local daemon, whatever this shell has set
    # Clients in proot or a chroot come in over TCP, so it needs the cookie: any app on the phone can reach 127.0.0.1.
    # The file below brings back the old way, without one, for setups that cannot pass PULSE_COOKIE
    local p="timeout 3 pactl" args="listen=127.0.0.1 auth-cookie-enabled=1 auth-anonymous=0" id
    [ -e "$CONF/pulse-anonymous" ] && args="auth-ip-acl=127.0.0.1 auth-anonymous=1"
    for _ in $(seq 10); do $p info >/dev/null 2>&1 && break; sleep 0.5; done
    # A daemon still running from an older xdesk or another script keeps its open port otherwise
    $p list short modules 2>/dev/null | awk -F'\t' -v want="$args" -v port="port=$AUDIO_PORT" \
        '($2 == "module-native-protocol-tcp" && $3 != want) || ($2 == "module-simple-protocol-tcp" && index($3, port)) { print $1 }' |
        while read -r id; do $p unload-module "$id"; done
    $p list short modules 2>/dev/null | grep -q 'module-native-protocol-tcp' || \
        timeout 3 pacmd load-module module-native-protocol-tcp $args >/dev/null 2>&1
    cp -f "$HOME/.config/pulse/cookie" "$PULSE_COOKIE_FILE" 2>/dev/null && chmod 644 "$PULSE_COOKIE_FILE"
    export PULSE_SERVER=127.0.0.1 PULSE_COOKIE=$PULSE_COOKIE_FILE
    for _ in $(seq 10); do $p info >/dev/null 2>&1 && break; sleep 0.5; done
    $p info >/dev/null 2>&1 || { log "PulseAudio not reachable, no audio"; return 0; }
    $p list short sinks | grep -q '^[0-9]*[[:space:]]xdesk[[:space:]]' || \
        $p load-module module-null-sink sink_name=xdesk rate=48000 channels=2 >/dev/null
    # The app gets a connection to this from the X server (ICmdEntryInterface.getAudioConnection)
    $p list short modules | grep -q "module-simple-protocol-unix.*socket=$AUDIO_SOCK" || \
        $p load-module module-simple-protocol-unix socket="$AUDIO_SOCK" source=xdesk.monitor \
            record=true playback=false format=s16le rate=48000 channels=2 >/dev/null
    $p set-default-sink xdesk
    $p list short sink-inputs | cut -f1 | while read -r id; do $p move-sink-input "$id" xdesk; done
}

# The desktop keeps a wrong size for its wallpaper if it starts before the app has set the resolution
wait_for_app() {
    for _ in $(seq 16); do
        DISPLAY=$DPY timeout 2 xrandr 2>/dev/null | grep -q "current $DEFAULT_RES," || return 0
        sleep 0.5
    done
    say "XDesk has not connected yet. Open the app, the desktop may need a restart to fit the screen."
}

session_pid() {
    local p
    p=$(cat "$RUN/session.pid" 2>/dev/null) || return 1
    kill -0 "$p" 2>/dev/null && echo "$p"
}

current() { cat "$CONF/current" 2>/dev/null; }

# Sessions written before PulseAudio needed a cookie. proot-distro login clears the environment, so it goes on that line
migrate_session() {
    grep -q 'PULSE_COOKIE' "$1" && return 0
    if grep -q -- '--shared-tmp -- env .*PULSE_SERVER=127.0.0.1 ' "$1"; then
        sed -i 's|\(--shared-tmp -- env .*PULSE_SERVER=127.0.0.1 \)|\1PULSE_COOKIE=/tmp/xdesk-pulse-cookie |' "$1"
    elif grep -q 'chroot\|proot' "$1" && [ ! -e "$CONF/pulse-anonymous" ]; then
        log "Session $(basename "$1") may have no sound: pass PULSE_COOKIE (the file $PULSE_COOKIE_FILE) to its clients, see the README"
    fi
}

start_session() {
    local name=$1 f
    f=$(session_file "$name") || { say "No session named '$name'. Try: xdesk list"; return 1; }
    if [ -n "$(session_pid)" ]; then
        echo "Session $(cat "$RUN/session.name") is already running"
        return 0
    fi
    migrate_session "$f"
    if [ "$name" != "${name%+apps}" ]; then
        f=$(apps_only_script "$f") || { say "Session ${name%+apps} has no XFCE to start without its desktop"; return 1; }
    fi
    DISPLAY=$DPY PULSE_SERVER=127.0.0.1 PULSE_COOKIE=$PULSE_COOKIE_FILE setsid nohup bash "$f" </dev/null >>"$LOG" 2>&1 9>&- &
    echo $! >"$RUN/session.pid"
    echo "$name" >"$RUN/session.name"
    say "Started session $name"
}

clear_stopped() { [ ! -e "$RUN/stopped" ] || rm -f "${RUN:?}/stopped"; }

clear_session_state() {
    rm -f "${RUN:?}/session.pid" "${RUN:?}/session.name"
}

stop_session() {
    local p
    p=$(session_pid) || { clear_session_state; return 0; }
    DISPLAY=$DPY timeout 5 xfce4-session-logout --logout >/dev/null 2>&1
    for _ in $(seq 8); do kill -0 "$p" 2>/dev/null || break; sleep 1; done
    kill -- "-$p" 2>/dev/null
    sleep 1
    kill -9 -- "-$p" 2>/dev/null
    clear_session_state
    log "Session stopped"
}

write_session() {  # name, command; never overwrites an existing one
    local f=$SESSIONS/$1.sh
    [ -e "$f" ] && return 1
    printf '%s\n' "$2" >"$f"
    echo "  found $1"
}


termux_env() {  # export lines for programs on the display in Termux
    local lang
    # Menus follow the phone's language. LC_ALL is left alone, Termux sets it for the terminal
    lang=$(getprop persist.sys.locale 2>/dev/null | tr - _)
    [ -n "$lang" ] && echo "export LANGUAGE=$lang"
    # zink + Turnip on Adreno. Other GPUs: edit this file
    ls "$PREFIX"/share/vulkan/icd.d/*freedreno* >/dev/null 2>&1 && echo "export MESA_LOADER_DRIVER_OVERRIDE=zink ZINK_DESCRIPTORS=lazy MESA_GLTHREAD=true MESA_VK_WSI_PRESENT_MODE=fifo vblank_mode=0"
    return 0
}

termux_session() {  # command that starts the desktop
    local env
    env=$(termux_env)
    [ -n "$env" ] && env="$env
"
    printf '%sexec dbus-run-session %s\n' "$env" "$1"
}

setup() {
    echo "Looking for desktops..."
    local de bin name distro root
    for de in xfce:startxfce4 lxqt:startlxqt mate:mate-session; do
        name=${de%%:*}; bin=${de##*:}
        if command -v "$bin" >/dev/null; then
            write_session "termux-$name" "$(termux_session "$bin")"
        fi
    done
    for root in "$PREFIX"/var/lib/proot-distro/containers/*/rootfs "$PREFIX"/var/lib/proot-distro/installed-rootfs/*; do
        [ -d "$root" ] || continue
        distro=$(basename "$(echo "$root" | sed 's|/rootfs$||')")
        for de in xfce:startxfce4 lxqt:startlxqt mate:mate-session; do
            name=${de%%:*}; bin=${de##*:}
            if [ -e "$root/usr/bin/$bin" ]; then
                write_session "proot-$distro-$name" \
                    "exec proot-distro login $distro --shared-tmp -- env DISPLAY=$DPY PULSE_SERVER=127.0.0.1 PULSE_COOKIE=/tmp/xdesk-pulse-cookie dbus-launch --exit-with-session $bin"
            fi
        done
    done
    if [ -z "$(current)" ]; then
        name=$(ls "$SESSIONS" 2>/dev/null | head -1)
        [ -n "$name" ] && echo "${name%.sh}" >"$CONF/current"
    fi
    list
}

list() {
    local f n c
    c=$(current)
    for f in "$SESSIONS"/*.sh; do
        [ -e "$f" ] || { echo "No sessions yet. Run: xdesk setup, or xdesk add NAME 'CMD'"; return 0; }
        n=$(basename "$f" .sh)
        if [ "$n" = "$c" ]; then echo "* $n"; else echo "  $n"; fi
    done
}

# --- Programs as apps (DISPLAY.md §1.2, §1.5) ---
# Each .desktop entry is an app the XDesk app can list and open on its own, keyed "SCOPE/ID": SCOPE is
# "termux" for Termux's own programs, or the name of a session whose system has its own root (proot-distro,
# or a NAME.root file next to NAME.sh), ID the desktop file id.

APPS_CACHE=$HOME/.cache/xdesk
APPS_FORMAT=1   # bump when the catalog's columns or the icons change
ICON_PX=64

# The file of a session, also for its "apps only" variant NAME+apps: X, xfwm4 and xfsettingsd, no panel or desktop
session_file() {
    local f=$SESSIONS/${1%+apps}.sh
    [ -f "$f" ] && echo "$f"
}

# The session script with XFCE's start command replaced by the window manager and settings daemon alone
apps_only_script() {
    local out=$RUN/apps-session.sh
    grep -qE '(^|[[:space:]])(startxfce4|xfce4-session)([[:space:]]|$)' "$1" || return 1
    sed -E "s/(^|[[:space:]])(startxfce4|xfce4-session)([[:space:]]|\$)/\\1sh -c 'xfsettingsd \\& exec xfwm4'\\3/" "$1" >"$out" || return 1
    echo "$out"
}

# The root directory of a session's system, empty for one that runs in Termux itself
session_root() {
    local f=$SESSIONS/$1.sh d r
    if [ -f "$SESSIONS/$1.root" ]; then
        head -1 "$SESSIONS/$1.root"
        return 0
    fi
    d=$(sed -n 's/.*proot-distro login[[:space:]]\{1,\}\(.*\)/\1/p' "$f" 2>/dev/null | head -1 |
        tr -s ' \t' '\n\n' | grep -v '^-' | head -1)
    [ -n "$d" ] || return 0
    for r in "$PREFIX/var/lib/proot-distro/installed-rootfs/$d" "$PREFIX/var/lib/proot-distro/containers/$d/rootfs"; do
        [ -d "$r/usr" ] && { echo "$r"; return 0; }
    done
}

# Scopes with programs, one per line: "termux" and every session with a root of its own
app_scopes() {
    local f n
    echo termux
    for f in "$SESSIONS"/*.sh; do
        [ -e "$f" ] || continue
        n=$(basename "$f" .sh)
        [ -n "$(session_root "$n")" ] && echo "$n"
    done
    return 0
}

app_dirs() {  # scope: application directories, most important first
    local r
    if [ "$1" = termux ]; then
        echo "$HOME/.local/share/applications"
        echo "$PREFIX/share/applications"
    else
        r=$(session_root "$1")
        [ -n "$r" ] || return 0
        echo "$r/root/.local/share/applications"
        echo "$r/usr/local/share/applications"
        echo "$r/usr/share/applications"
    fi
}

app_locale() {
    local l=${LANGUAGE:-}
    l=${l%%:*}
    [ -n "$l" ] || l=$(getprop persist.sys.locale 2>/dev/null | tr - _)
    [ -n "$l" ] || { l=${LANG:-}; l=${l%%.*}; }
    echo "$l"
}

# One row per desktop file: path, then the [Desktop Entry] keys the catalog uses, separated by \037 (a tab
# would merge empty fields in read). Tabs in values become spaces
desktop_rows() {  # locale, files...
    local loc=$1
    shift
    [ $# -gt 0 ] || return 0
    awk -v loc="$loc" -v S=$'\037' '
        function flush(   name, lang) {
            if (f == "") return
            lang = loc; sub(/_.*/, "", lang)
            name = v["Name[" loc "]"]
            if (name == "") name = v["Name[" lang "]"]
            if (name == "") name = v["Name"]
            print f S v["Type"] S name S v["NoDisplay"] S v["Hidden"] S v["Terminal"] S v["TryExec"] S v["Icon"] S v["StartupWMClass"] S v["OnlyShowIn"] S v["NotShowIn"] S v["Exec"] S v["Path"]
        }
        FNR == 1 { flush(); f = FILENAME; grp = 0; split("", v) }
        /^\[/ { grp = ($0 == "[Desktop Entry]"); next }
        grp && /^[^#]/ {
            i = index($0, "=")
            if (!i) next
            k = substr($0, 1, i - 1); sub(/[ \t]+$/, "", k)
            val = substr($0, i + 1); sub(/^[ \t]+/, "", val); gsub(/\t/, " ", val)
            if (!(k in v)) v[k] = val
        }
        END { flush() }' "$@" 2>/dev/null
}

# Desktop files of a scope, as "ID<TAB>path"; an ID found in an earlier directory hides later ones
desktop_files() {
    local d f id seen=" "
    while IFS= read -r d; do
        [ -d "$d" ] || continue
        for f in "$d"/*.desktop "$d"/*/*.desktop; do
            [ -f "$f" ] || continue
            id=${f#"$d"/}
            id=${id%.desktop}
            id=${id//\//-}
            case "$seen" in *" $id "*) continue ;; esac
            seen="$seen$id "
            printf '%s\t%s\n' "$id" "$f"
        done
    done < <(app_dirs "$1")
}

icon_theme() {
    sed -n 's/.*name="IconThemeName"[^>]*value="\([^"]*\)".*/\1/p' \
        "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml" 2>/dev/null | head -1
}

# The file for an Icon= value: a path as it is, else a name looked up in the icon themes, then pixmaps
find_icon() {  # scope root ("" for Termux), theme, icon
    local root=$1 theme=$2 icon=$3 base t s e f
    case "$icon" in
    "") return 1 ;;
    /*) f=$root$icon; [ -f "$f" ] && echo "$f" && return 0; return 1 ;;
    esac
    icon=${icon%.png}; icon=${icon%.svg}; icon=${icon%.xpm}
    local -a bases
    if [ -z "$root" ]; then
        bases=("$HOME/.local/share/icons" "$HOME/.icons" "$PREFIX/share/icons")
    else
        bases=("$root/usr/local/share/icons" "$root/usr/share/icons")
    fi
    # Usually SIZE/apps; then any context (SIZE/actions, ...) and the other layout, CONTEXT/SIZE
    local pat
    for pat in '$s/apps' '$s/*' '*/$s'; do
        for t in ${theme:+"$theme"} hicolor Adwaita AdwaitaLegacy breeze gnome; do
            for base in "${bases[@]}"; do
                [ -d "$base/$t" ] || continue
                for s in 64x64 64 96x96 128x128 48x48 48 scalable 256x256 512x512 32x32; do
                    for e in png svg; do
                        for f in "$base/$t/"${pat//\$s/$s}"/$icon.$e"; do
                            [ -f "$f" ] && { echo "$f"; return 0; }
                        done
                    done
                done
            done
        done
    done
    for base in ${root:+"$root/usr/share/pixmaps"} "${root:-$PREFIX}/share/pixmaps"; do
        for e in png svg xpm; do
            f=$base/$icon.$e
            [ -f "$f" ] && { echo "$f"; return 0; }
        done
    done
    return 1
}

# A small PNG of an icon file, base64 on one line; nothing when it cannot be made. Converted icons are kept
icon_png64() {
    local src=$1 out
    out=$APPS_CACHE/icons/$(printf '%s' "$src" | cksum | cut -d' ' -f1).png
    if [ ! -s "$out" ] || [ "$src" -nt "$out" ]; then
        case "$src" in
        *.svg|*.svgz)
            command -v rsvg-convert >/dev/null || return 0
            rsvg-convert -w $ICON_PX -h $ICON_PX -a -f png -o "$out" "$src" 2>/dev/null || { rm -f "$out"; return 0; }
            ;;
        */64x64/*|*/64/*|*/48x48/*|*/48/*|*/96x96/*|*/32x32/*)
            out=$src ;;
        *)
            if command -v magick >/dev/null; then
                magick "$src" -resize ${ICON_PX}x${ICON_PX} "png:$out" 2>/dev/null || { rm -f "$out"; return 0; }
            else
                case "$src" in *.png) out=$src ;; *) return 0 ;; esac
            fi
            ;;
        esac
    fi
    base64 -w0 "$out" 2>/dev/null
}

# Whatever changes the catalog: the directories (installing a program adds a file), the language, the theme
apps_signature() {
    local s d
    echo "format $APPS_FORMAT $ICON_PX $(app_locale) $(icon_theme)"
    stat -c '%n %Y' "$SESSIONS" "$SESSIONS"/*.root 2>/dev/null
    while IFS= read -r s; do
        while IFS= read -r d; do
            stat -c '%n %Y' "$d" "$d"/*/ 2>/dev/null
        done < <(app_dirs "$s")
    done < <(app_scopes)
}

tryexec_ok() {  # root, program
    local root=$1 p=$2 d
    [ -n "$p" ] || return 0
    if [ -z "$root" ]; then
        command -v "$p" >/dev/null 2>&1
        return
    fi
    case "$p" in /*) [ -e "$root$p" ]; return ;; esac
    for d in /usr/local/bin /usr/bin /bin /usr/games; do [ -e "$root$d/$p" ] && return 0; done
    return 1
}

# The catalog: a header line, then KEY, name, terminal (0/1), StartupWMClass, icon (base64 PNG or empty)
build_catalog() {
    local out=$1 loc theme scope root id path rows
    local file type name nodisp hidden term tryexec icon wmclass only notshow exe wd ic
    loc=$(app_locale)
    theme=$(icon_theme)
    mkdir -p "$APPS_CACHE/icons"
    {
        echo "#xdesk-apps $APPS_FORMAT"
        while IFS= read -r scope; do
            root=""
            [ "$scope" = termux ] || root=$(session_root "$scope")
            declare -A ids=()
            local -a files=()
            while IFS=$'\t' read -r id path; do
                ids[$path]=$id
                files+=("$path")
            done < <(desktop_files "$scope")
            while IFS=$'\037' read -r file type name nodisp hidden term tryexec icon wmclass only notshow exe wd; do
                [ "$type" = Application ] && [ -n "$name" ] && [ -n "$exe" ] || continue
                [ "$nodisp" = true ] || [ "$hidden" = true ] && continue
                if [ -n "$only" ]; then case ";$only;" in *";XFCE;"*) ;; *) continue ;; esac; fi
                case ";$notshow;" in *";XFCE;"*) continue ;; esac
                tryexec_ok "$root" "$tryexec" || continue
                ic=""
                icon=$(find_icon "$root" "$theme" "$icon") && ic=$(icon_png64 "$icon")
                [ "$term" = true ] && term=1 || term=0
                printf '%s/%s\t%s\t%s\t%s\t%s\n' "$scope" "${ids[$file]}" "$name" "$term" "$wmclass" "$ic"
            done < <(desktop_rows "$loc" "${files[@]}")
            unset ids
        done < <(app_scopes)
    } >"$out.tmp" && mv -f "$out.tmp" "$out"
}

# Makes the catalog when anything it depends on changed. Prints its path
apps_catalog() {
    local cat=$APPS_CACHE/apps.tsv sig
    mkdir -p "$APPS_CACHE"
    sig=$(apps_signature)
    if [ "$1" = 1 ] || [ ! -s "$cat" ] || [ "$sig" != "$(cat "$APPS_CACHE/apps.sig" 2>/dev/null)" ]; then
        build_catalog "$cat" || return 1
        printf '%s\n' "$sig" >"$APPS_CACHE/apps.sig"
        log "App catalog rebuilt: $(($(wc -l <"$cat") - 1)) apps"
    fi
    echo "$cat"
}

# For sh -c '...': one word in single quotes
sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# The Exec= value as a shell command: string escapes undone, field codes (%f %U ...) dropped, %% kept as %
exec_command() {
    local e=$1
    e=${e//\\\\/$'\001'}
    e=${e//\\s/ }; e=${e//\\t/$'\t'}; e=${e//\\n/ }; e=${e//\\r/}
    e=${e//$'\001'/\\}
    e=${e//%%/$'\002'}
    e=${e//%[fFuUdDnNvmick]/}
    e=${e//$'\002'/%}
    echo "$e"
}

# The environment of the session's window manager, if it runs in Termux itself: its D-Bus, language, GPU settings
session_wm_pid() {
    local p
    for p in $(pgrep -x xfwm4 2>/dev/null); do
        tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | grep -qx "DISPLAY=$DPY" && { echo "$p"; return 0; }
    done
    return 1
}

import_env() {  # pid
    local kv n
    while IFS= read -r -d '' kv; do
        n=${kv%%=*}
        case "$n" in PWD|OLDPWD|SHLVL|_|DESKTOP_STARTUP_ID|LD_PRELOAD|LD_LIBRARY_PATH|CLASSPATH|XDESK_*) continue ;; esac
        [[ $n =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && export "$kv"
    done <"/proc/$1/environ"
}

# A terminal for Terminal=true programs, chosen where the program runs. $0 is the command
TERM_WRAP='for t in xfce4-terminal x-terminal-emulator xterm; do command -v $t >/dev/null 2>&1 && break; done
if [ "$t" = xfce4-terminal ]; then exec $t -x sh -c "$0"; else exec $t -e sh -c "$0"; fi'

launch_app() {
    local sid="" key scope id file row cmd root prefix wm line
    while [ $# -gt 0 ]; do
        case "$1" in
        --startup-id) sid=${2:-}; shift 2 ;;
        --) shift; break ;;
        -*) usage; exit 2 ;;
        *) break ;;
        esac
    done
    key=${1:-}
    [ -n "$key" ] || { usage; exit 2; }
    case "$key" in
    */*) scope=${key%%/*}; id=${key#*/} ;;
    *) scope=""; id=$key ;;
    esac
    case "$scope$id" in *..*|*/*|'') say "Invalid app: $key"; exit 2 ;; esac
    for s in ${scope:-$(app_scopes)}; do
        file=$(desktop_files "$s" | awk -F'\t' -v id="$id" '$1 == id { print $2; exit }')
        [ -n "$file" ] && { scope=$s; break; }
    done
    [ -n "$file" ] || { say "No app $key. Try: xdesk apps"; exit 1; }
    row=$(desktop_rows "" "$file")
    IFS=$'\037' read -r _ _ _ _ _ term _ _ _ _ _ cmd wd <<<"$row"
    cmd=$(exec_command "$cmd")
    [ -n "$cmd" ] || { say "App $key has no command"; exit 1; }
    cmd="exec $cmd"
    [ -n "$wd" ] && cmd="cd $(sq "$wd") 2>/dev/null; $cmd"
    if ! x_up; then
        need_tools
        lock; start_x && start_audio || exit 1
        exec 9>&-
    fi
    # Who asks (the X server for the app) learns which process to follow, before everything goes to the log
    echo "pid $$"
    log "Launching $scope/$id: $cmd"
    exec </dev/null >>"$LOG" 2>&1
    [ -n "$sid" ] || sid="xdesk-$id-$$_TIME0"
    # The X server runs on half the cores, and what it starts would inherit that
    command -v taskset >/dev/null && taskset -p "$(printf '%x' $(( (1 << $(nproc --all)) - 1 )))" $$ >/dev/null 2>&1
    unset CLASSPATH XDESK_AUDIO_SOCKET XDESK_CLI
    if [ "$scope" = termux ]; then
        if wm=$(session_wm_pid) && tr '\0' '\n' <"/proc/$wm/environ" 2>/dev/null | grep -q "^PREFIX=$PREFIX\$"; then
            import_env "$wm"
        else
            eval "$(termux_env)"
        fi
        export DISPLAY=$DPY PULSE_SERVER=127.0.0.1 PULSE_COOKIE=$PULSE_COOKIE_FILE DESKTOP_STARTUP_ID=$sid
        if [ "$term" = true ]; then exec setsid sh -c "$TERM_WRAP" "$cmd"; fi
        exec setsid sh -c "$cmd"
    fi
    [ "$term" = true ] && cmd="exec sh -c $(sq "$TERM_WRAP") $(sq "$cmd")"
    local -a e=(DISPLAY=$DPY PULSE_SERVER=127.0.0.1 DESKTOP_STARTUP_ID=$sid)
    # The session's D-Bus and language, when its window manager runs
    if wm=$(session_wm_pid); then
        while IFS= read -r line; do e+=("$line"); done < <(tr '\0' '\n' <"/proc/$wm/environ" 2>/dev/null |
            grep -E '^(DBUS_SESSION_BUS_ADDRESS|LANG|LANGUAGE|LC_[A-Z]+|XDG_RUNTIME_DIR)=')
    fi
    if [ -f "$SESSIONS/$scope.launch" ]; then
        # Written by the user for systems xdesk cannot enter itself (chroot): runs "$@" in that system
        export PULSE_COOKIE=$PULSE_COOKIE_FILE "${e[@]}"
        exec setsid bash "$SESSIONS/$scope.launch" sh -c "$cmd"
    fi
    line=$(grep -m1 'proot-distro login' "$SESSIONS/$scope.sh")
    [ -n "$line" ] || { say "Session $scope: write $SESSIONS/$scope.launch to run programs in it"; exit 1; }
    line=${line#"${line%%[![:space:]]*}"}
    line=${line#exec }
    prefix=${line%% -- *}
    eval "set -- $prefix"
    exec setsid "$@" -- env "${e[@]}" PULSE_COOKIE=/tmp/xdesk-pulse-cookie sh -c "$cmd"
}

list_apps() {
    local cat
    cat=$(apps_catalog "${1:-0}") || exit 1
    awk -F'\t' 'NR > 1 { printf "%-40s %s%s\n", $1, $2, ($3 == 1 ? " (terminal)" : "") }' "$cat"
}

usage() { sed -n '4,20p' "$0" | sed 's/^# \?//'; }

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
x)
    need_tools
    lock; start_x && start_audio
    ;;
run)
    [ $# -gt 0 ] || { usage; exit 2; }
    need_tools
    lock; start_x && start_audio || exit 1
    wait_for_app
    exec 9>&-
    DISPLAY=$DPY PULSE_SERVER=127.0.0.1 PULSE_COOKIE=$PULSE_COOKIE_FILE exec "$@"
    ;;
start)
    name=${1:-$(current)}
    [ -n "$name" ] || { echo "No default session. Run: xdesk setup"; exit 1; }
    valid_name "$name" || exit 2
    need_tools
    clear_stopped
    lock; start_x && start_audio || exit 1
    wait_for_app
    start_session "$name"
    ;;
recover)
    [ -e "$RUN/stopped" ] && exit 0
    name=${1:-$(current)}
    [ -n "$name" ] || exit 1
    valid_name "$name" || exit 2
    need_tools
    lock; start_x && start_audio || exit 1
    wait_for_app
    start_session "$name"
    ;;
switch)
    [ $# -eq 1 ] || { usage; exit 2; }
    valid_name "$1" || exit 2
    need_tools
    session_file "$1" >/dev/null || { echo "No session named '$1'. Try: xdesk list"; exit 1; }
    clear_stopped
    lock; start_x && start_audio || exit 1
    stop_session
    start_session "$1" && echo "$1" >"$CONF/current"
    ;;
stop)
    touch "$RUN/stopped"
    lock; stop_session
    pkill -f '^xdesk-x11 '
    pulseaudio --kill 2>/dev/null
    am broadcast -a io.github.n2ray.xdesk.STOPPED -p "$APP" --es nonce "$(cat "$RUN/nonce" 2>/dev/null)" >/dev/null 2>&1
    say "Stopped"
    ;;
list) list ;;
add)
    [ $# -eq 2 ] || { usage; exit 2; }
    valid_name "$1" || exit 2
    case "$1" in *+apps) echo "Names ending in +apps are the apps only variant of a session"; exit 2 ;; esac
    printf '%s\n' "exec $2" >"$SESSIONS/$1.sh"
    [ -n "$(current)" ] || echo "$1" >"$CONF/current"
    list
    ;;
rm)
    [ $# -eq 1 ] || { usage; exit 2; }
    valid_name "$1" || exit 2
    rm -f "${SESSIONS:?}/${1:?}.sh"
    if [ "$(current)" = "$1" ]; then rm -f "${CONF:?}/current"; fi
    list
    ;;
use)
    [ $# -eq 1 ] || { usage; exit 2; }
    valid_name "$1" || exit 2
    session_file "$1" >/dev/null || { echo "No session named '$1'. Try: xdesk list"; exit 1; }
    echo "$1" >"$CONF/current"
    list
    ;;
status)
    if x_up; then echo "X server: running on $DPY"; else echo "X server: not running"; fi
    DISPLAY=$DPY timeout 2 xrandr 2>/dev/null | sed -n 's/.*\(current [0-9]* x [0-9]*\).*/Resolution: \1/p'
    if [ -n "$(session_pid)" ]; then echo "Session: $(cat "$RUN/session.name")"; else echo "Session: none"; fi
    echo "Default: $(current)"
    ;;
setup) setup ;;
apps)
    case "${1:-}" in
    --refresh) list_apps 1 ;;
    --path) apps_catalog 0 ;;
    '') list_apps 0 ;;
    *) usage; exit 2 ;;
    esac
    ;;
launch) launch_app "$@" ;;
enable-app-start)
    P=$HOME/.termux/termux.properties
    mkdir -p "$(dirname "$P")"; touch "$P"
    if ! grep -q '^allow-external-apps *= *true' "$P"; then
        sed -i 's/^# *allow-external-apps *=.*/allow-external-apps = true/' "$P"
        grep -q '^allow-external-apps *= *true' "$P" || echo 'allow-external-apps = true' >>"$P"
        termux-reload-settings 2>/dev/null || true
    fi
    echo "Apps with the Run commands permission can now start programs in Termux."
    ;;
*)
    usage
    [ -z "$cmd" ]
    ;;
esac
