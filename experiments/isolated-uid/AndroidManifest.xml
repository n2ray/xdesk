<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.n2ray.xdesk.isolationprobe" android:versionCode="1" android:versionName="1">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />
    <queries><package android:name="io.github.n2ray.xdesk.x11" /></queries>
    <application android:label="XDesk isolation probe" android:extractNativeLibs="true"
        android:allowBackup="false">
        <activity android:name="io.github.n2ray.xdesk.probe.ProbeActivity"
            android:exported="true" android:permission="android.permission.DUMP" />
        <service android:name="io.github.n2ray.xdesk.probe.ProbeService"
            android:exported="false" android:isolatedProcess="true" android:process=":isolated" />
    </application>
</manifest>
