    <string name="xd_perm_injector_name">注入服務</string>
    <string name="xd_perm_injector_use">安卓應用的鍵鼠 · 無線調試</string>
    <string name="xd_perm_injector_why">外接屏上的安卓應用靠它接收鍵鼠：無線調試配對，或者用 Shizuku。</string>
    <string name="xd_perm_injector_without">安卓應用開了也沒有鍵鼠；Linux 桌面和投屏不受影響。</string>
    <string name="xd_perm_injector_steps">點下面的「去激活」\n打開無線調試，輸入配對碼\n回來會自動連上；也可以用 Shizuku</string>

    <string name="xd_perm_overlay_use">外屏的光標、啓動台、主頁和隱私遮罩</string>
    <string name="xd_perm_overlay_why">外屏的啓動台和主頁\n離開 XDesk 時遮住外屏</string>
    <string name="xd_perm_overlay_without">外屏沒有光標，也沒有啓動台，要在手機上選應用；隱私遮罩也遮不住。</string>
    <string name="xd_perm_overlay_steps">點下面的「去開啓」\n打開「允許顯示在其他應用上層」\n返回 XDesk，會自動檢測</string>

    <string name="xd_perm_notifications_use">配對碼在通知里直接輸</string>
    <string name="xd_perm_notifications_why">配對碼直接顯示在 XDesk 的通知里，不用在兩個頁面之間來回切。</string>
    <string name="xd_perm_notifications_without">仍然可以在 XDesk 的頁面里輸入配對碼。</string>
    <string name="xd_perm_notifications_steps">點下面的「去開啓」\n允許 XDesk 發送通知\n之後配對碼會出現在通知里</string>

    <string name="xd_perm_notify_access_use">手機通知放到外屏</string>
    <string name="xd_perm_notify_access_without">外屏上沒有手機的通知；其他功能照常。通知內容不落盤、不外傳。</string>
    <string name="xd_perm_notify_access_steps">點下面的「去開啓」\n在列表裡找到 XDesk，打開開關\n返回 XDesk 即生效</string>

    <string name="xd_perm_termux_use">一鍵啓動 Linux 桌面</string>
    <string name="xd_perm_termux_without">仍然可以在 Termux 里自己運行 xdesk start。</string>
    <string name="xd_perm_termux_steps">點下面的「去開啓」\n系統會問一次是否允許\n允許後會自動繼續</string>

    <string name="xd_perm_camera_use">掃碼添加 Mac，也可以輸地址</string>
    <string name="xd_perm_camera_without">仍然可以返回，改用地址添加 Mac。</string>
    <string name="xd_perm_camera_steps">點下面的「去開啓」\n允許相機\n回來就能掃碼</string>

    <string name="xd_perm_dnd_use">外屏上的勿擾開關</string>
    <string name="xd_perm_dnd_without">外屏的勿擾開關點了只會告訴你去哪裡開。</string>
    <string name="xd_perm_dnd_steps">點下面的「去開啓」\n在列表裡找到 XDesk，打開開關\n返回 XDesk 即生效</string>

    <string name="xd_perm_autostart_use">被系統關了，通知進不來</string>
