    <string name="xd_perm_usb_debug_name">USB 調試</string>
    <string name="xd_perm_usb_debug_use">Mac 接收端走 USB</string>
    <string name="xd_perm_usb_debug_why">Mac 接收端才能通過 USB 線連到手機。</string>
    <string name="xd_perm_usb_debug_without">Mac 仍然可以走 Wi-Fi。</string>
    <string name="xd_perm_usb_debug_steps">點下面的「去開啓」\n打開「USB 調試」\n返回 XDesk</string>

    <string name="xd_perm_ncm_use">網頁顯示走有線</string>
