    <string name="xd_perm_run_sheet_default">Linux 桌面</string>
    <string name="xd_perm_run_sheet_title">打开「%1$s」</string>
    <string name="xd_perm_run_sheet_note">XDesk 要替你在 Termux 里启动它。系统会问一次。</string>
    <string name="xd_perm_run_sheet_allow">允许</string>
    <string name="xd_perm_run_sheet_or">或者自己运行</string>
    <string name="xd_perm_run_sheet_termux">在 Termux 里打开</string>

    <string name="xd_perm_injector_name">注入服务</string>
    <string name="xd_perm_injector_use">安卓应用的键鼠 · 无线调试</string>
    <string name="xd_perm_injector_why">外接屏上的安卓应用靠它接收键鼠：无线调试配对，或者用 Shizuku。</string>
    <string name="xd_perm_injector_without">安卓应用开了也没有键鼠；Linux 桌面和投屏不受影响。</string>
    <string name="xd_perm_injector_steps">点下面的「去激活」\n打开无线调试，输入配对码\n回来会自动连上；也可以用 Shizuku</string>

    <string name="xd_perm_overlay_use">外屏的光标、启动台、主页和隐私遮罩</string>
    <string name="xd_perm_overlay_why">外屏的启动台和主页\n离开 XDesk 时遮住外屏</string>
    <string name="xd_perm_overlay_without">外屏没有光标，也没有启动台，要在手机上选应用；隐私遮罩也遮不住。</string>
    <string name="xd_perm_overlay_steps">点下面的「去开启」\n打开「允许显示在其他应用上层」\n返回 XDesk，会自动检测</string>

    <string name="xd_perm_notifications_use">配对码在通知里直接输</string>
    <string name="xd_perm_notifications_why">配对码直接显示在 XDesk 的通知里，不用在两个页面之间来回切。</string>
    <string name="xd_perm_notifications_without">仍然可以在 XDesk 的页面里输入配对码。</string>
    <string name="xd_perm_notifications_steps">点下面的「去开启」\n允许 XDesk 发送通知\n之后配对码会出现在通知里</string>

    <string name="xd_perm_notify_access_use">手机通知放到外屏</string>
    <string name="xd_perm_notify_access_without">外屏上没有手机的通知；其他功能照常。通知内容不落盘、不外传。</string>
    <string name="xd_perm_notify_access_steps">点下面的「去开启」\n在列表里找到 XDesk，打开开关\n返回 XDesk 即生效</string>

    <string name="xd_perm_termux_use">一键启动 Linux 桌面</string>
    <string name="xd_perm_termux_without">仍然可以在 Termux 里自己运行 xdesk start。</string>
    <string name="xd_perm_termux_steps">点下面的「去开启」\n系统会问一次是否允许\n允许后会自动继续</string>

    <string name="xd_perm_camera_use">扫码添加 Mac，也可以输地址</string>
    <string name="xd_perm_camera_without">仍然可以返回，改用地址添加 Mac。</string>
    <string name="xd_perm_camera_steps">点下面的「去开启」\n允许相机\n回来就能扫码</string>

    <string name="xd_perm_dnd_use">外屏上的勿扰开关</string>
    <string name="xd_perm_dnd_without">外屏的勿扰开关点了只会告诉你去哪里开。</string>
    <string name="xd_perm_dnd_steps">点下面的「去开启」\n在列表里找到 XDesk，打开开关\n返回 XDesk 即生效</string>

    <string name="xd_perm_autostart_use">被系统关了，通知进不来</string>
    <string name="xd_perm_autostart_without">系统关掉它以后，通知可能进不来，直到重新打开 XDesk。</string>
    <string name="xd_perm_autostart_steps">点下面的「去打开」\n在列表里打开 XDesk 的自启动\n也可以在 设置 › 应用 › XDesk 里找到</string>

    <string name="xd_perm_usb_debug_name">USB 调试</string>
    <string name="xd_perm_usb_debug_use">Mac 接收端走 USB</string>
    <string name="xd_perm_usb_debug_why">Mac 接收端才能通过 USB 线连到手机。</string>
    <string name="xd_perm_usb_debug_without">Mac 仍然可以走 Wi-Fi。</string>
    <string name="xd_perm_usb_debug_steps">点下面的「去开启」\n打开「USB 调试」\n返回 XDesk</string>

    <string name="xd_perm_ncm_use">网页显示走有线</string>
    <string name="xd_perm_ncm_why">USB 线连电脑时，iPad 和 Mac 只认 NCM，安卓默认用 RNDIS。</string>
    <string name="xd_perm_ncm_without">USB 网络共享仍然能用，但 iPad 或 Mac 可能连不上。</string>
    <string name="xd_perm_ncm_steps">点下面的「复制命令」\n在电脑上用 adb 运行这条命令\n把 USB 线拔插一次</string>
</resources>
