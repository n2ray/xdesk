    <string name="xd_bl_reset">Reset the system, keep my files</string>
    <string name="xd_bl_reset_note">The system goes back to how it was installed; /root stays. No download</string>
    <string name="xd_bl_reset_confirm_title">Reset the system?</string>
    <string name="xd_bl_reset_confirm">Programs you installed and system settings are removed. The files in /root (your home) stay.</string>
    <string name="xd_bl_reset_action">Reset</string>
