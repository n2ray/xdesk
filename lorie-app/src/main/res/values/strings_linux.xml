    <string name="xd_bl_install">Install Ubuntu 26.04 with XFCE</string>
    <string name="xd_bl_install_note">Downloads about 600 MB once and needs about 2.5 GB. Stays in XDesk: uninstalling XDesk or clearing its data removes it</string>
    <string name="xd_bl_install_local_note">The image is already on the phone: no download</string>
    <string name="xd_bl_start">Start the desktop</string>
    <string name="xd_bl_start_note">Starts XFCE and opens it on the external screen</string>
    <string name="xd_bl_open">Show on the external screen</string>
    <string name="xd_bl_open_note">The desktop is running</string>
    <string name="xd_bl_stop_note">Ends the desktop and every program in it</string>
    <string name="xd_bl_about">What this is</string>
    <string name="xd_bl_about_what">A Linux of its own</string>
    <string name="xd_bl_about_what_note">Ubuntu 26.04 LTS with the XFCE desktop, Chrome, Firefox and a terminal, run by XDesk itself. Install anything with apt; break it and reset it in a minute.</string>
    <string name="xd_bl_about_termux">Termux stays as it is</string>
    <string name="xd_bl_about_termux_note">The Termux desktops are separate and keep working. Run one desktop at a time.</string>
    <string name="xd_bl_graphics">Graphics</string>
    <string name="xd_bl_gpu">GPU acceleration (Snapdragon)</string>
    <string name="xd_bl_gpu_note">OpenGL through Zink on Turnip. Off: software rendering</string>
    <string name="xd_bl_gpu_restart">Takes effect the next time the desktop starts</string>
