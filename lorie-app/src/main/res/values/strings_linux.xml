    <string name="xd_bl_title">Built-in Linux</string>
    <string name="xd_bl_type_note">Ubuntu with XFCE inside XDesk, no Termux (experimental)</string>
    <string name="xd_bl_row_note">Ubuntu 26.04 · XFCE</string>
