#!/bin/sh
# XDesk's built-in Linux: the whole desktop over the "apps only" session (the app writes this file into the system
# when it is needed). Only xfwm4 and xfsettingsd run there; the panel and the desktop come in beside them, on the same
# D-Bus session, so the programs already open stay.
[ -r /tmp/xdesk-env ] && . /tmp/xdesk-env
p=$(pgrep -o -x xfwm4 2>/dev/null)
if [ -n "$p" ]; then
    a=$(tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -1)
    [ -n "$a" ] && export DBUS_SESSION_BUS_ADDRESS="$a"
fi
pgrep -x xfdesktop >/dev/null 2>&1 || setsid xfdesktop </dev/null >>/tmp/xdesk-desktop.log 2>&1 &
pgrep -x xfce4-panel >/dev/null 2>&1 || setsid xfce4-panel </dev/null >>/tmp/xdesk-desktop.log 2>&1 &
wait
