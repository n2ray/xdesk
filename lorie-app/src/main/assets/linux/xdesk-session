#!/bin/sh
# XDesk's built-in Linux: the desktop session (the app writes this file into the system at every start). The app starts it in the container with DISPLAY, LANG and
# XDESK_GPU set, after its own X server is up. Sound goes the way the Termux desktop's does: a null sink whose
# monitor XDesk reads from /tmp/xdesk-audio (through its X server).
# The system's own language when the user has set one (sudo update-locale LANG=...), else the app's English
if [ -r /etc/default/locale ]; then
    . /etc/default/locale
    export LANG LANGUAGE LC_ALL LC_MESSAGES 2>/dev/null
fi
# The desktop runs as the user xdesk (with sudo), not root (owner, 23 November): xdesk-core makes the user and
# owns the system side (linux/packages/xdesk-core), xdesk-update keeps it current. A system without the user yet
# (xdesk-core not installed, no network for xdesk-update) stays as root, as before, in the home XDesk keeps.
getent passwd xdesk >/dev/null 2>&1 || export HOME=/home/xdesk
export XDG_RUNTIME_DIR=/tmp/runtime-xdesk
export XDG_CONFIG_DIRS=/etc/xdg XDG_DATA_DIRS=/usr/local/share:/usr/share
export NO_AT_BRIDGE=1
# D-Bus needs a machine id; the image has none of its own
# The system files below are written once, as root; the --user pass has their environment already (exec keeps it)
if [ "$1" != --user ]; then
[ -s /etc/machine-id ] || dbus-uuidgen > /etc/machine-id 2>/dev/null
mkdir -p /var/lib/dbus && [ -s /var/lib/dbus/machine-id ] || cp /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null
fi

if [ "${XDESK_GPU:-0}" = 1 ] && [ -e /dev/kgsl-3d0 ]; then
    # Adreno: OpenGL through Zink on Turnip (faster than freedreno on X11 in our tests)
    export MESA_LOADER_DRIVER_OVERRIDE=zink ZINK_DESCRIPTORS=lazy vblank_mode=0
else
    export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe
fi
# Firefox's sandboxes need namespaces the container does not have
export MOZ_DISABLE_CONTENT_SANDBOX=1 MOZ_DISABLE_GMP_SANDBOX=1 MOZ_DISABLE_RDD_SANDBOX=1 MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1

# Chromium (apt install chromium), read by Debian's launcher: no sandbox (no namespaces either). On the GPU, ANGLE
# on GL (Zink): with Vulkan compositing WebGL and the compositor share no memory and every frame stalls on
# ReadPixels; sysmem keeps Turnip's tiles from flickering when SurfaceFlinger composes the screen on the GPU.
if [ "$1" != --user ]; then
# The app starts the video service (termux-va) just before this: its socket may come a moment later, and without it
# Chrome gets the software-decoding flags until the next start (0.8.0-beta.1, a fresh system: 23 November)
if [ "${XDESK_GPU:-0}" = 1 ] && [ -e /dev/kgsl-3d0 ]; then
    i=0
    while [ $i -lt 30 ] && [ ! -S /tmp/termux-va/termux-va.sock ]; do sleep 0.1; i=$((i+1)); done
fi
mkdir -p /etc/chromium.d
if [ "${XDESK_GPU:-0}" = 1 ] && [ -e /dev/kgsl-3d0 ]; then
    cat >/etc/chromium.d/xdesk <<'EOF'
export TU_DEBUG="${TU_DEBUG:-sysmem}"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --disable-gpu-sandbox --ignore-gpu-blocklist --use-angle=gl --disable-features=Vulkan"
EOF
else
    echo 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox"' >/etc/chromium.d/xdesk
fi
# Hardware video decoding: Mesa's termuxva VA-API driver, which hands the stream to the app's MediaCodec service
# (termux-va, started by the app; it listens on /tmp/termux-va/termux-va.sock, where the driver looks by default).
[ -S /tmp/termux-va/termux-va.sock ] && export LIBVA_DRIVER_NAME=termuxva

# Google Chrome (apt install google-chrome-stable), read by the image's wrapper /usr/bin/google-chrome-stable.
# On the GPU, termux-va's recipe for Termux:X11 (docs/termux-va.rst in lfdevs' Mesa): GL on Freedreno over KGSL,
# ANGLE on EGL (it can import dma-bufs; GLX shows imported buffers black), and its preload, which answers Chrome's
# DRI3 Open (that XDesk's X refuses) with a KGSL descriptor so Chrome can allocate buffers for decoded video.
mkdir -p /etc/xdesk
if [ "${XDESK_GPU:-0}" = 1 ] && [ -e /dev/kgsl-3d0 ] && [ -S /tmp/termux-va/termux-va.sock ]; then
    cat >/etc/xdesk/chrome.sh <<'EOF'
export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libtva_drm_shim_wayland.so
export LIBVA_DRIVER_NAME=termuxva TERMUX_VA_BRIDGE=1 TERMUX_VA_GPU_BACKEND=kgsl TERMUX_VA_X11_DRI3=1
export MESA_LOADER_DRIVER_OVERRIDE=kgsl TURNIP_KMD=kgsl
# The experimental VA driver is built separately for Ubuntu 26.04.
# Older images use the stock profile mask to keep Chrome responsive.
if [ -r /usr/local/lib/xdesk-hwvideo/termuxva_drv_video.so ]; then
    export LIBVA_DRIVERS_PATH=/usr/local/lib/xdesk-hwvideo XDESK_VPP_WAIT=1
    unset TERMUX_VA_DISABLE_AVC TERMUX_VA_DISABLE_AV1
    if [ -r /usr/local/lib/xdesk-hwvideo/revision ]; then
        unset TERMUX_VA_DISABLE_HEVC XDESK_AV1_LIMIT_1080
        export XDESK_VA_BATCH_WRITE=1
    else
        # Earlier experimental drivers used a shorter PRIME producer timeout.
        export TERMUX_VA_DISABLE_HEVC=1 XDESK_AV1_LIMIT_1080=1
    fi
    export XDESK_AV1_PACKET=1 DMD_AV1_OUTPUT_HIDDEN=0 DMD_AV1_INLINE_SHOW=1
else
    export TERMUX_VA_DISABLE_AVC=1 TERMUX_VA_DISABLE_AV1=1 TERMUX_VA_DISABLE_HEVC=1
fi
CHROME_FLAGS="--no-sandbox --ozone-platform=x11 --use-gl=angle --use-angle=gles-egl --ignore-gpu-blocklist
 --disable-gpu-rasterization --enable-gpu-compositing --enable-zero-copy --enable-native-gpu-memory-buffers
 --enable-features=AcceleratedVideoDecoder,AcceleratedVideoDecodeLinuxGL,PlatformHEVCDecoderSupport
 --disable-features=AcceleratedVideoDecodeLinuxZeroCopyGL,VaapiVideoMinResolutionForPerformance
 --hardware-video-device-path=/dev/kgsl-3d0"
EOF
else
    sed 's/CHROMIUM_FLAGS/CHROME_FLAGS/g' /etc/chromium.d/xdesk >/etc/xdesk/chrome.sh
fi
fi

# From here on as xdesk: the sound server, the launcher's server, the desktop. The environment so far goes with it
if [ "$1" != --user ] && getent passwd xdesk >/dev/null 2>&1; then
    mkdir -p "$XDG_RUNTIME_DIR" && chown xdesk:xdesk "$XDG_RUNTIME_DIR" 2>/dev/null; chmod 700 "$XDG_RUNTIME_DIR"
    exec /usr/local/bin/xdesk-asuser xdesk /bin/sh "$0" --user
fi
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
cd "$HOME" 2>/dev/null

# Its socket at a fixed place, for every client through PULSE_SERVER: one place for the desktop's programs and for those
# run as root (sudo), whose runtime directories differ
export PULSE_SERVER=unix:/tmp/xdesk-pulse
if command -v pulseaudio >/dev/null 2>&1; then
    # One still going away makes the new one fail ("Daemon startup failed", no sound at all); --kill and --check go
    # through that runtime directory too, so by name
    if [ "${XDESX_SHARED_X:-0}" != 1 ]; then
        pkill -x pulseaudio 2>/dev/null
        i=0
        while [ $i -lt 30 ] && pgrep -x pulseaudio >/dev/null 2>&1; do sleep 0.1; i=$((i+1)); done
    fi
    rm -f /tmp/xdesk-audio /tmp/xdesk-pulse
    for try in 1 2 3; do
        pulseaudio --daemonize=yes --exit-idle-time=-1 -n \
            -L "module-native-protocol-unix socket=/tmp/xdesk-pulse auth-anonymous=1" \
            -L "module-null-sink sink_name=xdesk rate=48000 channels=2" \
            -L "module-simple-protocol-unix socket=/tmp/xdesk-audio source=xdesk.monitor record=true playback=false format=s16le rate=48000 channels=2" \
            -L module-always-sink >/tmp/pulseaudio.log 2>&1 && break
        sleep 1
    done
    pactl set-default-sink xdesk >/dev/null 2>&1
fi

# xdesx already owns X, the WM, panel, DPI and cursor. The guest owns its application bus.
# EOF on the controller pipe (including Android process death) ends the Burrow process tree.
if [ "${XDESX_SHARED_X:-0}" = 1 ]; then
    exec dbus-run-session -- sh -c '
        /bin/sh /usr/local/bin/xdesk-launch --serve &
        server=$!
        trap "kill $server 2>/dev/null || :" EXIT
        read -r stop || :
    '
fi

# xfwm4 without GLX vblank (xdesk-core says why): xfwm4 writes all its settings into the user's xfconf file on its
# first start, so "auto" there is the old default, not a choice: it goes too (another value the user picked stays)
sed -i 's|<property name="vblank_mode" type="string" value="auto"/>|<property name="vblank_mode" type="string" value="off"/>|' \
    "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml" 2>/dev/null

# What XDesk's launcher gives the programs it opens (xdesk-launch): the same environment as the desktop's
# (before the wait for the screen below: a program may be asked for as soon as X is there)
export -p >/tmp/xdesk-env 2>/dev/null
# Opens the programs XDesk's launcher asks for, as part of this session (xdesk-launch says why)
sh /usr/local/bin/xdesk-launch --serve </dev/null >/dev/null 2>&1 &

# The screen's size and DPI come once the app shows the desktop (X starts at 1280x1024, 96 DPI): wait for it, or the
# wallpaper keeps the wrong size and everything is drawn at 96 DPI, tiny on a phone or a monitor
i=0
while [ $i -lt 16 ] && xdpyinfo 2>/dev/null | grep -q 'dimensions: *1280x1024 '; do sleep 0.5; i=$((i+1)); done
dpi=$(xdpyinfo 2>/dev/null | sed -n 's/.*resolution: *\([0-9]*\)x.*/\1/p' | head -1)
# XFCE's own default is 96 (in /etc/xdg); a DPI the user sets in XFCE's settings still wins
case "$dpi" in
    [0-9][0-9]|[0-9][0-9][0-9])
        sed -i "s|<property name=\"DPI\" type=\"int\" value=\"[0-9]*\"/>|<property name=\"DPI\" type=\"int\" value=\"$dpi\"/>|" \
            /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml 2>/dev/null
        printf 'Xft.dpi: %s\n' "$dpi" | xrdb -merge 2>/dev/null ;;
esac
# "Apps only" (a program was opened from XDesk's launcher with the system not running): the window manager and the
# settings daemon, no panel or desktop. Opening the whole desktop later adds those (xdesk-desktop)
if [ "${XDESK_APPS_ONLY:-0}" = 1 ]; then
    exec dbus-launch --exit-with-session sh -c 'xfsettingsd --daemon >/dev/null 2>&1; exec xfwm4'
fi
exec dbus-launch --exit-with-session startxfce4
