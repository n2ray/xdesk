<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 自己打开无线调试之前，看有没有 Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 外接屏上的光标（只有运行安卓应用时用） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <queries>
        <package android:name="com.termux" />
        <package android:name="moe.shizuku.privileged.api" />
        <!-- 选择界面列出可启动的安卓应用 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:icon="@mipmap/lorie_ic_launcher"
        android:label="@string/lorie_app_name"
        android:roundIcon="@mipmap/lorie_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/LorieAppTheme"
        android:hardwareAccelerated="true">
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="false" />
        <activity
            android:name="com.termux.x11.XDeskActivity"
            android:label="XDesk"
            android:icon="@mipmap/xdesk_icon"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:launchMode="singleTask"
            android:taskAffinity=".XDesk"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize|screenLayout|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- stopWithTask 必须是 false，否则划掉任务时收不到 onTaskRemoved -->
        <service android:name="com.termux.x11.DesktopService" android:exported="false" android:foregroundServiceType="mediaPlayback" android:stopWithTask="false" />
        <!-- 外接屏最底层的仪表盘。自己一个任务，不进最近任务 -->
        <activity
            android:name="com.termux.x11.DashboardActivity"
            android:label="XDesk"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:launchMode="singleTask"
            android:taskAffinity=".XDeskDashboard"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize|screenLayout|density|fontScale|locale|layoutDirection"
            android:exported="false" />
        <!-- 用户在系统设置里配对时找端口、收配对码。启动 shell 服务不靠它 -->
        <service android:name="com.termux.x11.PairingService" android:exported="false" android:foregroundServiceType="shortService" />
        <receiver android:name="com.termux.x11.TermuxResultReceiver" android:exported="false" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- 图标和任务列表都只留 XDesk：桌面窗口由 XDeskActivity 打开 -->
        <activity android:name="com.termux.x11.MainActivity" android:excludeFromRecents="true" tools:node="merge">
            <intent-filter tools:node="removeAll" />
        </activity>
    </application>
</manifest>
