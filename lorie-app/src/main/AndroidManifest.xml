<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <queries>
        <package android:name="com.termux" />
    </queries>
    <application
        android:icon="@mipmap/lorie_ic_launcher"
        android:label="@string/lorie_app_name"
        android:roundIcon="@mipmap/lorie_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/LorieAppTheme"
        android:hardwareAccelerated="true">
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="false" />
        <activity
            android:name="com.termux.x11.XDeskActivity"
            android:label="XDesk"
            android:icon="@mipmap/xdesk_icon"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:launchMode="singleTask"
            android:taskAffinity=".XDesk"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize|screenLayout|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="com.termux.x11.DesktopService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <!-- 图标和任务列表都只留 XDesk：桌面窗口由 XDeskActivity 打开 -->
        <activity android:name="com.termux.x11.MainActivity" android:excludeFromRecents="true" tools:node="merge">
            <intent-filter tools:node="removeAll" />
        </activity>
    </application>
</manifest>
