<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries>
        <package android:name="com.termux" />
    </queries>
    <application
        android:icon="@mipmap/lorie_ic_launcher"
        android:label="@string/lorie_app_name"
        android:roundIcon="@mipmap/lorie_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/LorieAppTheme"
        android:hardwareAccelerated="true">
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="false" />
        <activity
            android:name="com.termux.x11.XDeskActivity"
            android:label="XDesk 触摸板"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:launchMode="singleTask"
            android:taskAffinity=".XDesk"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize|screenLayout|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
